<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartPos.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:SmartPos.Mobile.Views.Auth"
    xmlns:admin="clr-namespace:SmartPos.Mobile.Views.Admin"
    xmlns:customer="clr-namespace:SmartPos.Mobile.Views.Customer"
    xmlns:rider="clr-namespace:SmartPos.Mobile.Views.Rider"
    xmlns:waiter="clr-namespace:SmartPos.Mobile.Views.Waiter"
    Title="Aljannat"
    FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.BackgroundColor="{StaticResource CardBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.TabBarBackgroundColor="Transparent"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}">

    <!-- Splash Screen: First item so Shell boots initially onto SplashScreenPage on cold start -->
    <ShellContent Route="splash"
                  Title="Splash"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate customer:SplashScreenPage}" />

    <!-- Customer: 4-tab bottom navigation (Home, Order, Favorite, Profile) -->
    <TabBar Route="customer">
        <ShellContent Route="home"
                      Title="Home"
                      Icon="tab_home_idle.png"
                      ContentTemplate="{DataTemplate customer:CustomerHomePage}" />
        <ShellContent Route="order"
                      Title="Order"
                      Icon="tab_order_idle.png"
                      ContentTemplate="{DataTemplate customer:OrderPage}" />
        <ShellContent Route="favorites"
                      Title="Favorite"
                      Icon="tab_favorites_idle.png"
                      ContentTemplate="{DataTemplate customer:FavoritesPage}" />
        <ShellContent Route="account"
                      Title="Profile"
                      Icon="tab_account_idle.png"
                      ContentTemplate="{DataTemplate auth:LoginPage}" />
    </TabBar>

    <!-- Standalone Cart Page -->
    <ShellContent Route="cart"
                  Title="Cart"
                  ContentTemplate="{DataTemplate customer:CartPage}" />

    <!-- Rider: same bubble nav pattern (+ Profile for login/logout) -->
    <TabBar Route="rider">
        <ShellContent Route="dashboard"
                      Title="Home"
                      Icon="tab_home_idle.png"
                      ContentTemplate="{DataTemplate rider:RiderDashboardPage}" />
        <ShellContent Route="history"
                      Title="History"
                      Icon="tab_history_idle.png"
                      ContentTemplate="{DataTemplate rider:RiderHistoryPage}" />
        <ShellContent Route="account"
                      Title="Profile"
                      Icon="tab_account_idle.png"
                      ContentTemplate="{DataTemplate auth:LoginPage}" />
    </TabBar>

    <!-- Admin: dashboard + profile -->
    <TabBar Route="admin">
        <ShellContent Route="home"
                      Title="Dashboard"
                      Icon="tab_home_idle.png"
                      ContentTemplate="{DataTemplate admin:AdminDashboardPage}" />
        <ShellContent Route="account"
                      Title="Profile"
                      Icon="tab_account_idle.png"
                      ContentTemplate="{DataTemplate auth:LoginPage}" />
    </TabBar>

    <!-- Waiter: same bubble nav pattern (+ Profile for login/logout) -->
    <TabBar Route="waiter">
        <ShellContent Route="tables"
                      Title="Tables"
                      Icon="tab_tables_idle.png"
                      ContentTemplate="{DataTemplate waiter:WaiterTablesPage}" />
        <ShellContent Route="order"
                      Title="Order"
                      Icon="tab_order_idle.png"
                      ContentTemplate="{DataTemplate waiter:WaiterOrderPage}" />
        <ShellContent Route="myorders"
                      Title="Orders"
                      Icon="tab_myorders_idle.png"
                      ContentTemplate="{DataTemplate waiter:WaiterMyOrdersPage}" />
        <ShellContent Route="account"
                      Title="Profile"
                      Icon="tab_account_idle.png"
                      ContentTemplate="{DataTemplate auth:LoginPage}" />
    </TabBar>

    <ShellContent Route="track"
                  Title="Track"
                  ContentTemplate="{DataTemplate customer:TrackOrderPage}" />

    <ShellContent Route="history"
                  Title="History"
                  ContentTemplate="{DataTemplate customer:OrderHistoryPage}" />

    <ShellContent Route="unsupported"
                  Title="Unsupported"
                  ContentTemplate="{DataTemplate auth:UnsupportedStaffPage}" />

</Shell>
