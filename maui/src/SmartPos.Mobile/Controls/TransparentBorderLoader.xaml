<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartPos.Mobile.Controls.TransparentBorderLoader"
             IsVisible="False"
             InputTransparent="False"
             ZIndex="100">
    <!-- Semi-transparent overlay like web global-loader-overlay -->
    <Grid BackgroundColor="#73FFFFFF">
        <Border WidthRequest="56"
                HeightRequest="56"
                StrokeThickness="0"
                BackgroundColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#22000000" Offset="0,4" Radius="12" Opacity="0.16" />
            </Border.Shadow>
            <Grid WidthRequest="40" HeightRequest="40">
                <!-- Soft transparent ring track -->
                <Ellipse Stroke="#332563EB"
                         StrokeThickness="3.5"
                         Fill="Transparent" />
                <!-- Accent arc (transparent border style) -->
                <Ellipse x:Name="SpinRing"
                         Stroke="#2563EB"
                         StrokeThickness="3.5"
                         StrokeDashArray="28,100"
                         StrokeLineCap="Round"
                         Fill="Transparent" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
