<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartPos.Mobile.Controls.BubbleTabBar"
             BackgroundColor="Transparent"
             VerticalOptions="End"
             HorizontalOptions="Fill"
             Margin="0"
             Padding="0">
    <!--
      Overlay-only control. Parents must place this in AbsoluteLayout / same Grid cell
      WITHOUT bottom padding on page content. This view must not reserve layout space
      via a parent Auto row or page Padding.
    -->
    <Grid Padding="18,0,18,6" BackgroundColor="Transparent" HeightRequest="52">
        <Grid HeightRequest="46" VerticalOptions="End">
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    VerticalOptions="End"
                    HeightRequest="42"
                    InputTransparent="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="21" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" Opacity="0.16" />
                </Border.Shadow>
            </Border>

            <Ellipse x:Name="ActiveBubble"
                     WidthRequest="42"
                     HeightRequest="42"
                     Fill="White"
                     VerticalOptions="Start"
                     HorizontalOptions="Start"
                     InputTransparent="True">
                <Ellipse.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="6" Opacity="0.14" />
                </Ellipse.Shadow>
            </Ellipse>

            <Grid ColumnDefinitions="*,*,*,*" VerticalOptions="End" HeightRequest="42" Padding="2,0">
                <VerticalStackLayout x:Name="Tab0" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab0Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon0" WidthRequest="17" HeightRequest="17" HorizontalOptions="Center" />
                    <Label x:Name="Label0" Text="Home" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Tab1" Grid.Column="1" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab1Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon1" WidthRequest="17" HeightRequest="17" HorizontalOptions="Center" />
                    <Label x:Name="Label1" Text="Cart" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Tab2" Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab2Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon2" WidthRequest="17" HeightRequest="17" HorizontalOptions="Center" />
                    <Label x:Name="Label2" Text="Track" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Tab3" Grid.Column="3" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab3Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon3" WidthRequest="17" HeightRequest="17" HorizontalOptions="Center" />
                    <Label x:Name="Label3" Text="Profile" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
