<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartPos.Mobile.Controls.BubbleTabBar"
             BackgroundColor="Transparent"
             VerticalOptions="End"
             HorizontalOptions="Fill"
             Margin="0"
             Padding="0"
             InputTransparent="False"
             HeightRequest="68">

    <Grid x:Name="BarHost"
          BackgroundColor="White"
          InputTransparent="False"
          VerticalOptions="End"
          HeightRequest="68">

        <!-- Top border divider stroke #F3F4F6 with subtle elevation shadow -->
        <Border Stroke="#F3F4F6"
                StrokeThickness="1"
                BackgroundColor="White"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                InputTransparent="True">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#1A000000" Offset="0,-3" Radius="8" Opacity="0.06" />
            </Border.Shadow>
        </Border>

        <!-- Tabs Grid -->
        <Grid x:Name="TabsGrid"
              ColumnDefinitions="*,*,*,*"
              VerticalOptions="Fill"
              HorizontalOptions="Fill"
              HeightRequest="68"
              InputTransparent="False">

            <!-- Tab 0: Home -->
            <Grid Grid.Column="0">
                <Button x:Name="Tab0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        Margin="0"
                        Clicked="OnTab0Clicked" />
                <VerticalStackLayout x:Name="Tab0Visual"
                                     InputTransparent="True"
                                     Spacing="2"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image x:Name="Icon0" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                    <Label x:Name="Label0" Text="Home" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Tab 1: Order -->
            <Grid Grid.Column="1">
                <Button x:Name="Tab1"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        Margin="0"
                        Clicked="OnTab1Clicked" />
                <VerticalStackLayout x:Name="Tab1Visual"
                                     InputTransparent="True"
                                     Spacing="2"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Grid HorizontalOptions="Center" WidthRequest="32" HeightRequest="24">
                        <Image x:Name="Icon1" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        <!-- Red Badge with Item Count -->
                        <Border x:Name="CartBadge"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                TranslationX="6"
                                TranslationY="-3"
                                BackgroundColor="#EF4444"
                                StrokeThickness="1"
                                Stroke="White"
                                MinimumWidthRequest="16"
                                HeightRequest="16"
                                Padding="3,0"
                                IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label x:Name="CartBadgeLabel"
                                   Text="0"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Label x:Name="Label1" Text="Order" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Tab 2: Favorite -->
            <Grid Grid.Column="2">
                <Button x:Name="Tab2"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        Margin="0"
                        Clicked="OnTab2Clicked" />
                <VerticalStackLayout x:Name="Tab2Visual"
                                     InputTransparent="True"
                                     Spacing="2"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image x:Name="Icon2" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                    <Label x:Name="Label2" Text="Favorite" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Tab 3: Profile -->
            <Grid Grid.Column="3">
                <Button x:Name="Tab3"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        Margin="0"
                        Clicked="OnTab3Clicked" />
                <VerticalStackLayout x:Name="Tab3Visual"
                                     InputTransparent="True"
                                     Spacing="2"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image x:Name="Icon3" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                    <Label x:Name="Label3" Text="Profile" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

        </Grid>
    </Grid>
</ContentView>
