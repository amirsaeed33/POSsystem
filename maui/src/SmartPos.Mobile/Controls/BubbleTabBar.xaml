<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartPos.Mobile.Controls.BubbleTabBar"
             BackgroundColor="Transparent"
             VerticalOptions="End"
             HorizontalOptions="Fill"
             Margin="12,0,12,12"
             Padding="0"
             InputTransparent="True"
             HeightRequest="56">
    <!--
      Overlay control: parent Grid places this with VerticalOptions=End.
      Do NOT use AbsoluteLayout Y=1 + TranslationY (that drifts mid-screen on Windows/desktop).
    -->
    <Grid x:Name="BarHost"
          Padding="4,0"
          BackgroundColor="Transparent"
          HeightRequest="56"
          Margin="0"
          VerticalOptions="End"
          InputTransparent="False">
        <Grid x:Name="PillHost"
              HeightRequest="48"
              VerticalOptions="End"
              Margin="0"
              InputTransparent="False">
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    InputTransparent="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="8" Opacity="0.16" />
                </Border.Shadow>
            </Border>

            <Ellipse x:Name="ActiveBubble"
                     WidthRequest="44"
                     HeightRequest="44"
                     Fill="White"
                     VerticalOptions="Start"
                     HorizontalOptions="Start"
                     TranslationY="-8"
                     InputTransparent="True">
                <Ellipse.Shadow>
                    <Shadow Brush="#40000000" Offset="0,2" Radius="6" Opacity="0.14" />
                </Ellipse.Shadow>
            </Ellipse>

            <Grid x:Name="TabsGrid"
                  ColumnDefinitions="*,*,*,*"
                  VerticalOptions="Fill"
                  HeightRequest="48"
                  Padding="0"
                  InputTransparent="False">
                <VerticalStackLayout x:Name="Tab0" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab0Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon0" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" />
                    <Label x:Name="Label0" Text="Home" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Tab1" Grid.Column="1" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab1Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon1" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" />
                    <Label x:Name="Label1" Text="Cart" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Tab2" Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab2Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon2" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" />
                    <Label x:Name="Label2" Text="Track" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Tab3" Grid.Column="3" Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTab3Tapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image x:Name="Icon3" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" />
                    <Label x:Name="Label3" Text="Profile" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentView>
