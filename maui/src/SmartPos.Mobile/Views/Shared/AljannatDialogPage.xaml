<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Shared.AljannatDialogPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="Transparent"
             Title="">

    <Grid BackgroundColor="#801E1916"
          Padding="24">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped" />
        </Grid.GestureRecognizers>

        <controls:AljannatDialogOverlay x:Name="Dialog"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Opacity="0"
                                        Scale="0.92">
            <controls:AljannatDialogOverlay.GestureRecognizers>
                <TapGestureRecognizer />
            </controls:AljannatDialogOverlay.GestureRecognizers>
        </controls:AljannatDialogOverlay>
    </Grid>
</ContentPage>
