<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Rider.RiderHistoryPage"
             x:DataType="vm:RiderHistoryViewModel"
             Title="History"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <AbsoluteLayout BackgroundColor="#F5F5F5">
        <VerticalStackLayout AbsoluteLayout.LayoutBounds="0,0,1,1"
                             AbsoluteLayout.LayoutFlags="All"
                             Padding="16"
                             Spacing="10"
                             BackgroundColor="#F5F5F5">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Placeholder="Search" Text="{Binding Keyword}" />
                <Button Grid.Column="1" Text="Go" Command="{Binding LoadCommand}" BackgroundColor="#0F6B4C" TextColor="White" />
            </Grid>
            <CollectionView ItemsSource="{Binding Orders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RiderOrderDto">
                        <Border Stroke="#E8ECEA" StrokeThickness="1" Padding="12" Margin="0,0,0,8" BackgroundColor="#FAFBFA">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Text="{Binding OrderNo}" FontAttributes="Bold" TextColor="#1F2A24" />
                                <Label Text="{Binding CustomerName}" TextColor="#1F2A24" />
                                <Label Text="{Binding StatusText}" TextColor="#5C6B63" />
                                <Label Text="{Binding TotalText, StringFormat='Total {0}'}" TextColor="#0F6B4C" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <controls:BubbleTabBar AbsoluteLayout.LayoutBounds="0,1,1,52"
                               AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"
                               TranslationY="-52"
                               Mode="Rider"
                               SelectedIndex="1"
                               ZIndex="40"
                               InputTransparent="False" />
    </AbsoluteLayout>
</ContentPage>
