<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Rider.RiderHistoryPage"
             x:DataType="vm:RiderHistoryViewModel"
             Title="History"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceMuted}">
    <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource SurfaceMuted}">
        <VerticalStackLayout Grid.Row="0"
                             Padding="16,16,16,8"
                             Spacing="10"
                             BackgroundColor="{StaticResource SurfaceMuted}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Placeholder="Search" Text="{Binding Keyword}" />
                <controls:AppButton Grid.Column="1"
                                    Text="Go"
                                    Command="{Binding LoadCommand}"
                                    Variant="StaffPrimary"
                                    ButtonHeight="44"
                                    WidthRequest="72" />
            </Grid>
            <CollectionView ItemsSource="{Binding Orders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RiderOrderDto">
                        <Border Stroke="{StaticResource StaffBorderCool}" StrokeThickness="1" Padding="12" Margin="0,0,0,8" BackgroundColor="{StaticResource CartSurface}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Text="{Binding OrderNo}" FontAttributes="Bold" TextColor="{StaticResource CartText}" />
                                <Label Text="{Binding CustomerName}" TextColor="{StaticResource CartText}" />
                                <Label Text="{Binding StatusText}" TextColor="{StaticResource CartMuted}" />
                                <Label Text="{Binding TotalText, StringFormat='Total {0}'}" TextColor="{StaticResource StaffPrimary}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <controls:TabLoadingOverlay Grid.Row="0" />

        <controls:BubbleTabBar Grid.Row="1"
                               Mode="Rider"
                               SelectedIndex="1"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
