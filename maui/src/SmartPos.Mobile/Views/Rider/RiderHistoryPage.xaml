<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             x:Class="SmartPos.Mobile.Views.Rider.RiderHistoryPage"
             x:DataType="vm:RiderHistoryViewModel"
             Title="History"
             BackgroundColor="#F7F4EF">
    <VerticalStackLayout Padding="16" Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="Search" Text="{Binding Keyword}" />
            <Button Grid.Column="1" Text="Go" Command="{Binding LoadCommand}" BackgroundColor="#0F6B4C" TextColor="White" />
        </Grid>
        <CollectionView ItemsSource="{Binding Orders}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RiderOrderDto">
                    <Border Stroke="#E0E0E0" Padding="12" Margin="0,0,0,8" BackgroundColor="White">
                        <VerticalStackLayout>
                            <Label Text="{Binding OrderNo}" FontAttributes="Bold" />
                            <Label Text="{Binding CustomerName}" />
                            <Label Text="{Binding StatusText}" />
                            <Label Text="{Binding TotalText, StringFormat='Total {0}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
