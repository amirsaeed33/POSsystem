<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Rider.RiderDashboardPage"
             x:DataType="vm:RiderDashboardViewModel"
             Title="Rider"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <AbsoluteLayout BackgroundColor="#F5F5F5">
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="All"
                    BackgroundColor="#F5F5F5">
            <VerticalStackLayout Padding="16,16,16,16" Spacing="12" BackgroundColor="#F5F5F5">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Stats.RiderName}" FontSize="22" FontAttributes="Bold" TextColor="#1F2A24" />
                    <Label Text="{Binding Stats.BranchName}" TextColor="#5C6B63" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Border Padding="12" Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Stats.ActiveAssignedCount, StringFormat='Active: {0}'}" TextColor="#1F2A24" />
                    </Border>
                    <Border Grid.Column="1" Padding="12" Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Stats.TodayDeliveredCount, StringFormat='Delivered: {0}'}" TextColor="#1F2A24" />
                    </Border>
                    <Border Grid.Row="1" Padding="12" Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Stats.ActivePendingAmount, StringFormat='Pending: {0:0.00}'}" TextColor="#1F2A24" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="12" Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Stats.TodayDeliveredAmount, StringFormat='Today: {0:0.00}'}" TextColor="#1F2A24" />
                    </Border>
                </Grid>
                <CollectionView ItemsSource="{Binding Orders}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RiderOrderDto">
                            <Border Stroke="#E8ECEA" StrokeThickness="1" Padding="12" Margin="0,0,0,10" BackgroundColor="#FAFBFA">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding OrderNo}" FontAttributes="Bold" FontSize="18" TextColor="#1F2A24" />
                                    <Label Text="{Binding CustomerName}" TextColor="#1F2A24" />
                                    <Label Text="{Binding CustomerAddress}" TextColor="#5C6B63" />
                                    <Label Text="{Binding StatusText}" TextColor="#5C6B63" />
                                    <Label Text="{Binding TotalText, StringFormat='Total {0}'}" TextColor="#0F6B4C" />
                                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                        <Button Text="Accept" Margin="0,0,8,8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RiderDashboardViewModel}}, Path=AcceptCommand}"
                                                CommandParameter="{Binding .}" BackgroundColor="#0F6B4C" TextColor="White" />
                                        <Button Text="Reject" Margin="0,0,8,8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RiderDashboardViewModel}}, Path=RejectCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Complete" Margin="0,0,8,8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RiderDashboardViewModel}}, Path=CompleteCommand}"
                                                CommandParameter="{Binding .}" BackgroundColor="#1F2A24" TextColor="White" />
                                        <Button Text="Map" Margin="0,0,8,8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RiderDashboardViewModel}}, Path=OpenMapsCommand}"
                                                CommandParameter="{Binding .}" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BubbleTabBar AbsoluteLayout.LayoutBounds="0,1,1,52"
                               AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"
                               TranslationY="-56"
                               Mode="Rider"
                               SelectedIndex="0"
                               ZIndex="40"
                               InputTransparent="False" />
    </AbsoluteLayout>
</ContentPage>
