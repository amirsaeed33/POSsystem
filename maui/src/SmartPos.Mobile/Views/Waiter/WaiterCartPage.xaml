<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:helpers="clr-namespace:SmartPos.Mobile.Helpers"
             x:Class="SmartPos.Mobile.Views.Waiter.WaiterCartPage"
             x:DataType="vm:WaiterOrderViewModel"
             Title="Current order"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#EDF3EF">

    <ContentPage.Resources>
        <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#EDF3EF">
        <Border BackgroundColor="#0B3D2E"
                Padding="16,16,16,14"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,24,24" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="#147A55"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="CURRENT ORDER"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#A7F3D0"
                           CharacterSpacing="1.1" />
                    <Label Text="{Binding OrderTitle}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="White"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Label Grid.Column="2"
                       Text="{Binding SubtotalText, StringFormat='Rs {0}'}"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="#A7F3D0"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="12,12,12,8">
            <Border IsVisible="{Binding HasCartItems, Converter={StaticResource InvertedBoolConverter}}"
                    Stroke="#E2E8E4"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="28,36"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="72"
                            HeightRequest="72"
                            StrokeThickness="0"
                            BackgroundColor="#E7F5EF"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36" />
                        </Border.StrokeShape>
                        <Image Source="icon_cart.png"
                               WidthRequest="34"
                               HeightRequest="34"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No items yet"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1F2A24"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Add items from the menu, then send them to the kitchen."
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Lines}"
                            IsVisible="{Binding HasCartItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartLine">
                        <Border Stroke="#E8ECEA"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#1F2A24"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SelectedModifiers}"
                                           IsVisible="{Binding HasModifiers}"
                                           TextColor="#0F6B4C"
                                           FontSize="11"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding KitchenNotes}"
                                           IsVisible="{Binding HasKitchenNotes}"
                                           TextColor="#8A9690"
                                           FontSize="11"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding UnitPriceText, StringFormat='Rs {0}'}"
                                           TextColor="#5C6B63"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                        <Button Text="−"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0"
                                                CornerRadius="10"
                                                BackgroundColor="#EEF2F0"
                                                TextColor="#1F2A24"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=DecreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Quantity}"
                                               WidthRequest="28"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold"
                                               TextColor="#1F2A24" />
                                        <Button Grid.Column="2"
                                                Text="+"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0"
                                                CornerRadius="10"
                                                BackgroundColor="#E7F5EF"
                                                TextColor="#0F6B4C"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=IncreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                    <Border WidthRequest="28"
                                            HeightRequest="28"
                                            StrokeThickness="0"
                                            BackgroundColor="#FEE2E2"
                                            HorizontalOptions="End">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=RemoveLineCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="✕"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#B42318"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="12,10">
            <Button Text="Send KOT"
                    Command="{Binding SendToKitchenCommand}"
                    IsEnabled="{Binding HasCartItems}"
                    BackgroundColor="#0F6B4C"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    FontSize="16" />
        </Border>
    </Grid>
</ContentPage>
