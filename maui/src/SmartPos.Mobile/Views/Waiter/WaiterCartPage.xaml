<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:helpers="clr-namespace:SmartPos.Mobile.Helpers"
             x:Class="SmartPos.Mobile.Views.Waiter.WaiterCartPage"
             x:DataType="vm:WaiterOrderViewModel"
             Title="Current order"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource StaffPageBackground}">

    <ContentPage.Resources>
        <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource StaffPageBackground}">
        <Border BackgroundColor="{StaticResource StaffHero}"
                Padding="16,16,16,14"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,24,24" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource StaffHeroAccent}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="CURRENT ORDER"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="{StaticResource StaffHeroLabel}"
                           CharacterSpacing="1.1" />
                    <Label Text="{Binding OrderTitle}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{StaticResource White}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Label Grid.Column="2"
                       Text="{Binding SubtotalText, StringFormat='Rs {0}'}"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{StaticResource StaffHeroLabel}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="12,12,12,8">
            <Border IsVisible="{Binding HasCartItems, Converter={StaticResource InvertedBoolConverter}}"
                    Stroke="{StaticResource CartBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="28,36"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="72"
                            HeightRequest="72"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource CartAccentBackground}"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36" />
                        </Border.StrokeShape>
                        <Image Source="icon_cart.png"
                               WidthRequest="34"
                               HeightRequest="34"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No items yet"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource CartText}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Add items from the menu, then send them to the kitchen."
                           FontSize="13"
                           TextColor="{StaticResource AuthMutedText}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Lines}"
                            IsVisible="{Binding HasCartItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartLine">
                        <Border Stroke="{StaticResource StaffBorderCool}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource CardBackground}"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="{StaticResource CartText}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SelectedModifiers}"
                                           IsVisible="{Binding HasModifiers}"
                                           TextColor="{StaticResource StaffPrimary}"
                                           FontSize="11"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding KitchenNotes}"
                                           IsVisible="{Binding HasKitchenNotes}"
                                           TextColor="{StaticResource StaffMuted}"
                                           FontSize="11"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding UnitPriceText, StringFormat='Rs {0}'}"
                                           TextColor="{StaticResource CartMuted}"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                        <Button Text="−"
                                                Style="{StaticResource QtyDecreaseButton}"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=DecreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Quantity}"
                                               WidthRequest="28"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource CartText}" />
                                        <Button Grid.Column="2"
                                                Text="+"
                                                Style="{StaticResource QtyIncreaseButton}"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=IncreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                    <Border WidthRequest="28"
                                            HeightRequest="28"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource DangerBackground}"
                                            HorizontalOptions="End">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=RemoveLineCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="✕"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource DangerAccent}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Grid.Row="2"
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0"
                Padding="12,10">
            <Button Text="Send KOT"
                    Command="{Binding SendToKitchenCommand}"
                    IsEnabled="{Binding HasCartItems}"
                    Style="{StaticResource StaffPrimaryButton}"
                    CornerRadius="14"
                    HeightRequest="48"
                    FontSize="16" />
        </Border>
    </Grid>
</ContentPage>
