<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Waiter.WaiterMyOrdersPage"
             x:DataType="vm:WaiterMyOrdersViewModel"
             Title="My Orders"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <Grid BackgroundColor="#F5F5F5">
    <Grid
          RowDefinitions="Auto,*"
          BackgroundColor="#F5F5F5">
        <Border BackgroundColor="#0F6B4C" Padding="16,18" StrokeThickness="0">
            <VerticalStackLayout Spacing="4">
                <Label Text="My Orders" FontSize="22" FontAttributes="Bold" TextColor="White" />
                <Label Text="Open tickets assigned to you" FontSize="13" TextColor="#D7EDE4" />
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Orders}" Margin="12">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="No active orders"
                           TextColor="#5C6B63"
                           HorizontalOptions="Center"
                           Margin="24"
                           FontSize="15" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RestaurantOrderDto">
                        <Border Stroke="#E2E8E4" BackgroundColor="White" Padding="14" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterMyOrdersViewModel}}, Path=OpenOrderCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Label Text="{Binding OrderNo}" FontAttributes="Bold" FontSize="17" TextColor="#1F2A24" />
                                <Label Grid.Column="1"
                                       Text="{Binding GrandTotalText, StringFormat='Rs {0}'}"
                                       FontAttributes="Bold"
                                       TextColor="#0F6B4C"
                                       FontSize="15" />
                                <Label Grid.Row="1" Text="{Binding TableNo, StringFormat='Table {0}'}" TextColor="#5C6B63" />
                                <Label Grid.Row="2" Text="{Binding StatusName}" TextColor="#0F6B4C" FontSize="13" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
        <controls:BubbleTabBar Mode="Waiter"
                               SelectedIndex="2"
                               VerticalOptions="End"
                               HorizontalOptions="Fill"
                               ZIndex="40" />
    </Grid>
</ContentPage>
