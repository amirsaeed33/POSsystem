<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:helpers="clr-namespace:SmartPos.Mobile.Helpers"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Waiter.WaiterOrderPage"
             x:DataType="vm:WaiterOrderViewModel"
             Title="Order"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#EDF3EF">

    <ContentPage.Resources>
        <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" BackgroundColor="#EDF3EF">
        <Grid Grid.Row="0" RowDefinitions="Auto,*" BackgroundColor="#EDF3EF">
            <Border BackgroundColor="#0B3D2E"
                    Padding="16,16,16,14"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,24,24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="TABLE ORDER"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#A7F3D0"
                                   CharacterSpacing="1.1" />
                            <Label Text="{Binding OrderTitle}"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <!-- Cart icon (same pattern as Customer screen) -->
                        <Border Grid.Column="1"
                                WidthRequest="42"
                                HeightRequest="42"
                                Stroke="#E5E7EB"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                            </Border.GestureRecognizers>
                            <Grid WidthRequest="42" HeightRequest="42">
                                <Image Source="icon_cart.png"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Border WidthRequest="16"
                                        HeightRequest="16"
                                        StrokeThickness="1"
                                        Stroke="White"
                                        BackgroundColor="#EF4444"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,2,2,0"
                                        IsVisible="{Binding HasCartItems}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding CartCount}"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="12,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Picker Title="Select customer"
                                ItemsSource="{Binding Customers}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedCustomer}"
                                SelectedIndexChanged="OnCustomerChanged"
                                TextColor="#1F2A24"
                                TitleColor="#8A9690"
                                BackgroundColor="Transparent"
                                FontSize="14" />
                    </Border>
                    <Border StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Placeholder="Search menu"
                               Text="{Binding SearchText}"
                               BackgroundColor="Transparent"
                               TextColor="#1F2A24"
                               PlaceholderColor="#8A9690" />
                    </Border>
                    <CollectionView ItemsSource="{Binding Categories}" HeightRequest="40">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WaiterCategoryChip">
                                <Border Padding="14,8"
                                        StrokeThickness="0">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#F7F3C8" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="#147A55" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=SelectCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}"
                                           FontSize="12"
                                           FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#3F3A12" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Products}"
                            Margin="10,10,10,10">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="8"
                                     VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductDto">
                        <Border StrokeThickness="0"
                                BackgroundColor="White"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="12" Offset="0,4" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="0">
                                <Grid HeightRequest="112" BackgroundColor="#E8F0EB">
                                    <Label Text="{Binding Initials}"
                                           IsVisible="{Binding HasImage, Converter={StaticResource InvertedBoolConverter}}"
                                           TextColor="#0F6B4C"
                                           FontAttributes="Bold"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Image Source="{Binding ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                           IsVisible="{Binding HasImage}"
                                           Aspect="AspectFill"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />
                                    <Border IsVisible="{Binding InCart}"
                                            BackgroundColor="#0F6B4C"
                                            Padding="8,2"
                                            StrokeThickness="0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding CartQtyText}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="12" />
                                    </Border>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=IncreaseCardCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <VerticalStackLayout Padding="10,8,10,6" Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="#1F2A24"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                    <Label Text="{Binding CategoryName}"
                                           FontSize="11"
                                           TextColor="#8A9690"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding PriceText, StringFormat='Rs {0}'}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#0F6B4C" />
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,*,*"
                                      Padding="8,0,8,10"
                                      ColumnSpacing="6">
                                    <Button Text="−"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=DecreaseCardCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EEF2F0"
                                            TextColor="#1F2A24"
                                            CornerRadius="10"
                                            HeightRequest="34"
                                            Padding="0" />
                                    <Label Grid.Column="1"
                                           Text="{Binding CartQtyText}"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"
                                           TextColor="#1F2A24" />
                                    <Button Grid.Column="2"
                                            Text="+"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WaiterOrderViewModel}}, Path=IncreaseCardCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#0F6B4C"
                                            TextColor="White"
                                            CornerRadius="10"
                                            HeightRequest="34"
                                            Padding="0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <controls:TabLoadingOverlay Grid.Row="0" />

        <controls:BubbleTabBar Grid.Row="1"
                               Mode="Waiter"
                               SelectedIndex="1"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
