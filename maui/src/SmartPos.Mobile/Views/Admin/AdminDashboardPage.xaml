<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Admin.AdminDashboardPage"
             x:DataType="vm:AdminDashboardViewModel"
             Title="Admin"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#EDF3EF">
    <Grid RowDefinitions="*,Auto" BackgroundColor="#EDF3EF">
        <ScrollView Grid.Row="0" BackgroundColor="#EDF3EF">
            <VerticalStackLayout Padding="0,0,0,16" Spacing="0" BackgroundColor="#EDF3EF">

                <!-- Hero -->
                <Border StrokeThickness="0" BackgroundColor="#0B3D2E" Padding="20,22,20,26">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,28,28" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Border StrokeThickness="0" BackgroundColor="#1A5C45" Padding="10,4" HorizontalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label Text="SUPER ADMIN"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#A7F3D0"
                                           CharacterSpacing="1.2" />
                                </Border>
                                <Label Text="{Binding Greeting}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="{Binding HeaderSubtitle}"
                                       FontSize="13"
                                       TextColor="#9CB9AE" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="#147A55"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Label Text="↻"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border StrokeThickness="0" BackgroundColor="#147A55" Padding="10,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="OPEN" FontSize="10" TextColor="#A7F3D0" />
                                    <Label Text="{Binding OpenOrdersText}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="orders" FontSize="11" TextColor="#C6E6D8" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#147A55" Padding="10,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="TODAY" FontSize="10" TextColor="#A7F3D0" />
                                    <Label Text="{Binding TodayOrdersText}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="online" FontSize="11" TextColor="#C6E6D8" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#147A55" Padding="10,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="GROWTH" FontSize="10" TextColor="#A7F3D0" />
                                    <Label Text="{Binding GrowthText}" FontSize="20" FontAttributes="Bold" TextColor="{Binding GrowthColor}" />
                                    <Label Text="vs yesterday" FontSize="11" TextColor="#C6E6D8" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Padding="16,16,16,0" Spacing="14">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0F6B4C" />
                    <Border StrokeThickness="0"
                            BackgroundColor="#FEE2E2"
                            Padding="12"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ErrorText}" TextColor="#B91C1C" FontSize="13" />
                    </Border>

                    <!-- KPI row -->
                    <Label Text="Today overview"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="#12261D" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Border StrokeThickness="0" BackgroundColor="White" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="16" Offset="0,6" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border StrokeThickness="0" BackgroundColor="#DCFCE7" WidthRequest="34" HeightRequest="34">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="₹"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#15803D"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="Sales"
                                           FontSize="13"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                </Grid>
                                <Label Text="{Binding SalesTodayText}" FontSize="22" FontAttributes="Bold" TextColor="#0F6B4C" />
                                <Label Text="{Binding SalesCountText}" FontSize="11" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="White" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="16" Offset="0,6" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border StrokeThickness="0" BackgroundColor="#E0E7FF" WidthRequest="34" HeightRequest="34">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="%"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#3730A3"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="Profit"
                                           FontSize="13"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                </Grid>
                                <Label Text="{Binding ProfitTodayText}" FontSize="22" FontAttributes="Bold" TextColor="#1E293B" />
                                <Label Text="{Binding ExpensesTodayText, StringFormat='Expenses {0}'}" FontSize="11" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="White" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="16" Offset="0,6" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border StrokeThickness="0" BackgroundColor="#FFEDD5" WidthRequest="34" HeightRequest="34">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="↓"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#C2410C"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="Purchases"
                                           FontSize="13"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                </Grid>
                                <Label Text="{Binding PurchasesTodayText}" FontSize="22" FontAttributes="Bold" TextColor="#C2410C" />
                                <Label Text="Stock intake today" FontSize="11" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" StrokeThickness="0" BackgroundColor="White" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="16" Offset="0,6" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border StrokeThickness="0" BackgroundColor="#F1F5F9" WidthRequest="34" HeightRequest="34">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="⌂"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#334155"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="Branches"
                                           FontSize="13"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                </Grid>
                                <Label Text="{Binding BranchCountText}" FontSize="22" FontAttributes="Bold" TextColor="#1E293B" />
                                <Label Text="Active locations" FontSize="11" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Weekly chart -->
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="18" Offset="0,8" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Last 7 days" FontAttributes="Bold" FontSize="16" TextColor="#12261D" />
                                    <Label Text="Sales vs purchases" FontSize="12" TextColor="#94A3B8" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4">
                                        <BoxView Color="#16A34A" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                                        <Label Text="Sales" FontSize="11" TextColor="#64748B" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <BoxView Color="#EA580C" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                                        <Label Text="Buy" FontSize="11" TextColor="#64748B" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>

                            <Label Text="{Binding ChartEmptyText}"
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,18"
                                   IsVisible="{Binding IsChartEmpty}" />

                            <ScrollView Orientation="Horizontal" IsVisible="{Binding HasChartData}">
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding DayBars}" Spacing="12" Padding="2,0,2,2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:AdminDayBarItem">
                                            <VerticalStackLayout WidthRequest="48" Spacing="6" VerticalOptions="End">
                                                <Grid HeightRequest="110" VerticalOptions="End" ColumnDefinitions="*,*" ColumnSpacing="3">
                                                    <BoxView Color="#16A34A"
                                                             CornerRadius="6,6,2,2"
                                                             HorizontalOptions="Fill"
                                                             VerticalOptions="End"
                                                             HeightRequest="{Binding SalesBarHeight}" />
                                                    <BoxView Grid.Column="1"
                                                             Color="#EA580C"
                                                             CornerRadius="6,6,2,2"
                                                             HorizontalOptions="Fill"
                                                             VerticalOptions="End"
                                                             HeightRequest="{Binding PurchasesBarHeight}" />
                                                </Grid>
                                                <Label Text="{Binding DayLabel}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="#475569" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Order pipeline -->
                    <Label Text="Live order pipeline"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="#12261D" />
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="16" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding StatusSummary}" FontSize="13" TextColor="#475569" LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border StrokeThickness="0" BackgroundColor="#FFF7ED" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Pending" FontSize="11" TextColor="#9A3412" />
                                        <Label Text="{Binding PendingOrdersText}" FontSize="24" FontAttributes="Bold" TextColor="#C2410C" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#EFF6FF" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Preparing" FontSize="11" TextColor="#1E40AF" />
                                        <Label Text="{Binding PreparingText}" FontSize="24" FontAttributes="Bold" TextColor="#1D4ED8" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#ECFDF5" Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Delivered" FontSize="11" TextColor="#065F46" />
                                        <Label Text="{Binding DeliveredText}" FontSize="24" FontAttributes="Bold" TextColor="#047857" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Area-wise orders -->
                    <Label Text="Orders by area"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="#12261D" />
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="16" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding TopAreaSummary}"
                                       FontSize="13"
                                       TextColor="#475569"
                                       LineBreakMode="WordWrap" />
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        BackgroundColor="#DCFCE7"
                                        Padding="8,4"
                                        VerticalOptions="Start"
                                        IsVisible="{Binding HasAreaStats}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="TOP ZONE"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#166534" />
                                </Border>
                            </Grid>

                            <Label Text="No area orders yet. Delivery orders with a zone will appear here."
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   IsVisible="{Binding IsAreaStatsEmpty}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AreaRanks}"
                                                 Spacing="10"
                                                 IsVisible="{Binding HasAreaStats}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:AdminAreaRankItem">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{Binding SoftAccent}"
                                                Padding="12">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border StrokeThickness="0"
                                                            BackgroundColor="{Binding Accent}"
                                                            WidthRequest="28"
                                                            HeightRequest="28"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="14" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding RankLabel}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <Label Text="{Binding AreaName}"
                                                               FontAttributes="Bold"
                                                               FontSize="14"
                                                               TextColor="#12261D"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding OrderCountText}"
                                                               FontSize="12"
                                                               TextColor="#64748B" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="End">
                                                        <Label Text="{Binding ShareText}"
                                                               FontAttributes="Bold"
                                                               FontSize="14"
                                                               TextColor="{Binding Accent}"
                                                               HorizontalTextAlignment="End" />
                                                        <Label Text="{Binding AmountText}"
                                                               FontSize="11"
                                                               TextColor="#64748B"
                                                               HorizontalTextAlignment="End" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <BoxView Color="{Binding Accent}"
                                                         HeightRequest="7"
                                                         CornerRadius="4"
                                                         HorizontalOptions="Start"
                                                         WidthRequest="{Binding BarWidth}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Inventory health -->
                    <Label Text="Inventory health"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="#12261D" />
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#0B3D2E" Opacity="0.08" Radius="16" Offset="0,6" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border StrokeThickness="0" BackgroundColor="#ECFDF5" WidthRequest="58" HeightRequest="58" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="29" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding InStockText}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#047857"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="In stock" FontSize="11" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                                <Border StrokeThickness="0" BackgroundColor="#FFF7ED" WidthRequest="58" HeightRequest="58" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="29" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding LowStockText}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#C2410C"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Low stock" FontSize="11" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                <Border StrokeThickness="0" BackgroundColor="#FEF2F2" WidthRequest="58" HeightRequest="58" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="29" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding OutStockText}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#B91C1C"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Out of stock" FontSize="11" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Recent activity -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Recent activity" FontAttributes="Bold" FontSize="17" TextColor="#12261D" />
                        <Label Grid.Column="1"
                               Text="{Binding TimelineCountText}"
                               FontSize="12"
                               TextColor="#94A3B8"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="No recent sales or purchases yet."
                           FontSize="13"
                           TextColor="#94A3B8"
                           IsVisible="{Binding IsTimelineEmpty}"
                           Margin="0,4,0,8" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timeline}" Spacing="8" IsVisible="{Binding HasTimeline}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AdminTimelineItem">
                                <Border StrokeThickness="0" BackgroundColor="White" Padding="12,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="{Binding AccentSoft}"
                                                WidthRequest="10"
                                                HeightRequest="42">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="#1F2A24"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#94A3B8" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding AmountText}"
                                               TextColor="{Binding Accent}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Refresh dashboard"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="#0F6B4C"
                            TextColor="White"
                            CornerRadius="14"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            Margin="0,6,0,8" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BubbleTabBar Grid.Row="1"
                               Mode="Admin"
                               SelectedIndex="0"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
