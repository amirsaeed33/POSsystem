<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Admin.AdminDashboardPage"
             x:DataType="vm:AdminDashboardViewModel"
             Title="Admin"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <AbsoluteLayout BackgroundColor="#F5F5F5">
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="All"
                    BackgroundColor="#F5F5F5">
            <VerticalStackLayout Padding="16" Spacing="14" BackgroundColor="#F5F5F5">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Greeting}" FontSize="22" FontAttributes="Bold" TextColor="#1F2A24" />
                    <Label Text="Sales · Purchases · Orders · Restaurant status" FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0F6B4C" />
                <Label Text="{Binding ErrorText}"
                       TextColor="#B91C1C"
                       IsVisible="{Binding HasError}" />

                <!-- 1) Sales -->
                <Label Text="Sales" FontAttributes="Bold" FontSize="16" TextColor="#1F2A24" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Today sales" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding SalesTodayText}" FontSize="20" FontAttributes="Bold" TextColor="#0F6B4C" />
                            <Label Text="{Binding GrowthText, StringFormat='Growth {0}'}" FontSize="12" TextColor="#475569" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Today profit" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding ProfitTodayText}" FontSize="20" FontAttributes="Bold" TextColor="#1F2A24" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- 2) Purchases -->
                <Label Text="Purchases" FontAttributes="Bold" FontSize="16" TextColor="#1F2A24" />
                <Border Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Today purchases" FontSize="12" TextColor="#64748B" />
                        <Label Text="{Binding PurchasesTodayText}" FontSize="20" FontAttributes="Bold" TextColor="#C2410C" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Last 7 days" FontAttributes="Bold" FontSize="14" TextColor="#475569" />
                <ScrollView Orientation="Horizontal">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding DayBars}" Spacing="10" Padding="0,0,0,4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AdminDayBarItem">
                                <VerticalStackLayout WidthRequest="56" Spacing="4" VerticalOptions="End">
                                    <Grid HeightRequest="80" VerticalOptions="End">
                                        <BoxView Color="#86EFAC"
                                                 WidthRequest="14"
                                                 HorizontalOptions="Start"
                                                 VerticalOptions="End"
                                                 HeightRequest="{Binding SalesBarHeight}"
                                                 Margin="8,0,0,0" />
                                        <BoxView Color="#FDBA74"
                                                 WidthRequest="14"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="End"
                                                 HeightRequest="{Binding PurchasesBarHeight}"
                                                 Margin="0,0,8,0" />
                                    </Grid>
                                    <Label Text="{Binding DayLabel}" FontSize="11" HorizontalTextAlignment="Center" TextColor="#64748B" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <Label Text="Green = sales · Orange = purchases" FontSize="11" TextColor="#94A3B8" />

                <!-- 3) Current orders -->
                <Label Text="Current orders" FontAttributes="Bold" FontSize="16" TextColor="#1F2A24" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Pending" FontSize="11" TextColor="#64748B" />
                            <Label Text="{Binding PendingOrdersText}" FontSize="22" FontAttributes="Bold" TextColor="#B45309" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Preparing" FontSize="11" TextColor="#64748B" />
                            <Label Text="{Binding PreparingText}" FontSize="22" FontAttributes="Bold" TextColor="#1D4ED8" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Delivered" FontSize="11" TextColor="#64748B" />
                            <Label Text="{Binding DeliveredText}" FontSize="22" FontAttributes="Bold" TextColor="#0F6B4C" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label Text="{Binding TodayOrdersText, StringFormat='Online orders today: {0}'}" FontSize="13" TextColor="#475569" />

                <!-- 4) Restaurant status -->
                <Label Text="Restaurant status" FontAttributes="Bold" FontSize="16" TextColor="#1F2A24" />
                <Border Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding StatusSummary}" FontSize="14" TextColor="#1F2A24" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <VerticalStackLayout>
                                <Label Text="{Binding InStockText}" FontAttributes="Bold" FontSize="16" TextColor="#0F6B4C" HorizontalTextAlignment="Center" />
                                <Label Text="In stock" FontSize="10" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding LowStockText}" FontAttributes="Bold" FontSize="16" TextColor="#B45309" HorizontalTextAlignment="Center" />
                                <Label Text="Low" FontSize="10" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="{Binding OutStockText}" FontAttributes="Bold" FontSize="16" TextColor="#B91C1C" HorizontalTextAlignment="Center" />
                                <Label Text="Out" FontSize="10" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3">
                                <Label Text="{Binding BranchCountText}" FontAttributes="Bold" FontSize="16" TextColor="#1F2A24" HorizontalTextAlignment="Center" />
                                <Label Text="Branches" FontSize="10" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Recent activity" FontAttributes="Bold" FontSize="16" TextColor="#1F2A24" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Timeline}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AdminTimelineItem">
                            <Border Stroke="#E8ECEA" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" TextColor="#1F2A24" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding AmountText}"
                                           TextColor="{Binding Accent}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Refresh dashboard"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#0F6B4C"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="44"
                        Margin="0,4,0,8" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:BubbleTabBar AbsoluteLayout.LayoutBounds="0,1,1,52"
                               AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"
                               TranslationY="-56"
                               Mode="Admin"
                               SelectedIndex="0"
                               ZIndex="40"
                               InputTransparent="False" />
    </AbsoluteLayout>
</ContentPage>
