<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Auth.UnsupportedStaffPage"
             x:DataType="vm:UnsupportedStaffViewModel"
             Title="Unsupported"
             BackgroundColor="{StaticResource SurfaceMuted}">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="This mobile app is for customers, waiters, and riders."
               FontSize="20"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}" />
        <Label Text="Admin / cashier features stay on the website."
               TextColor="{StaticResource TextSecondary}" />
        <controls:AppButton Text="Browse as customer"
                            Command="{Binding ContinueCustomerCommand}"
                            Variant="StaffPrimary" />
        <controls:AppButton Text="Back to login"
                            Command="{Binding LogoutCommand}"
                            Variant="Outline" />
    </VerticalStackLayout>
</ContentPage>
