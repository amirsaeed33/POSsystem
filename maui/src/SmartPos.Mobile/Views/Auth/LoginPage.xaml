<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F8FAFC">
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
        <BoxView Color="#1D4ED8" VerticalOptions="Start" HeightRequest="320" />
        <BoxView Color="#2563EB" VerticalOptions="Start" HeightRequest="220" Opacity="0.55" Margin="0,40,0,0" />
        <Ellipse Fill="#33FFFFFF" WidthRequest="180" HeightRequest="180"
                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-40,-50,0" />
        <Ellipse Fill="#22FFFFFF" WidthRequest="120" HeightRequest="120"
                 HorizontalOptions="Start" VerticalOptions="Start" Margin="-40,90,0,0" />

        <ScrollView Padding="0">
            <VerticalStackLayout Padding="20,36,20,24" Spacing="18">
                <VerticalStackLayout x:Name="BrandHeader"
                                     Spacing="10"
                                     Margin="4,8,4,8"
                                     Opacity="0"
                                     TranslationY="-16">
                    <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" BackgroundColor="White"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Image Source="logo_aljannat.jpg"
                               WidthRequest="36"
                               HeightRequest="36"
                               Aspect="AspectFill"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="Aljannat" FontSize="32" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Food ordering  /  Waiter  /  Rider  /  Customer" FontSize="14" TextColor="#DBEAFE" />
                </VerticalStackLayout>

                <Border x:Name="LoginCard"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20,22"
                        Margin="0,4,0,0"
                        Opacity="0"
                        TranslationY="28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#33000000" Offset="0,8" Radius="20" Opacity="0.18" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <!-- Logged-in account / logout (same Profile tab for all roles) -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsLoggedIn}">
                            <Label Text="Your account" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Text="{Binding WelcomeName, StringFormat='Signed in as {0}'}"
                                   FontSize="14"
                                   TextColor="#64748B" />
                            <Button Text="Continue to Home"
                                    Command="{Binding ContinueToRoleHomeCommand}"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    CornerRadius="24"
                                    HeightRequest="50"
                                    FontAttributes="Bold" />
                            <Button Text="Continue as customer"
                                    Command="{Binding ContinueAsCustomerCommand}"
                                    BackgroundColor="#EFF6FF"
                                    TextColor="#1D4ED8"
                                    CornerRadius="24"
                                    HeightRequest="46"
                                    FontAttributes="Bold" />
                            <Button Text="Log out"
                                    Command="{Binding LogoutCommand}"
                                    BackgroundColor="#FEE2E2"
                                    TextColor="#B91C1C"
                                    CornerRadius="24"
                                    HeightRequest="50"
                                    FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Login form -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowLoginForm}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Welcome back" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="Sign in to your Aljannat account." FontSize="13" TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Label Text="Email" FontSize="12" TextColor="#64748B" />
                            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="46">
                                    <Image Source="icon_email.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Placeholder="name@email.com"
                                           Text="{Binding UserName}"
                                           TextColor="#0F172A"
                                           PlaceholderColor="#94A3B8"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <Label Text="Password" FontSize="12" TextColor="#64748B" />
                            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="46">
                                    <Image Source="icon_lock.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Placeholder="Enter your password"
                                           Text="{Binding Password}"
                                           IsPassword="{Binding IsPasswordHidden}"
                                           TextColor="#0F172A"
                                           PlaceholderColor="#94A3B8"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center" />
                                    <Image Grid.Column="2"
                                           Source="{Binding PasswordEyeIcon}"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                            </Border>

                            <Button Text="Sign in"
                                    ImageSource="icon_login.png"
                                    ContentLayout="Left, 10"
                                    Command="{Binding LoginCommand}"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    CornerRadius="24"
                                    HeightRequest="50"
                                    Margin="0,6,0,0"
                                    FontAttributes="Bold" />

                            <Button Text="Continue as customer"
                                    Command="{Binding ContinueAsCustomerCommand}"
                                    BackgroundColor="#EFF6FF"
                                    TextColor="#1D4ED8"
                                    CornerRadius="24"
                                    HeightRequest="46"
                                    FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <Label Text="{Binding StatusText}" TextColor="#2563EB" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:TransparentBorderLoader IsRunning="{Binding IsBusy}" />
        </Grid>
        <controls:BubbleTabBar Grid.Row="1"
                               x:Name="BottomNav"
                               Mode="Customer"
                               SelectedIndex="3"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
