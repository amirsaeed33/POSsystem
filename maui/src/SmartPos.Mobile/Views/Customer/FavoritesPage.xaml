<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Customer.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title="Favorites"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="*, Auto" BackgroundColor="{StaticResource PageBackground}">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshFavoritesCommand}">
            <ScrollView Padding="16,20,16,24">
                <VerticalStackLayout Spacing="16">

                    <!-- Header with Title & Count Badge -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="My Favorites"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="❤️"
                                       FontSize="20"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Quickly reorder your most loved dishes"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <!-- Item Count Badge -->
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                BackgroundColor="#FEE2E2"
                                Padding="12,6"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsEmptyState, Converter={StaticResource InvertedBoolConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label Text="{Binding FavoriteCount, StringFormat='{0} Saved'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#B91C1C" />
                        </Border>
                    </Grid>

                    <!-- ========================================================= -->
                    <!-- ACTIVE FAVORITES LIST                                      -->
                    <!-- ========================================================= -->
                    <VerticalStackLayout Spacing="12"
                                         IsVisible="{Binding IsEmptyState, Converter={StaticResource InvertedBoolConverter}}"
                                         BindableLayout.ItemsSource="{Binding FavoriteProducts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:OnlineProductDto">
                                <Border Stroke="{StaticResource BorderSubtle}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource CardBackground}"
                                        Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#0A000000" Offset="0,2" Radius="6" Opacity="0.04" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="100, *" ColumnSpacing="12">
                                        <!-- Left: Product Image with Floating Heart -->
                                        <Grid Grid.Column="0" WidthRequest="100" HeightRequest="100">
                                            <Border WidthRequest="100"
                                                    HeightRequest="100"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource Gray100}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>
                                                <Grid>
                                                    <!-- Fallback Icon -->
                                                    <Label Text="🍔"
                                                           FontSize="32"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                    <!-- Image -->
                                                    <Image Source="{Binding ImageUrl}"
                                                           Aspect="AspectFill"
                                                           WidthRequest="100"
                                                           HeightRequest="100" />
                                                </Grid>
                                            </Border>

                                            <!-- Discount Badge (if any) -->
                                            <Border HorizontalOptions="Start"
                                                    VerticalOptions="Start"
                                                    Margin="4"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource BadgeRed}"
                                                    Padding="6,2"
                                                    IsVisible="{Binding HasOriginalPrice}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding DealDiscountBadge}"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Border>
                                        </Grid>

                                        <!-- Right: Details & Actions -->
                                        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" RowSpacing="4">
                                            <!-- Top row: Name & Active Unfavorite Button -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding CategoryName}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource TextSecondary}" />
                                                </VerticalStackLayout>

                                                <!-- Red Heart Button to Unfavorite -->
                                                <Border Grid.Column="1"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#FEE2E2"
                                                        VerticalOptions="Start">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=RemoveFavoriteCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="❤️"
                                                           FontSize="14"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- Middle: Description -->
                                            <Label Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation"
                                                   Margin="0,2,0,4" />

                                            <!-- Bottom row: Price & Quick Add Button -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                                <!-- Price Column -->
                                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding PriceDisplay}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding OriginalPriceDisplay}"
                                                           FontSize="12"
                                                           TextDecorations="Strikethrough"
                                                           TextColor="{StaticResource Gray400}"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding HasOriginalPrice}" />
                                                </HorizontalStackLayout>

                                                <!-- Add / Customize Button -->
                                                <Border Grid.Column="1"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        Padding="12,6"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=AddToCartCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                        <Label Text="+"
                                                               TextColor="White"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center" />
                                                        <Label Text="Add"
                                                               TextColor="White"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ========================================================= -->
                    <!-- EMPTY STATE CARD                                          -->
                    <!-- ========================================================= -->
                    <Border Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource CardBackground}"
                            Padding="24,36"
                            Margin="0,20,0,0"
                            IsVisible="{Binding IsEmptyState}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                            <!-- Heart Emblem -->
                            <Border WidthRequest="72"
                                    HeightRequest="72"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Label Text="❤️"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Text="No Favorites Saved Yet"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Tap the heart icon on any dish you love to save it here for fast 1-tap reordering."
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />

                            <Button Text="Explore Menu"
                                    Command="{Binding BrowseMenuCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Margin="0,8,0,0"
                                    HorizontalOptions="Center"
                                    Padding="28,12" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Customer Bottom Navigation Bar (Tab 2: Favorite) -->
        <controls:BubbleTabBar Grid.Row="1"
                               Mode="Customer"
                               SelectedIndex="2"
                               CartCount="{Binding CartCount}"
                               VerticalOptions="End"
                               HorizontalOptions="Fill" />
    </Grid>

</ContentPage>
