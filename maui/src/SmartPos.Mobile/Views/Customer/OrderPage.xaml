<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             xmlns:helpers="clr-namespace:SmartPos.Mobile.Helpers"
             x:Class="SmartPos.Mobile.Views.Customer.OrderPage"
             x:DataType="vm:CustomerOrderViewModel"
             x:Name="ThisPage"
             Title="All Menu"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          BackgroundColor="{StaticResource PageBackground}">

        <!-- ========================================================= -->
        <!-- 1. STICKY TOP HEADER                                       -->
        <!-- ========================================================= -->
        <Grid Padding="16,12,16,8"
              BackgroundColor="{StaticResource PageBackground}">

            <!-- Deliver-To / Branch pill (display-only) -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource BorderSubtle}"
                    StrokeThickness="1"
                    Padding="10,7"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,4" Radius="12" Opacity="0.05" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Border WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Image Source="location_pin.png"
                               WidthRequest="14"
                               HeightRequest="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="DELIVER TO  •  25–35 MIN"
                               FontSize="9.5"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               CharacterSpacing="0.8"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <HorizontalStackLayout Spacing="2">
                            <Label Text="{Binding DeliverToLabel}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   VerticalOptions="Center" />
                            <Label Text="▾"
                                   FontSize="11"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2–5. MENU LIST                                            -->
        <!-- ========================================================= -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsPullRefreshing, Mode=TwoWay}"
                     Command="{Binding RefreshMenuCommand}"
                     BackgroundColor="{StaticResource PageBackground}">
            <CollectionView ItemsSource="{Binding Products}"
                            SelectionMode="None"
                            BackgroundColor="{StaticResource PageBackground}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            Margin="0,0,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,8">
                        <!-- Title row -->
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              Padding="16,4,16,0">
                            <Label Text="Curated Menu"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   FontFamily="Georgia"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    StrokeThickness="0"
                                    Padding="10,5"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding DishesCountLabel}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </Border>
                        </Grid>

                        <!-- Search -->
                        <Border Margin="16,10,16,0"
                                HeightRequest="46"
                                BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,4" Radius="12" Opacity="0.05" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Image Source="search_icon.png"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Placeholder="Search karahi, biryani, charcoal BBQ..."
                                       Text="{Binding SearchText, Mode=TwoWay}"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent" />
                                <Border Grid.Column="2"
                                        HeightRequest="30"
                                        MinimumWidthRequest="30"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        Padding="8,0"
                                        IsVisible="{Binding HasSearchText}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="✕"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Category chips + Clear All on the same row -->
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              Margin="0,12,0,4"
                              Padding="16,0,16,0">
                            <ScrollView Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never"
                                        VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8"
                                                       BindableLayout.ItemsSource="{Binding Categories}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryChipItem">
                                            <Border HeightRequest="38"
                                                    StrokeThickness="1"
                                                    Stroke="{Binding ChipBorderColor}"
                                                    BackgroundColor="{Binding ChipBackgroundColor}"
                                                    Padding="14,0"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding BindingContext.ToggleCategoryCommand, Source={x:Reference ThisPage}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding ChipTextColor}"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding Count, StringFormat='({0})'}"
                                                           FontSize="10"
                                                           TextColor="{Binding ChipCountTextColor}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <Border Grid.Column="1"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource BorderSubtle}"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="10,6"
                                    HeightRequest="38"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasActiveFilters}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="Clear All"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                    <Label Text="✕"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <Border Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource CardBackground}"
                            Padding="28,36"
                            Margin="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Border WidthRequest="80"
                                    HeightRequest="80"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource PrimaryLight}"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="40" />
                                </Border.StrokeShape>
                                <Label Text="🍽️"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="No Dishes Match Your Filter"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   FontFamily="Georgia"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Try clearing your search or switching back to our full royal menu."
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                            <Border BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    HeightRequest="46"
                                    Padding="16,0"
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Reset Filters &amp; Show Full Menu"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <BoxView HeightRequest="130" Color="Transparent" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:OnlineProductDto">
                        <!-- ContentView.Padding is respected on Windows; Border.Margin is not -->
                        <ContentView Padding="16,0">
                            <Border BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.OpenProductCommand, Source={x:Reference ThisPage}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Grid WidthRequest="96" HeightRequest="96">
                                        <Border StrokeThickness="0"
                                                WidthRequest="96"
                                                HeightRequest="96"
                                                BackgroundColor="{StaticResource SurfaceSecondary}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="96"
                                                   HeightRequest="96" />
                                        </Border>

                                        <Border HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="6"
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource OverlayDarkMedium}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="13" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.ToggleFavoriteCommand, Source={x:Reference ThisPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Path Aspect="Uniform"
                                                  WidthRequest="12"
                                                  HeightRequest="12"
                                                  Fill="{Binding FavoriteFillColor}"
                                                  Stroke="{StaticResource White}"
                                                  StrokeThickness="1.4"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Border HorizontalOptions="Start"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                Stroke="{StaticResource PrimaryBorder}"
                                                StrokeThickness="1"
                                                Padding="7,2"
                                                IsVisible="{Binding HasMenuBadge}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding MenuBadgeText}"
                                                   FontSize="8.5"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="0.5"
                                                   TextColor="{StaticResource Primary}"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                        </Border>

                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               FontFamily="Georgia"
                                               TextColor="{StaticResource TextPrimary}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Description}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />

                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="6"
                                              Margin="0,2,0,0"
                                              VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding OriginalPriceDisplay}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextMuted}"
                                                       TextDecorations="Strikethrough"
                                                       IsVisible="{Binding HasOriginalPrice}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding PriceDisplay}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Border Grid.Column="1"
                                                    HeightRequest="32"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    StrokeThickness="0"
                                                    Padding="12,0"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding InCart, Converter={StaticResource InvertedBoolConverter}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding BindingContext.IncreaseCardCommand, Source={x:Reference ThisPage}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="+ Add"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource White}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="Center" />
                                            </Border>

                                            <Border Grid.Column="1"
                                                    HeightRequest="32"
                                                    BackgroundColor="{StaticResource PrimaryLight}"
                                                    StrokeThickness="0"
                                                    Padding="3,0"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding InCart}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                                    <Border WidthRequest="26"
                                                            HeightRequest="26"
                                                            StrokeThickness="0"
                                                            BackgroundColor="{StaticResource White}"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="7" />
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.DecreaseCardCommand, Source={x:Reference ThisPage}}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="−"
                                                               FontSize="15"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Text="{Binding CartQtyText}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           VerticalOptions="Center"
                                                           WidthRequest="16"
                                                           HorizontalTextAlignment="Center" />
                                                    <Border WidthRequest="26"
                                                            HeightRequest="26"
                                                            StrokeThickness="0"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="7" />
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.IncreaseCardCommand, Source={x:Reference ThisPage}}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="+"
                                                               FontSize="15"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource White}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Floating mini-cart + tab bar -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="0"
                             VerticalOptions="End"
                             ZIndex="40">
            <!-- Orange Dastarkhwan tray summary bar -->
            <Border Margin="16,0,16,8"
                    HeightRequest="58"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    Padding="12,8"
                    IsVisible="{Binding HasCartItems}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,8" Radius="18" Opacity="0.28" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Border WidthRequest="28"
                            HeightRequest="28"
                            BackgroundColor="{StaticResource PrimaryDark}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="{Binding CartCount}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="YOUR DASTARKHWAN TRAY"
                               FontSize="9.5"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="#F9E0D2" />
                        <Label Text="{Binding CartSubtotalDisplay}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2"
                            BackgroundColor="{StaticResource White}"
                            StrokeThickness="0"
                            HeightRequest="34"
                            Padding="14,0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTraySheetCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="View Tray →"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <controls:AljannatBottomNavBar ActiveTab="Order"
                                           CartCount="{Binding CartCount}"
                                           VerticalOptions="End"
                                           HorizontalOptions="Fill" />
        </VerticalStackLayout>

        <!-- Dastarkhwan Tray bottom sheet -->
        <Grid Grid.RowSpan="3"
              ZIndex="100"
              IsVisible="{Binding IsTraySheetVisible}">
            <BoxView Color="{StaticResource OverlayScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseTraySheetCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border VerticalOptions="End"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="0"
                    MaximumHeightRequest="560">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <VerticalStackLayout Padding="20,12,20,8" Spacing="6">
                        <BoxView WidthRequest="40"
                                 HeightRequest="4"
                                 Color="{StaticResource BorderStrong}"
                                 CornerRadius="2"
                                 HorizontalOptions="Center"
                                 Margin="0,0,0,6" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="CURATED ORDER"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.0"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="Your Dastarkhwan Tray"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       FontFamily="Georgia"
                                       TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="Close"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Start"
                                   Margin="0,8,0,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseTraySheetCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Lines -->
                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding CartLines}"
                                    SelectionMode="None"
                                    Margin="16,0"
                                    BackgroundColor="Transparent">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartLine">
                                <Border BackgroundColor="{StaticResource CardBackground}"
                                        Stroke="{StaticResource BorderSubtle}"
                                        StrokeThickness="1"
                                        Padding="10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border WidthRequest="56"
                                                HeightRequest="56"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource SurfaceSecondary}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImagePath, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasImage}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding LineTotalDisplay}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                HeightRequest="34"
                                                BackgroundColor="{StaticResource CardBackground}"
                                                Stroke="{StaticResource BorderSubtle}"
                                                StrokeThickness="1"
                                                Padding="4,0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="11" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Border WidthRequest="28"
                                                        HeightRequest="28"
                                                        StrokeThickness="0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding BindingContext.DecreaseTrayLineCommand, Source={x:Reference ThisPage}}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="−"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding QuantityText}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       WidthRequest="18"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalOptions="Center" />
                                                <Border WidthRequest="28"
                                                        HeightRequest="28"
                                                        StrokeThickness="0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding BindingContext.IncreaseTrayLineCommand, Source={x:Reference ThisPage}}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="+"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Footer -->
                    <VerticalStackLayout Grid.Row="2"
                                         Padding="16,10,16,20"
                                         Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Tray Subtotal (incl. GST)"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding CartSubtotalDisplay}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Border BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0"
                                HeightRequest="52"
                                Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ProceedToCheckoutCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Proceed to Checkout →"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <controls:TabLoadingOverlay Grid.RowSpan="3" ZIndex="120" />
    </Grid>
</ContentPage>
