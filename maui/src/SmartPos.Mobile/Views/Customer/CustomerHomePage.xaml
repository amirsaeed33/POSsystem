<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             xmlns:helpers="clr-namespace:SmartPos.Mobile.Helpers"
             x:Class="SmartPos.Mobile.Views.Customer.CustomerHomePage"
             x:DataType="vm:CustomerHomeViewModel"
             x:Name="ThisPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource PageBackground}">
        <!-- 1. Branch picker (shown when no branch selected) -->
        <ScrollView IsVisible="{Binding NeedsBranchSelection}">
            <VerticalStackLayout Padding="20,40,20,24" Spacing="16">
                <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" BackgroundColor="{StaticResource PrimaryLight}" HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label Text="🏪" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding BranchPickerTitle}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding BranchPickerSubtitle}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextSecondary}" />

                <CollectionView ItemsSource="{Binding Branches}" SelectionMode="None" BackgroundColor="Transparent">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Text="No active branches found."
                               TextColor="{StaticResource TextSecondary}"
                               Margin="12"
                               HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:OnlineBranchDto">
                            <Border Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,2" Radius="6" Opacity="0.04" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectBranchCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="48"
                                            HeightRequest="48"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="{Binding Initials}"
                                                   FontAttributes="Bold"
                                                   FontSize="20"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding LogoUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasLogo}" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding BusinessTypeLabel}" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        <Label Text="{Binding Address}" IsVisible="{Binding HasAddress}" FontSize="11" TextColor="{StaticResource TextSecondary}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Phone, StringFormat='📞 {0}'}" IsVisible="{Binding HasPhone}" FontSize="11" TextColor="{StaticResource Gray600}" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 2. Storefront Main Page -->
        <RefreshView IsRefreshing="{Binding IsPullRefreshing}"
                     Command="{Binding RefreshHomeCommand}"
                     IsVisible="{Binding NeedsBranchSelection, Converter={StaticResource InvertedBoolConverter}}">
            <ScrollView Orientation="Vertical"
                        VerticalScrollBarVisibility="Default"
                        BackgroundColor="{StaticResource PageBackground}">
                <VerticalStackLayout Spacing="18" Padding="18,12,18,96">

                    <!-- ========================================================= -->
                    <!-- 1. HEADER SECTION                                         -->
                    <!-- ========================================================= -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          Margin="0,4,0,4"
                          Padding="0,2"
                          VerticalOptions="Center">

                        <!-- Left: Rounded circular user avatar (Width 36, Height 36) -->
                        <Border Grid.Column="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource BorderSubtle}"
                                BackgroundColor="{StaticResource SuccessBackground}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLoginCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label Text="👤"
                                       FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Image Source="avatar.png"
                                       Aspect="AspectFill"
                                       WidthRequest="36"
                                       HeightRequest="36" />
                            </Grid>
                        </Border>

                        <!-- Center: Subtitle "Deliver To" (Gray, 10sp), location row: Green pin + bold "My Home" + down chevron -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="0"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeBranchCommand}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <Label Text="{Binding DeliverToHeaderLabel}"
                                   FontSize="10"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalTextAlignment="Center" />

                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                <!-- Green pin icon -->
                                <Image Source="location_pin.png"
                                       WidthRequest="11"
                                       HeightRequest="13"
                                       VerticalOptions="Center" />

                                <!-- Bold "My Home" -->
                                <Label Text="{Binding SelectedBranch.Name, TargetNullValue='My Home', FallbackValue='My Home'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />

                                <!-- Small down chevron icon -->
                                <Image Source="chevron_down.png"
                                       WidthRequest="9"
                                       HeightRequest="6"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Right: Two distinct soft rounded outlined icon buttons (Cart button FIRST, Bell button SECOND, 42x42) -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                            <!-- Cart Button (First, 42x42) -->
                            <Border WidthRequest="42"
                                    HeightRequest="42"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                                </Border.GestureRecognizers>
                                <Grid WidthRequest="42" HeightRequest="42">
                                    <Image Source="icon_cart.png"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <!-- Badge -->
                                    <Border WidthRequest="16"
                                            HeightRequest="16"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource White}"
                                            BackgroundColor="{StaticResource BadgeRed}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,2,2,0"
                                            IsVisible="{Binding HasCartItems}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding CartCount}"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource White}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Order History Button (Second, 42x42) -->
                            <Border WidthRequest="42"
                                    HeightRequest="42"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenOrderHistoryCommand}" />
                                </Border.GestureRecognizers>
                                <Grid WidthRequest="42" HeightRequest="42">
                                    <Image Source="icon_receipt.png"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- ========================================================= -->
                    <!-- 2. SEARCH & FILTER BAR (HEIGHT 46)                         -->
                    <!-- ========================================================= -->
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          Padding="0,2">

                        <!-- Search box: Rounded Border (Radius 12), HeightRequest 46, Entry FontSize 12 -->
                        <Border Grid.Column="0"
                                HeightRequest="46"
                                BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="search_icon.png"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Placeholder="{Binding SearchPlaceholder}"
                                       Text="{Binding SearchText, Mode=TwoWay}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent" />
                                <Border Grid.Column="2"
                                        WidthRequest="22"
                                        HeightRequest="22"
                                        BackgroundColor="{StaticResource Gray100}"
                                        StrokeThickness="0"
                                        IsVisible="{Binding HasSearchText}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="✕"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Filter button: Width/Height 44 with Sliders Icon -->
                        <Border Grid.Column="1"
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCategorySearchCommand}" />
                            </Border.GestureRecognizers>
                            <Image Source="icon_sliders.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- ========================================================= -->
                    <!-- 3. PROMO BANNER (DARK CARD)                               -->
                    <!-- ========================================================= -->
                    <Border BackgroundColor="{StaticResource DarkBanner}"
                            StrokeThickness="0"
                            Padding="20,18">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="{Binding PromoTitle}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   LineHeight="1.25"
                                   VerticalOptions="Center" />

                            <controls:AppButton Grid.Column="1"
                                                Text="{Binding PromoCtaText}"
                                                Command="{Binding OrderNowCommand}"
                                                Variant="Primary"
                                                ButtonHeight="40"
                                                CornerRadius="12"
                                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- 4. CATEGORIES SECTION (4x2 DYNAMIC GRID, 58x58 BOXES)     -->
                    <!-- ========================================================= -->
                    <VerticalStackLayout Spacing="4" Padding="0,0">
                        <Grid ColumnDefinitions="*,*,*,*"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="16"
                              ColumnSpacing="12"
                              HorizontalOptions="Fill"
                              BindableLayout.ItemsSource="{Binding DisplayCategories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeCategoryDisplayDto">
                                    <VerticalStackLayout Grid.Row="{Binding GridRow}"
                                                         Grid.Column="{Binding GridColumn}"
                                                         Spacing="2"
                                                         HorizontalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectHomeCategoryCommand, Source={x:Reference ThisPage}}"
                                                                  CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Border WidthRequest="58"
                                                HeightRequest="58"
                                                Stroke="{Binding CardBorderColor}"
                                                StrokeThickness="{Binding CardBorderWidth}"
                                                BackgroundColor="{StaticResource CardBackground}"
                                                HorizontalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.SelectHomeCategoryCommand, Source={x:Reference ThisPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="{StaticResource ShadowFaint}"
                                                        Offset="0,3"
                                                        Radius="6"
                                                        Opacity="0.8" />
                                            </Border.Shadow>
                                            <Grid InputTransparent="True">
                                                <!-- 1. Emoji Icon Fallback (shown if not More button and no image) -->
                                                <Label Text="{Binding IconOrEmoji}"
                                                       FontSize="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding ShowEmoji}" />

                                                <!-- 2. Remote / Local Image (shown when HasImageUrl is true) -->
                                                <Image Source="{Binding ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                       WidthRequest="26"
                                                       HeightRequest="26"
                                                       Aspect="AspectFit"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding HasImageUrl}" />

                                                <!-- 3. Distinct "More" 4-dot Grid Icon -->
                                                <Grid WidthRequest="24"
                                                      HeightRequest="24"
                                                      HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      IsVisible="{Binding IsMoreButton}">
                                                    <Image Source="more_dots.png"
                                                           WidthRequest="24"
                                                           HeightRequest="24"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                    <Label Text="⠿"
                                                           FontSize="18"
                                                           TextColor="{StaticResource Primary}"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Label Text="{Binding Name}"
                                               FontSize="11"
                                               TextColor="{Binding LabelColor}"
                                               FontAttributes="{Binding LabelFontAttributes}"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               Margin="0,6,0,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.SelectHomeCategoryCommand, Source={x:Reference ThisPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ========================================================= -->
                    <!-- 5. EXCLUSIVE DEALS & COMBOS SECTION                       -->
                    <!-- ========================================================= -->
                    <VerticalStackLayout Spacing="8" Margin="0,4,0,10" IsVisible="{Binding HasDeals}">
                        <Grid ColumnDefinitions="*,Auto" Padding="0">
                            <VerticalStackLayout Spacing="1">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="🔥" FontSize="15" VerticalOptions="Center" />
                                    <Label Text="Exclusive Deals &amp; Combos"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="Save more with customizable multi-item value meals"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <controls:AppButton Grid.Column="1"
                                                Text="View all"
                                                Command="{Binding ViewAllMenuCommand}"
                                                Variant="Outline"
                                                ButtonHeight="24"
                                                VerticalOptions="Center" />
                        </Grid>

                        <!-- Horizontal CollectionView for Combos / Deals (~2 cards visible) -->
                        <CollectionView ItemsSource="{Binding DealsList}"
                                        HeightRequest="280"
                                        HorizontalScrollBarVisibility="Never"
                                        SelectionMode="None"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:OnlineProductDto">
                                    <Border WidthRequest="168"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            Padding="0"
                                            Margin="0,2,0,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,3" Radius="8" Opacity="0.08" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=OpenDealModalCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0">
                                            <Grid HeightRequest="132" WidthRequest="168">
                                                <Image Source="{Binding ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                       Aspect="AspectFill"
                                                       HeightRequest="132"
                                                       WidthRequest="168"
                                                       BackgroundColor="{StaticResource Gray100}" />
                                                <BoxView Color="{StaticResource ShadowMedium}" />

                                                <Border HorizontalOptions="Start"
                                                        VerticalOptions="Start"
                                                        Margin="6"
                                                        BackgroundColor="{StaticResource BadgeRed}"
                                                        StrokeThickness="0"
                                                        Padding="5,2">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding DealDiscountBadge}"
                                                           TextColor="{StaticResource White}"
                                                           FontSize="9"
                                                           FontAttributes="Bold" />
                                                </Border>

                                                <Border HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="6"
                                                        BackgroundColor="{StaticResource OverlayScrim}"
                                                        StrokeThickness="0"
                                                        Padding="5,2">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Label Text="CUSTOMIZE"
                                                           TextColor="{StaticResource StaffHeroLabel}"
                                                           FontSize="8"
                                                           FontAttributes="Bold" />
                                                </Border>
                                            </Grid>

                                            <VerticalStackLayout Padding="10,10" Spacing="4">
                                                <Label Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Text="{Binding Description}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       HeightRequest="28" />

                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0" VerticalOptions="Center" ColumnSpacing="4">
                                                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                        <Label Text="{Binding PriceDisplay}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource PrimaryDark}" />
                                                        <Label Text="{Binding OriginalPriceDisplay}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource Gray400}"
                                                               TextDecorations="Strikethrough"
                                                               IsVisible="{Binding HasOriginalPrice}" />
                                                    </VerticalStackLayout>

                                                    <Border Grid.Column="1"
                                                            BackgroundColor="{StaticResource PrimaryLight}"
                                                            StrokeThickness="0"
                                                            Padding="8,5"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8" />
                                                        </Border.StrokeShape>
                                                        <Label Text="Select"
                                                               TextColor="{StaticResource PrimaryDark}"
                                                               FontSize="10"
                                                               FontAttributes="Bold" />
                                                    </Border>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- ========================================================= -->
                    <!-- 6. DYNAMIC "CUSTOMER FEEDBACKS" SHOWCASE                  -->
                    <!-- ========================================================= -->
                    <VerticalStackLayout Spacing="10"
                                         Margin="0,4,0,0"
                                         IsVisible="{Binding HasFeedbacks}">

                        <!-- Section Header (Left: Eyebrow + Title + Subtitle | Right: Rating Summary Card) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0">
                            <!-- Left Headings -->
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Border BackgroundColor="{StaticResource SuccessBackground}"
                                        StrokeThickness="0"
                                        Padding="8,2"
                                        HorizontalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Label Text="WHAT CUSTOMERS SAY"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}"
                                           CharacterSpacing="0.8" />
                                </Border>

                                <Label Text="Customer Feedbacks"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       Margin="0,2,0,0" />

                                <Label Text="Recent delivery ratings at this branch"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>

                            <!-- Right Side: Rating Summary Card -->
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource WarningBackground}"
                                    Stroke="{StaticResource WarningBackground}"
                                    StrokeThickness="1"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding RatingScoreDisplay}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource WarningMuted}"
                                               VerticalOptions="Center" />
                                        <Label Text="★"
                                               FontSize="15"
                                               TextColor="{StaticResource StarGold}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding TotalReviewsSubtitle}"
                                           FontSize="9"
                                           TextColor="{StaticResource WarningText}"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Horizontal Scrolling CollectionView for Customer Feedbacks -->
                        <CollectionView x:Name="FeedbacksCollectionView"
                                        ItemsSource="{Binding Feedbacks}"
                                        HeightRequest="156"
                                        HorizontalScrollBarVisibility="Never"
                                        SelectionMode="None"
                                        Scrolled="OnFeedbacksScrolled">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerFeedbackDto">
                                    <Border WidthRequest="270"
                                            HeightRequest="148"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            Stroke="{StaticResource AuthInputBorder}"
                                            StrokeThickness="1"
                                            Margin="0,2,0,6"
                                            Padding="12,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource Black}"
                                                    Offset="0,2"
                                                    Radius="6"
                                                    Opacity="0.06" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.PauseFeedbackAutoAdvanceCommand, Source={x:Reference ThisPage}}" />
                                        </Border.GestureRecognizers>

                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                                            <!-- Top Row: Avatar + Name/Date + 5 Stars -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                <!-- Avatar / Initials Circle -->
                                                <Border Grid.Column="0"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{Binding AvatarBgColor}"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>
                                                    <Grid WidthRequest="36" HeightRequest="36">
                                                        <!-- Initials are always rendered cleanly at center -->
                                                        <Label Text="{Binding Initials}"
                                                               TextColor="{StaticResource White}"
                                                               FontAttributes="Bold"
                                                               FontSize="12"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                        <!-- Photo renders on top if present, covering initials -->
                                                        <Image Source="{Binding CustomerPhotoUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                               Aspect="AspectFill"
                                                               WidthRequest="36"
                                                               HeightRequest="36"
                                                               IsVisible="{Binding HasPhoto}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Name & Date -->
                                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding CustomerName}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1" />
                                                    <Label Text="{Binding FormattedDate}"
                                                           FontSize="10"
                                                           TextColor="{StaticResource AuthMutedText}" />
                                                </VerticalStackLayout>

                                                <!-- 5 Golden Stars -->
                                                <HorizontalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="★" FontSize="12" TextColor="{Binding Star1Color}" />
                                                    <Label Text="★" FontSize="12" TextColor="{Binding Star2Color}" />
                                                    <Label Text="★" FontSize="12" TextColor="{Binding Star3Color}" />
                                                    <Label Text="★" FontSize="12" TextColor="{Binding Star4Color}" />
                                                    <Label Text="★" FontSize="12" TextColor="{Binding Star5Color}" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <!-- Middle Row: Food Pill -->
                                            <Border Grid.Row="1"
                                                    BackgroundColor="{StaticResource AuthPageBackground}"
                                                    Stroke="{StaticResource AuthInputBorder}"
                                                    StrokeThickness="0.5"
                                                    Padding="6,2"
                                                    HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding DisplayFoodPill}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource Slate600}"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </Border>

                                            <!-- Bottom Row: Quote + Comment -->
                                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                                <Label Grid.Column="0"
                                                       Text="“"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}"
                                                       VerticalOptions="Start"
                                                       Margin="0,-3,0,0" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding DisplayComment}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray600}"
                                                       FontAttributes="Italic"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       LineHeight="1.15" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- 3. Bottom Navigation Bar -->
        <controls:BubbleTabBar x:Name="BottomTabBar"
                               CartCount="{Binding CartCount}"
                               Mode="Customer"
                               SelectedIndex="0"
                               VerticalOptions="End"
                               HorizontalOptions="Fill"
                               ZIndex="40"
                               IsVisible="{Binding IsAnyModalVisible, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- 4. Single Product Customization Modal -->
        <Grid IsVisible="{Binding IsProductModalVisible}"
              ZIndex="100"
              BackgroundColor="{StaticResource OverlayScrim}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseProductModalCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="16,24"
                    MaximumHeightRequest="600">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Hero -->
                    <Grid HeightRequest="160">
                        <Image Source="{Binding ModalProduct.ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                               Aspect="AspectFill"
                               BackgroundColor="{StaticResource AuthInputBorder}" />
                        <BoxView Color="{StaticResource OverlayDarkSoft}" />
                        <VerticalStackLayout VerticalOptions="End" Padding="16,12" Spacing="4">
                            <Label Text="{Binding ModalProduct.Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                            <Label Text="{Binding ModalProduct.PriceLabel}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StaffHeroLabel}" />
                        </VerticalStackLayout>
                        <Border WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource WhiteOverlayMedium}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseProductModalCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✕"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Scrollable Modifiers List -->
                    <ScrollView Grid.Row="1" Padding="16,12">
                        <VerticalStackLayout Spacing="16">
                            <CollectionView ItemsSource="{Binding ModalModifierGroups}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModifierGroupItem">
                                        <VerticalStackLayout Spacing="8" Margin="0,0,0,12">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <CollectionView ItemsSource="{Binding Options}" SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ModifierOptionItem">
                                                        <Border Stroke="{StaticResource BorderSubtle}"
                                                                StrokeThickness="1"
                                                                BackgroundColor="{StaticResource CardBackground}"
                                                                Padding="10,8"
                                                                Margin="0,0,0,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="10" />
                                                            </Border.StrokeShape>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectModalOptionCommand}"
                                                                                      CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                                <Border WidthRequest="18"
                                                                        HeightRequest="18"
                                                                        StrokeThickness="1.5"
                                                                        Stroke="{StaticResource Primary}"
                                                                        BackgroundColor="{StaticResource CardBackground}"
                                                                        VerticalOptions="Center">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="4" />
                                                                    </Border.StrokeShape>
                                                                    <Label Text="✓" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsSelected}" />
                                                                </Border>
                                                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                                                <Label Grid.Column="2" Text="{Binding PriceLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Bottom Bar -->
                    <Border Grid.Row="2"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource PageBackground}"
                                    Padding="4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <controls:AppButton Text="−"
                                                        Variant="QtyDecrease"
                                                        ButtonHeight="34"
                                                        CornerRadius="10"
                                                        Command="{Binding DecreaseDetailQtyCommand}"
                                                        WidthRequest="34" />
                                    <Label Text="{Binding DetailQuantity}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"
                                           WidthRequest="24"
                                           HorizontalTextAlignment="Center" />
                                    <controls:AppButton Text="+"
                                                        Variant="QtyIncrease"
                                                        ButtonHeight="34"
                                                        CornerRadius="10"
                                                        Command="{Binding IncreaseDetailQtyCommand}"
                                                        WidthRequest="34" />
                                </HorizontalStackLayout>
                            </Border>

                            <controls:AppButton Grid.Column="1"
                                                Text="{Binding ModalTotalLabel, StringFormat='Add to Cart • {0}'}"
                                                Variant="Primary"
                                                ButtonHeight="46"
                                                CornerRadius="12"
                                                Clicked="OnModalAddToCartClicked"
                                                Command="{Binding AddModalToCartCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Combo Deal Multi-Item Customization Modal Sheet -->
        <Grid IsVisible="{Binding IsComboModalVisible}"
              ZIndex="120"
              BackgroundColor="{StaticResource OverlayScrim}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseComboModalCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="14,20"
                    MaximumHeightRequest="640">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowStrong}" Offset="0,8" Radius="16" Opacity="0.25" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Hero Header -->
                    <Grid HeightRequest="160">
                        <Image Source="{Binding ComboProduct.ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                               Aspect="AspectFill"
                               BackgroundColor="{StaticResource Slate800}" />
                        <BoxView Color="{StaticResource OverlayDarkMedium}" />

                        <!-- Close Button -->
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource WhiteOverlayMedium}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseComboModalCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✕"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Bottom-left title and meta -->
                        <VerticalStackLayout VerticalOptions="End" Padding="16,12" Spacing="4">
                            <Border BackgroundColor="{StaticResource BadgeRed}"
                                    StrokeThickness="0"
                                    Padding="6,2"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="COMBO CUSTOMIZATION"
                                       TextColor="{StaticResource White}"
                                       FontSize="9"
                                       FontAttributes="Bold" />
                            </Border>

                            <Label Text="{Binding ComboProduct.Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />

                            <Label Text="{Binding ComboProduct.PriceDisplay, StringFormat='Base Deal Price: {0}'}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StaffHeroLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Scrollable Body for Deal Items & Modifiers -->
                    <Grid Grid.Row="1">
                        <!-- Loading State -->
                        <VerticalStackLayout IsVisible="{Binding IsLoadingComboDeal}"
                                             Spacing="12"
                                             Padding="24"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsLoadingComboDeal}"
                                               Color="{StaticResource PrimaryDark}"
                                               WidthRequest="36"
                                               HeightRequest="36" />
                            <Label Text="Loading combo items &amp; choices…"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Slate650}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Items List -->
                        <ScrollView IsVisible="{Binding IsLoadingComboDeal, Converter={StaticResource InvertedBoolConverter}}"
                                    Padding="16,14">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Customize included items in this combo:"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray600}" />

                                <CollectionView ItemsSource="{Binding DealCustomiseItems}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DealCustomiseItem">
                                            <Border BackgroundColor="{StaticResource CardBackground}"
                                                    Stroke="{StaticResource BorderSubtle}"
                                                    StrokeThickness="1"
                                                    Padding="14"
                                                    Margin="0,0,0,14">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,2" Radius="6" Opacity="0.05" />
                                                </Border.Shadow>

                                                <VerticalStackLayout Spacing="10">
                                                    <!-- Item Top Bar: Step + Icon + Name + Status Badge -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                        <Border WidthRequest="36"
                                                                HeightRequest="36"
                                                                StrokeThickness="0"
                                                                BackgroundColor="{StaticResource Gray100}"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="18" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding FoodIcon}"
                                                                   FontSize="18"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                            <Label Text="{Binding StepLabel}"
                                                                   FontSize="10"
                                                                   TextColor="{StaticResource TextSecondary}" />
                                                            <Label Text="{Binding HeaderTitle}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   MaxLines="1"
                                                                   LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>

                                                        <!-- Ready / Choice Required Badge -->
                                                        <Border Grid.Column="2"
                                                                BackgroundColor="{Binding StatusBadgeBgColor}"
                                                                StrokeThickness="0"
                                                                Padding="8,4"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding StatusBadgeText}"
                                                                   TextColor="{Binding StatusBadgeTextColor}"
                                                                   FontSize="10"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center" />
                                                        </Border>
                                                    </Grid>

                                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                                                    <!-- Modifier Groups for this Item -->
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ModifierGroups}"
                                                                         Spacing="10">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ModifierGroupItem">
                                                                <VerticalStackLayout Spacing="6">
                                                                    <!-- Group Header -->
                                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                                        <Label Text="{Binding Name}"
                                                                               FontSize="13"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{StaticResource Slate650}"
                                                                               VerticalOptions="Center" />

                                                                        <Label Grid.Column="1"
                                                                               Text="{Binding SelectionRuleHint}"
                                                                               FontSize="11"
                                                                               TextColor="{StaticResource Gray400}"
                                                                               VerticalOptions="Center" />

                                                                        <Border Grid.Column="2"
                                                                                BackgroundColor="{Binding RequirementBgColor}"
                                                                                StrokeThickness="0"
                                                                                Padding="6,2"
                                                                                VerticalOptions="Center">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="6" />
                                                                            </Border.StrokeShape>
                                                                            <Label Text="{Binding RequirementBadgeText}"
                                                                                   TextColor="{Binding RequirementTextColor}"
                                                                                   FontSize="9"
                                                                                   FontAttributes="Bold" />
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- Options List -->
                                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}"
                                                                                         Spacing="6">
                                                                        <BindableLayout.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:ModifierOptionItem">
                                                                                <Border Stroke="{Binding CardBorderColor}"
                                                                                        StrokeThickness="{Binding CardStrokeThickness}"
                                                                                        BackgroundColor="{Binding CardBgColor}"
                                                                                        Padding="10,8">
                                                                                    <Border.StrokeShape>
                                                                                        <RoundRectangle CornerRadius="10" />
                                                                                    </Border.StrokeShape>
                                                                                    <Border.GestureRecognizers>
                                                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectComboOptionCommand}"
                                                                                                              CommandParameter="{Binding .}" />
                                                                                    </Border.GestureRecognizers>
                                                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                                                        <!-- Radio / Check Indicator -->
                                                                                        <Border WidthRequest="20"
                                                                                                HeightRequest="20"
                                                                                                Stroke="{Binding RadioBorderColor}"
                                                                                                StrokeThickness="1.5"
                                                                                                BackgroundColor="{Binding CheckmarkBg}"
                                                                                                VerticalOptions="Center">
                                                                                            <Border.StrokeShape>
                                                                                                <RoundRectangle CornerRadius="10" />
                                                                                            </Border.StrokeShape>
                                                                                            <Label Text="{Binding CheckmarkGlyph}"
                                                                                                   TextColor="{Binding CheckmarkColor}"
                                                                                                   FontSize="11"
                                                                                                   FontAttributes="Bold"
                                                                                                   HorizontalOptions="Center"
                                                                                                   VerticalOptions="Center" />
                                                                                        </Border>

                                                                                        <!-- Option Name -->
                                                                                        <Label Grid.Column="1"
                                                                                               Text="{Binding Name}"
                                                                                               FontSize="13"
                                                                                               TextColor="{Binding TextColor}"
                                                                                               VerticalOptions="Center" />

                                                                                        <!-- Price Delta -->
                                                                                        <Label Grid.Column="2"
                                                                                               Text="{Binding PriceLabel}"
                                                                                               FontSize="12"
                                                                                               FontAttributes="Bold"
                                                                                               TextColor="{StaticResource PrimaryDark}"
                                                                                               VerticalOptions="Center" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </BindableLayout.ItemTemplate>
                                                                    </VerticalStackLayout>
                                                                </VerticalStackLayout>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- Sticky Bottom Bar -->
                    <Border Grid.Row="2"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,0,24,24" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <!-- Validation warning alert (if options missing) -->
                            <Border IsVisible="{Binding HasComboValidationMessage}"
                                    BackgroundColor="{StaticResource DangerBackgroundSoft}"
                                    Stroke="{StaticResource DangerBackground}"
                                    StrokeThickness="1"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="⚠️" FontSize="11" VerticalOptions="Center" />
                                    <Label Text="{Binding ComboValidationMessage}"
                                           FontSize="11"
                                           TextColor="{StaticResource BadgeRed}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Quantity Stepper -->
                                <Border Stroke="{StaticResource BorderSubtle}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource PageBackground}"
                                        Padding="4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <controls:AppButton Text="−"
                                                            Variant="QtyDecrease"
                                                            ButtonHeight="34"
                                                            CornerRadius="10"
                                                            Command="{Binding DecreaseComboQtyCommand}"
                                                            WidthRequest="34" />
                                        <Label Text="{Binding ComboQuantity}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center"
                                               WidthRequest="24"
                                               HorizontalTextAlignment="Center" />
                                        <controls:AppButton Text="+"
                                                            Variant="QtyIncrease"
                                                            ButtonHeight="34"
                                                            CornerRadius="10"
                                                            Command="{Binding IncreaseComboQtyCommand}"
                                                            WidthRequest="34" />
                                    </HorizontalStackLayout>
                                </Border>

                                <controls:AppButton Grid.Column="1"
                                                    Text="{Binding ComboTotalLabel, StringFormat='Add Deal to Cart • {0}'}"
                                                    Variant="StaffPrimary"
                                                    ButtonHeight="46"
                                                    CornerRadius="12"
                                                    Clicked="OnModalAddToCartClicked"
                                                    Command="{Binding AddComboToCartCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. Top-Level Fly-to-Cart Animation Overlay -->
        <AbsoluteLayout x:Name="FlyAnimationOverlay"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        ZIndex="999"
                        InputTransparent="True"
                        CascadeInputTransparent="True" />

        <!-- 7. Tab-Switching Global Loading Overlay -->
        <controls:TabLoadingOverlay />
    </Grid>
</ContentPage>
