<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             xmlns:helpers="clr-namespace:SmartPos.Mobile.Helpers"
             x:Class="SmartPos.Mobile.Views.Customer.CustomerHomePage"
             x:DataType="vm:CustomerHomeViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <Color x:Key="BrandPrimary">#0F6B4C</Color>
            <Color x:Key="BrandPrimarySoft">#E8F5EF</Color>
            <Color x:Key="TextDark">#1A2B4A</Color>
            <Color x:Key="TextMuted">#6B7A82</Color>
            <Color x:Key="SurfaceCard">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#F5F5F5">
        <Grid RowDefinitions="*" BackgroundColor="#F5F5F5">

        <!-- 1. Branch picker (shown when no branch selected) -->
        <ScrollView IsVisible="{Binding NeedsBranchSelection}">
            <VerticalStackLayout Padding="20,40,20,24" Spacing="16">
                <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" BackgroundColor="#E8F5EF" HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label Text="🏪" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Choose a branch"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="#1A2B4A" />
                <Label Text="Select a store to start ordering"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="#6B7A82" />

                <CollectionView ItemsSource="{Binding Branches}" SelectionMode="None" BackgroundColor="Transparent">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Text="No active branches found."
                               TextColor="#6B7A82"
                               Margin="12"
                               HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:OnlineBranchDto">
                            <Border Stroke="#E8E8E8"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    Padding="14"
                                    Margin="0,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#18000000" Offset="0,4" Radius="8" Opacity="0.8" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectBranchCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="58" HeightRequest="58" StrokeThickness="0" BackgroundColor="#E8F5EF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="{Binding Initials}"
                                                   FontAttributes="Bold"
                                                   FontSize="20"
                                                   TextColor="#0F6B4C"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding LogoUrl}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasLogo}" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#1A2B4A" />
                                        <Label Text="{Binding BusinessTypeLabel}" FontSize="11" TextColor="#0F6B4C" FontAttributes="Bold" />
                                        <Label Text="{Binding Address}" IsVisible="{Binding HasAddress}" FontSize="11" TextColor="#6B7A82" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Phone, StringFormat='📞 {0}'}" IsVisible="{Binding HasPhone}" FontSize="11" TextColor="#3D4A44" MaxLines="1" />
                                        <Label Text="{Binding Email, StringFormat='✉ {0}'}" IsVisible="{Binding HasEmail}" FontSize="11" TextColor="#3D4A44" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#0F6B4C" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 2. Storefront (when branch is selected) -->
        <RefreshView IsRefreshing="{Binding IsPullRefreshing}"
                     Command="{Binding RefreshHomeCommand}"
                     IsVisible="{Binding HasMenu}">
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="0,8,0,96">

                    <!-- Deliver-to & switch-branch bar -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          Padding="14,4,14,0">
                        <Border WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                BackgroundColor="#E8F5EF"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeBranchCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="📍"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Deliver to"
                                   FontSize="11"
                                   TextColor="#6B7A82"
                                   FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding DeliverToLabel}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#1A2B4A"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="▾"
                                       FontSize="12"
                                       TextColor="#0F6B4C"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeBranchCommand}" />
                        </VerticalStackLayout.GestureRecognizers>

                        <!-- Cart icon pill -->
                        <Border Grid.Column="2"
                                StrokeThickness="0"
                                BackgroundColor="#E8F5EF"
                                Padding="10,6"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image Source="icon_cart_bag.png"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding CartCount}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="#0F6B4C"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Search bar -->
                    <Border Margin="14,0"
                            Stroke="#E4EBE6"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="12,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_search.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Placeholder="Search dishes, drinks, deals…"
                                   Text="{Binding SearchText}"
                                   FontSize="14"
                                   TextColor="#1F2A24"
                                   PlaceholderColor="#8A9690"
                                   ReturnType="Search" />
                        </Grid>
                    </Border>

                    <!-- Delivery / Pickup toggle -->
                    <Border Margin="14,0"
                            Stroke="#E4EBE6"
                            StrokeThickness="1"
                            BackgroundColor="#EDF2EE"
                            Padding="3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*">
                            <!-- Delivery option -->
                            <Border BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    HeightRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsDeliveryMode}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#0F6B4C" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetDeliveryModeCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Delivery"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#0F6B4C"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDeliveryMode}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Pickup option -->
                            <Border Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    HeightRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsPickupMode}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#0F6B4C" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetPickupModeCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Pickup"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#0F6B4C"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPickupMode}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Hero banner -->
                    <Border IsVisible="{Binding HasHeroSlides}"
                            Margin="14,0"
                            StrokeThickness="0"
                            BackgroundColor="#121212"
                            HeightRequest="190"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Grid>
                            <CarouselView ItemsSource="{Binding HeroSlides}"
                                          Loop="True"
                                          Position="{Binding HeroPosition}"
                                          IndicatorView="HeroIndicators"
                                          PeekAreaInsets="0"
                                          HorizontalScrollBarVisibility="Never"
                                          VerticalScrollBarVisibility="Never">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HeroSlideDto">
                                        <Grid>
                                            <Image Source="{Binding BgImageUrl}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasBgImage}" />
                                            <BoxView Color="#66121212" />
                                            <VerticalStackLayout Padding="16" Spacing="6" VerticalOptions="End">
                                                <Label Text="{Binding DisplayBadge}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F6B4C"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />
                                                <Label FontSize="20" FontAttributes="Bold" TextColor="White" MaxLines="2" LineBreakMode="TailTruncation">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TitleMain}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding TitleHighlight}" TextColor="#0F6B4C" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>
                            <IndicatorView x:Name="HeroIndicators"
                                           IndicatorColor="#66FFFFFF"
                                           SelectedIndicatorColor="#0F6B4C"
                                           IndicatorsShape="Circle"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End"
                                           Margin="0,0,0,10" />
                        </Grid>
                    </Border>

                    <!-- ============================================================ -->
                    <!-- 🔥 HOT DEALS & TRENDING OFFERS HORIZONTAL CAROUSEL SECTION -->
                    <!-- ============================================================ -->
                    <VerticalStackLayout IsVisible="{Binding HasDeals}"
                                         Margin="0,8,0,4"
                                         Spacing="8">

                        <!-- Section Title -->
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="14,0"
                              VerticalOptions="Center">
                            <VerticalStackLayout Spacing="1">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="🔥" FontSize="18" VerticalOptions="Center" />
                                    <Label Text="Hot Deals &amp; Trending Offers"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="#1A2B4A"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="Special combo bundles &amp; exclusive discounts"
                                       FontSize="11"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="#FEF3C7"
                                    Padding="8,4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="HOT DEALS"
                                       FontAttributes="Bold"
                                       FontSize="10"
                                       TextColor="#B45309"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Horizontal Carousel -->
                        <CollectionView ItemsSource="{Binding DealsList}"
                                        SelectionMode="None"
                                        BackgroundColor="Transparent"
                                        HeightRequest="240">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:OnlineProductDto">
                                    <Border WidthRequest="240"
                                            Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            Padding="0"
                                            Margin="14,2,2,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#10000000" Offset="0,3" Radius="6" Opacity="0.5" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=OpenDealModalCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid RowDefinitions="115,*" Padding="0">
                                            <!-- Deal Image + Badges -->
                                            <Grid HeightRequest="115">
                                                <Image Source="{Binding ImageUrl}"
                                                       Aspect="AspectFill"
                                                       BackgroundColor="#F1F5F9" />
                                                <BoxView Color="#33000000" />

                                                <Border HorizontalOptions="Start"
                                                        VerticalOptions="Start"
                                                        Margin="8"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#DC2626"
                                                        Padding="6,3">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding DealDiscountBadge}"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="White" />
                                                </Border>

                                                <Border HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="8"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#CC0F172A"
                                                        Padding="6,3">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Label Text="COMBO"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="#FEF08A" />
                                                </Border>
                                            </Grid>

                                            <!-- Content -->
                                            <VerticalStackLayout Grid.Row="1" Padding="10,8" Spacing="4" VerticalOptions="FillAndExpand">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       TextColor="#0F172A"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Text="{Binding DealItemsSummary}"
                                                       FontSize="11"
                                                       TextColor="#475569"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation" />

                                                <!-- Price & Customise Button -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" VerticalOptions="EndAndExpand">
                                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                        <Label Text="{Binding OriginalPriceDisplay}"
                                                               IsVisible="{Binding HasOriginalPrice}"
                                                               FontSize="10"
                                                               TextColor="#94A3B8"
                                                               TextDecorations="Strikethrough" />
                                                        <Label Text="{Binding PriceDisplay}"
                                                               FontAttributes="Bold"
                                                               FontSize="15"
                                                               TextColor="#0F6B4C" />
                                                    </VerticalStackLayout>

                                                    <Border Grid.Column="1"
                                                            StrokeThickness="0"
                                                            BackgroundColor="#0F6B4C"
                                                            Padding="10,6"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=OpenDealModalCommand}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                            <Label Text="Customise"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="White"
                                                                   VerticalOptions="Center" />
                                                            <Label Text="+"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="White"
                                                                   VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Explore Menu header + category search -->
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="10"
                          Padding="14,4,14,0">
                        <Label Text="Explore Menu"
                               FontAttributes="Bold"
                               FontSize="20"
                               TextColor="#1A2B4A"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                BackgroundColor="#E8F5EF"
                                Padding="12,8"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCategorySearchCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Search"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="#0F6B4C"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="2"
                               Text="VIEW ALL"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="#0F6B4C"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllMenuCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Border IsVisible="{Binding IsCategorySearchVisible}"
                            Margin="14,8,14,0"
                            Stroke="#E4EBE6"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Placeholder="Search categories…"
                                   Text="{Binding CategorySearchText}"
                                   FontSize="14"
                                   TextColor="#1F2A24"
                                   PlaceholderColor="#8A9690"
                                   ReturnType="Search" />
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="#FEECEC"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearCategorySearchCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Clear"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#B42318"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Categories: filtered chips in one horizontal row -->
                    <CollectionView ItemsSource="{Binding Categories}"
                                    SelectionMode="None"
                                    Margin="10,6,10,12"
                                    BackgroundColor="Transparent"
                                    HeightRequest="44">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryChipItem">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#EEF2F0"
                                        Padding="14,10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#0F6B4C" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                StrokeThickness="0"
                                                BackgroundColor="#D8E8E0"
                                                IsVisible="{Binding HasImage}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="11" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Border>
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="#1F2A24"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Smart Filter Quick Capsules (Horizontal Scroll, No Scrollbars) -->
                    <CollectionView ItemsSource="{Binding FilterPills}"
                                    SelectionMode="None"
                                    Margin="10,0,10,12"
                                    BackgroundColor="Transparent"
                                    HeightRequest="38"
                                    HorizontalScrollBarVisibility="Never"
                                    VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickFilterPillItem">
                                <Border StrokeThickness="1"
                                        Stroke="{Binding StrokeColor}"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Padding="12,6"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectPillCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}"
                                               FontSize="12"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{Binding TextColor}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Products (cards) -->
                    <VerticalStackLayout IsVisible="{Binding ShowProductGrid}"
                                         Spacing="10"
                                         Padding="14,0">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="{Binding SelectedCategoryTitle}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#1A2B4A" />
                            <Label Text="{Binding FilteredItemsLabel}"
                                   FontSize="13"
                                   TextColor="#6B7A82"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <CollectionView ItemsSource="{Binding Products}"
                                        SelectionMode="None"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                                 Span="2"
                                                 HorizontalItemSpacing="8"
                                                 VerticalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="24,48" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="#FEE2E2"
                                            WidthRequest="64"
                                            HeightRequest="64"
                                            HorizontalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="32" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding EmptyStateIcon}"
                                               FontSize="28"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding EmptyStateTitle}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="#1A2B4A"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding EmptyStateSubtitle}"
                                           FontSize="13"
                                           TextColor="#6B7A82"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"
                                           MaximumWidthRequest="280" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:OnlineProductDto">
                                    <Border Stroke="#ECEFF1"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            Padding="0"
                                            Margin="0,0,0,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#0A000000" Offset="0,2" Radius="4" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=OpenProductCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0">
                                            <!-- Image container with overlay badges -->
                                            <Grid HeightRequest="120">
                                                <Border StrokeThickness="0" BackgroundColor="#E2E8F0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14,14,0,0" />
                                                    </Border.StrokeShape>
                                                    <Grid>
                                                        <Label Text="{Binding Initials}"
                                                               FontAttributes="Bold"
                                                               FontSize="26"
                                                               TextColor="#94A3B8"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                        <Image Source="{Binding ImageUrl}"
                                                               Aspect="AspectFill"
                                                               IsVisible="{Binding HasImage}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Top-left tag badge -->
                                                <Border HorizontalOptions="Start"
                                                        VerticalOptions="Start"
                                                        Margin="6"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#E11D48"
                                                        Padding="6,2"
                                                        IsVisible="{Binding HasTag}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding DisplayTag}"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="White" />
                                                </Border>

                                                <!-- Top-right Heart (❤️) Favorite button with micro-interaction -->
                                                <Border HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="6"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#E6FFFFFF"
                                                        Padding="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Border.Shadow>
                                                        <Shadow Brush="#25000000" Offset="0,1" Radius="3" />
                                                    </Border.Shadow>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Tapped="OnFavoriteHeartTapped"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=ToggleFavoriteCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Path Aspect="Uniform"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center"
                                                          WidthRequest="16"
                                                          HeightRequest="16"
                                                          Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                          Fill="{Binding FavoriteFillColor}"
                                                          Stroke="{Binding FavoriteStrokeColor}"
                                                          StrokeThickness="1.5" />
                                                </Border>

                                                <!-- Out of stock overlay -->
                                                <Grid BackgroundColor="#99000000"
                                                      IsVisible="{Binding InStock, Converter={StaticResource InvertedBoolConverter}}">
                                                    <Label Text="OUT OF STOCK"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>

                                            <!-- Content -->
                                            <VerticalStackLayout Padding="8,8,8,10" Spacing="4">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       TextColor="#0F172A"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Text="{Binding Description}"
                                                       FontSize="11"
                                                       TextColor="#64748B"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       HeightRequest="28" />

                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0" VerticalOptions="End">
                                                    <Label Text="{Binding PriceDisplay}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           TextColor="#0F6B4C"
                                                           VerticalOptions="Center" />

                                                    <!-- Quantity controls / Add button -->
                                                    <Grid Grid.Column="1">
                                                        <!-- Add button (shown when CartQty == 0) -->
                                                        <Border WidthRequest="28"
                                                                HeightRequest="28"
                                                                StrokeThickness="0"
                                                                BackgroundColor="#0F6B4C"
                                                                IsVisible="{Binding InCart, Converter={StaticResource InvertedBoolConverter}}">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Tapped="OnAddToCartButtonTapped"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=IncreaseCardCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Label Text="+"
                                                                   TextColor="White"
                                                                   FontAttributes="Bold"
                                                                   FontSize="16"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>

                                                        <!-- - / Qty / + stepper (shown when InCart) -->
                                                        <Border Stroke="#0F6B4C"
                                                                StrokeThickness="1"
                                                                BackgroundColor="#E8F5EF"
                                                                Padding="2"
                                                                IsVisible="{Binding InCart}">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>
                                                            <HorizontalStackLayout Spacing="4">
                                                                <Label Text="−"
                                                                       FontSize="12"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#0F6B4C"
                                                                       WidthRequest="16"
                                                                       HorizontalTextAlignment="Center"
                                                                       VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=DecreaseCardCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                                <Label Text="{Binding CartQtyText}"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#0F6B4C"
                                                                       VerticalOptions="Center" />
                                                                <Label Text="+"
                                                                       FontSize="12"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#0F6B4C"
                                                                       WidthRequest="16"
                                                                       HorizontalTextAlignment="Center"
                                                                       VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Tapped="OnAddToCartButtonTapped"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=IncreaseCardCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                    <!-- Customer Feedbacks & Verified Reviews Marquee -->
                    <VerticalStackLayout Spacing="12"
                                         Margin="0,8,0,84"
                                         IsVisible="{Binding HasFeedbacks}">

                        <!-- Section Header with Overall Rating Badge -->
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="14,0"
                              VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="WHAT CUSTOMERS SAY"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#0F6B4C"
                                       CharacterSpacing="1" />
                                <Label Text="Verified Reviews &amp; Ratings"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1A2B4A" />
                            </VerticalStackLayout>

                            <!-- Overall Rating Badge -->
                            <Border Grid.Column="1"
                                    StrokeThickness="1"
                                    Stroke="#D1FAE5"
                                    BackgroundColor="#E8F5EF"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="⭐" FontSize="13" VerticalOptions="Center" />
                                    <Label Text="{Binding RatingScoreDisplay}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="#0F6B4C"
                                           VerticalOptions="Center" />
                                    <Label Text="•"
                                           FontSize="11"
                                           TextColor="#059669"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding TotalReviewsLabel}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#059669"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Skeleton Loading State (Shown while IsLoadingFeedbacks == True) -->
                        <Grid IsVisible="{Binding IsLoadingFeedbacks}"
                              HeightRequest="150"
                              Padding="14,0">
                            <Border StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    BackgroundColor="#FFFFFF"
                                    Padding="16,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <!-- Avatar Skeleton -->
                                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="#E2E8F0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                        </Border>
                                        <!-- Name & Stars Skeleton -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Border WidthRequest="110" HeightRequest="12" StrokeThickness="0" BackgroundColor="#E2E8F0" HorizontalOptions="Start">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                            </Border>
                                            <Border WidthRequest="70" HeightRequest="10" StrokeThickness="0" BackgroundColor="#CBD5E1" HorizontalOptions="Start">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                            </Border>
                                        </VerticalStackLayout>
                                        <!-- Badge Skeleton -->
                                        <Border Grid.Column="2" WidthRequest="76" HeightRequest="20" StrokeThickness="0" BackgroundColor="#E2E8F0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                        </Border>
                                    </Grid>
                                    <!-- Comment lines skeleton -->
                                    <Border WidthRequest="260" HeightRequest="10" StrokeThickness="0" BackgroundColor="#E2E8F0" HorizontalOptions="Start">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                    </Border>
                                    <Border WidthRequest="180" HeightRequest="10" StrokeThickness="0" BackgroundColor="#E2E8F0" HorizontalOptions="Start">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Auto-sliding / Horizontally Scrolling Review Cards Carousel -->
                        <Grid IsVisible="{Binding IsLoadingFeedbacks, Converter={StaticResource InvertedBoolConverter}}">
                            <CarouselView x:Name="FeedbackCarousel"
                                          ItemsSource="{Binding Feedbacks}"
                                          Position="{Binding FeedbackPosition, Mode=TwoWay}"
                                          IndicatorView="FeedbackIndicators"
                                          Loop="True"
                                          PeekAreaInsets="20"
                                          HeightRequest="156"
                                          HorizontalScrollBarVisibility="Never">
                                <CarouselView.GestureRecognizers>
                                    <PointerGestureRecognizer PointerPressed="OnFeedbackPointerPressed"
                                                              PointerReleased="OnFeedbackPointerReleased"
                                                              PointerEntered="OnFeedbackPointerEntered"
                                                              PointerExited="OnFeedbackPointerExited" />
                                </CarouselView.GestureRecognizers>
                                <CarouselView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="12"
                                                       SnapPointsType="MandatorySingle"
                                                       SnapPointsAlignment="Center" />
                                </CarouselView.ItemsLayout>
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerFeedbackDto">
                                        <Border StrokeThickness="1"
                                                Stroke="#E2E8F0"
                                                BackgroundColor="White"
                                                Padding="14,12"
                                                Margin="2,2,2,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#10000000" Offset="0,2" Radius="4" />
                                            </Border.Shadow>
                                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                                                <!-- Row 0: Avatar, Name, Star rating, Verified Order Badge -->
                                                <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                    <!-- Customer Initial Avatar -->
                                                    <Border WidthRequest="36"
                                                            HeightRequest="36"
                                                            StrokeThickness="0"
                                                            BackgroundColor="{Binding AvatarBgColor}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="18" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding Initials}"
                                                               TextColor="White"
                                                               FontAttributes="Bold"
                                                               FontSize="13"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>

                                                    <!-- Name & Star Rating -->
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                        <Label Text="{Binding CustomerName}"
                                                               FontAttributes="Bold"
                                                               FontSize="13"
                                                               TextColor="#1E293B"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1" />
                                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                            <Label Text="{Binding StarRatingDisplay}"
                                                                   FontSize="11"
                                                                   VerticalOptions="Center" />
                                                            <Label Text="•"
                                                                   FontSize="9"
                                                                   TextColor="#94A3B8"
                                                                   VerticalOptions="Center" />
                                                            <Label Text="{Binding FormattedDate}"
                                                                   FontSize="10"
                                                                   TextColor="#94A3B8"
                                                                   VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>

                                                    <!-- Verified Purchase Badge -->
                                                    <Border Grid.Column="2"
                                                            StrokeThickness="0"
                                                            BackgroundColor="#E8F5EF"
                                                            Padding="6,3"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>
                                                        <Label Text="✓ Verified Order"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               TextColor="#0F6B4C" />
                                                    </Border>
                                                </Grid>

                                                <!-- Row 1: Ordered items tag (if available) -->
                                                <Border Grid.Row="1"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#F8FAFC"
                                                        Padding="8,4"
                                                        HorizontalOptions="Start"
                                                        IsVisible="{Binding HasItemsSummary}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding DisplayItemsSummary}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="#475569"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation" />
                                                </Border>

                                                <!-- Row 2: Customer Review Comment -->
                                                <Label Grid.Row="2"
                                                       Text="{Binding DisplayComment}"
                                                       FontSize="12"
                                                       TextColor="#334155"
                                                       LineHeight="1.2"
                                                       MaxLines="3"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Start" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>
                        </Grid>

                        <!-- Indicator dots -->
                        <IndicatorView x:Name="FeedbackIndicators"
                                       IndicatorColor="#CBD5E1"
                                       SelectedIndicatorColor="#0F6B4C"
                                       IndicatorsShape="Circle"
                                       IndicatorSize="6"
                                       HorizontalOptions="Center"
                                       Margin="0,-4,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        </Grid>

        <!-- 3. Bottom Navigation Bar -->
        <controls:BubbleTabBar x:Name="BottomTabBar"
                               CartCount="{Binding CartCount}"
                               Mode="Customer"
                               SelectedIndex="0"
                               VerticalOptions="End"
                               HorizontalOptions="Fill"
                               ZIndex="40"
                               IsVisible="{Binding IsAnyModalVisible, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- 4. Single Product Customization Modal -->
        <Grid IsVisible="{Binding IsProductModalVisible}"
              ZIndex="100"
              BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseProductModalCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="16,24"
                    MaximumHeightRequest="620">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Hero -->
                    <Grid HeightRequest="180">
                        <Image Source="{Binding ModalProduct.ImageUrl}"
                               Aspect="AspectFill"
                               BackgroundColor="#E2E8F0" />
                        <BoxView Color="#66000000" />
                        <VerticalStackLayout VerticalOptions="End" Padding="16,12" Spacing="4">
                            <Label Text="{Binding ModalProduct.CategoryName}"
                                   FontSize="11"
                                   TextColor="#FECACA"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding ModalProduct.Name}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </VerticalStackLayout>
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                StrokeThickness="0"
                                BackgroundColor="#CCFFFFFF"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseProductModalCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✕"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="#0F172A" />
                        </Border>
                    </Grid>

                    <ScrollView Grid.Row="1" Padding="16,12">
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsLoadingModifiers}">
                                <ActivityIndicator IsRunning="{Binding IsLoadingModifiers}" Color="#E11D48" WidthRequest="20" HeightRequest="20" />
                                <Label Text="Loading options…" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <CollectionView ItemsSource="{Binding ModalModifierGroups}"
                                            SelectionMode="None"
                                            IsVisible="{Binding IsLoadingModifiers, Converter={StaticResource InvertedBoolConverter}}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModifierGroupItem">
                                        <VerticalStackLayout Spacing="8" Margin="0,0,0,10">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       TextColor="#0F172A" />
                                                <Label Text="{Binding RequirementLabel}"
                                                       FontSize="11"
                                                       TextColor="#E11D48"
                                                       FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                            <CollectionView ItemsSource="{Binding Options}" SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ModifierOptionItem">
                                                        <Border Stroke="#E2E8F0"
                                                                StrokeThickness="1"
                                                                BackgroundColor="White"
                                                                Padding="10,8"
                                                                Margin="0,0,0,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="10" />
                                                            </Border.StrokeShape>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectModalOptionCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Stroke" Value="#E11D48" />
                                                                    <Setter Property="BackgroundColor" Value="#FFF1F2" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <Label Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       TextColor="#1E293B"
                                                                       VerticalOptions="Center" />
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding PriceLabel}"
                                                                       IsVisible="{Binding HasPrice}"
                                                                       FontSize="12"
                                                                       FontAttributes="Bold"
                                                                       TextColor="#E11D48"
                                                                       VerticalOptions="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Label Text="Description &amp; Details"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="#0F172A" />
                            <Label Text="{Binding ModalProduct.Description}"
                                   FontSize="13"
                                   TextColor="#475569"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto,*"
                          Padding="14,10,14,14"
                          ColumnSpacing="10"
                          BackgroundColor="White">
                        <Border Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                Padding="4"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" BackgroundColor="White">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DecreaseDetailQtyCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="−" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding DetailQuantity}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       WidthRequest="20"
                                       HorizontalTextAlignment="Center" />
                                <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" BackgroundColor="White">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IncreaseDetailQtyCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="+" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Border>

                        <Button Grid.Column="1"
                                Text="{Binding ModalTotalLabel, StringFormat='Add / {0}'}"
                                Clicked="OnModalAddToCartClicked"
                                Command="{Binding AddModalToCartCommand}"
                                BackgroundColor="#E11D48"
                                TextColor="White"
                                CornerRadius="12"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="40"
                                Padding="10,0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- 5. COMBO DEAL CUSTOMIZATION BOTTOM SHEET MODAL (ZIndex 110) -->
        <!-- ============================================================ -->
        <Grid IsVisible="{Binding IsComboModalVisible}"
              ZIndex="110"
              BackgroundColor="#99000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseComboModalCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="End"
                    HorizontalOptions="Fill"
                    BackgroundColor="#F8FAFC"
                    StrokeThickness="0"
                    Padding="0"
                    MaximumHeightRequest="680">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28,28,0,0" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Bottom Sheet Top Header -->
                    <VerticalStackLayout Grid.Row="0" BackgroundColor="White" Padding="16,10,16,12" Spacing="6">
                        <!-- Pull Handle -->
                        <BoxView WidthRequest="44"
                                 HeightRequest="5"
                                 CornerRadius="2.5"
                                 Color="#CBD5E1"
                                 HorizontalOptions="Center"
                                 Margin="0,0,0,4" />

                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="6">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="#FEF2F2"
                                            Padding="6,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label Text="COMBO CUSTOMISATION"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#DC2626" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding ComboProduct.Name}"
                                       FontSize="19"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                                <Label Text="{Binding ComboProduct.DealItemsSummary}"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       MaxLines="2" />
                            </VerticalStackLayout>

                            <!-- Close Button -->
                            <Border Grid.Column="1"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeThickness="0"
                                    BackgroundColor="#F1F5F9"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseComboModalCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="✕"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="#475569" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Middle Content: Skeleton Loading or Items List -->
                    <VerticalStackLayout Grid.Row="1"
                                         IsVisible="{Binding IsLoadingComboDeal}"
                                         Padding="24"
                                         Spacing="16"
                                         VerticalOptions="Center">
                        <ActivityIndicator IsRunning="True"
                                           Color="#0F6B4C"
                                           WidthRequest="40"
                                           HeightRequest="40"
                                           HorizontalOptions="Center" />
                        <Label Text="Loading combo flavors &amp; options…"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155"
                               HorizontalOptions="Center" />
                        <Label Text="Fetching fresh ingredients &amp; modifiers from the kitchen"
                               FontSize="12"
                               TextColor="#94A3B8"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="1"
                                IsVisible="{Binding IsLoadingComboDeal, Converter={StaticResource InvertedBoolConverter}}"
                                Padding="16,12">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Customise each item in your combo:"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />

                            <CollectionView ItemsSource="{Binding DealCustomiseItems}"
                                            SelectionMode="None"
                                            BackgroundColor="Transparent">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:DealCustomiseItem">
                                        <Border Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                BackgroundColor="White"
                                                Padding="14"
                                                Margin="0,0,0,12">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#0A000000" Offset="0,2" Radius="4" />
                                            </Border.Shadow>

                                            <VerticalStackLayout Spacing="10">
                                                <!-- Item Header -->
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                                    <Border WidthRequest="32"
                                                            HeightRequest="32"
                                                            StrokeThickness="0"
                                                            BackgroundColor="#E8F5EF"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16" />
                                                        </Border.StrokeShape>
                                                        <Label Text="🍽"
                                                               FontSize="15"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <Label Text="{Binding HeaderTitle}"
                                                               FontAttributes="Bold"
                                                               FontSize="15"
                                                               TextColor="#0F172A" />
                                                        <Label Text="Choose options &amp; add-ons below"
                                                               FontSize="11"
                                                               TextColor="#64748B" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <!-- Modifier Groups -->
                                                <CollectionView ItemsSource="{Binding ModifierGroups}"
                                                                SelectionMode="None"
                                                                BackgroundColor="Transparent">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ModifierGroupItem">
                                                            <VerticalStackLayout Spacing="6" Margin="0,4,0,8">
                                                                <HorizontalStackLayout Spacing="6">
                                                                    <Label Text="{Binding Name}"
                                                                           FontAttributes="Bold"
                                                                           FontSize="13"
                                                                           TextColor="#1E293B" />
                                                                    <Label Text="{Binding RequirementLabel}"
                                                                           FontSize="11"
                                                                           FontAttributes="Bold"
                                                                           TextColor="#DC2626">
                                                                        <Label.Triggers>
                                                                            <DataTrigger TargetType="Label" Binding="{Binding IsRequired}" Value="False">
                                                                                <Setter Property="TextColor" Value="#64748B" />
                                                                            </DataTrigger>
                                                                        </Label.Triggers>
                                                                    </Label>
                                                                </HorizontalStackLayout>

                                                                <!-- Options List -->
                                                                <CollectionView ItemsSource="{Binding Options}"
                                                                                SelectionMode="None"
                                                                                BackgroundColor="Transparent">
                                                                    <CollectionView.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:ModifierOptionItem">
                                                                            <Border Stroke="#E2E8F0"
                                                                                    StrokeThickness="1"
                                                                                    BackgroundColor="#F8FAFC"
                                                                                    Padding="10,8"
                                                                                    Margin="0,0,0,6">
                                                                                <Border.StrokeShape>
                                                                                    <RoundRectangle CornerRadius="10" />
                                                                                </Border.StrokeShape>
                                                                                <Border.GestureRecognizers>
                                                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectComboOptionCommand}"
                                                                                                          CommandParameter="{Binding .}" />
                                                                                </Border.GestureRecognizers>
                                                                                <Border.Triggers>
                                                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Stroke" Value="#0F6B4C" />
                                                                                        <Setter Property="BackgroundColor" Value="#E8F5EF" />
                                                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                                                    </DataTrigger>
                                                                                </Border.Triggers>

                                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                                                    <Border WidthRequest="18"
                                                                                            HeightRequest="18"
                                                                                            Stroke="#CBD5E1"
                                                                                            StrokeThickness="1.5"
                                                                                            BackgroundColor="White"
                                                                                            VerticalOptions="Center">
                                                                                        <Border.StrokeShape>
                                                                                            <RoundRectangle CornerRadius="9" />
                                                                                        </Border.StrokeShape>
                                                                                        <Border.Triggers>
                                                                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                                                                <Setter Property="Stroke" Value="#0F6B4C" />
                                                                                                <Setter Property="BackgroundColor" Value="#0F6B4C" />
                                                                                            </DataTrigger>
                                                                                        </Border.Triggers>
                                                                                        <Label Text="✓"
                                                                                               FontSize="11"
                                                                                               FontAttributes="Bold"
                                                                                               TextColor="White"
                                                                                               HorizontalOptions="Center"
                                                                                               VerticalOptions="Center"
                                                                                               IsVisible="{Binding IsSelected}" />
                                                                                    </Border>

                                                                                    <Label Grid.Column="1"
                                                                                           Text="{Binding Name}"
                                                                                           FontSize="13"
                                                                                           TextColor="#1E293B"
                                                                                           VerticalOptions="Center" />

                                                                                    <Label Grid.Column="2"
                                                                                           Text="{Binding PriceLabel}"
                                                                                           IsVisible="{Binding HasPrice}"
                                                                                           FontSize="12"
                                                                                           FontAttributes="Bold"
                                                                                           TextColor="#0F6B4C"
                                                                                           VerticalOptions="Center" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </CollectionView.ItemTemplate>
                                                                </CollectionView>
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Sticky Bottom Action Bar -->
                    <Border Grid.Row="2"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="16,12">
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,-3" Radius="6" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    BackgroundColor="#F8FAFC"
                                    Padding="4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Button Text="−"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            CornerRadius="10"
                                            Padding="0"
                                            BackgroundColor="#E2E8F0"
                                            TextColor="#0F172A"
                                            FontAttributes="Bold"
                                            Command="{Binding DecreaseComboQtyCommand}" />
                                    <Label Text="{Binding ComboQuantity}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="#0F172A"
                                           VerticalOptions="Center"
                                           WidthRequest="24"
                                           HorizontalTextAlignment="Center" />
                                    <Button Text="+"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            CornerRadius="10"
                                            Padding="0"
                                            BackgroundColor="#E8F5EF"
                                            TextColor="#0F6B4C"
                                            FontAttributes="Bold"
                                            Command="{Binding IncreaseComboQtyCommand}" />
                                </HorizontalStackLayout>
                            </Border>

                            <Button Grid.Column="1"
                                    Text="{Binding ComboTotalLabel, StringFormat='Add Deal to Cart • {0}'}"
                                    HeightRequest="48"
                                    CornerRadius="14"
                                    BackgroundColor="#0F6B4C"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Clicked="OnModalAddToCartClicked"
                                    Command="{Binding AddComboToCartCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- Top-Level Fly-to-Cart Animation Overlay (ZIndex="999", Full-screen dynamic host) -->
        <AbsoluteLayout x:Name="FlyAnimationOverlay"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        ZIndex="999"
                        InputTransparent="True"
                        CascadeInputTransparent="True" />
    </Grid>
</ContentPage>
