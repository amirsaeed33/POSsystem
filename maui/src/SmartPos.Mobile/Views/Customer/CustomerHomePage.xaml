<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             xmlns:helpers="clr-namespace:SmartPos.Mobile.Helpers"
             x:Class="SmartPos.Mobile.Views.Customer.CustomerHomePage"
             x:DataType="vm:CustomerHomeViewModel"
             x:Name="ThisPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource PageBackground}">
        <!-- 1. Branch picker (shown when no branch selected) -->
        <ScrollView IsVisible="{Binding NeedsBranchSelection}">
            <VerticalStackLayout Padding="20,40,20,24" Spacing="16">
                <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" BackgroundColor="{StaticResource PrimaryLight}" HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label Text="🏪" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding BranchPickerTitle}"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding BranchPickerSubtitle}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextSecondary}" />

                <CollectionView ItemsSource="{Binding Branches}" SelectionMode="None" BackgroundColor="Transparent">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Text="No active branches found."
                               TextColor="{StaticResource TextSecondary}"
                               Margin="12"
                               HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:OnlineBranchDto">
                            <Border Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,2" Radius="6" Opacity="0.04" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectBranchCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="48"
                                            HeightRequest="48"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource PrimaryLight}"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="{Binding Initials}"
                                                   FontAttributes="Bold"
                                                   FontSize="20"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding LogoUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasLogo}" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding BusinessTypeLabel}" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        <Label Text="{Binding Address}" IsVisible="{Binding HasAddress}" FontSize="11" TextColor="{StaticResource TextSecondary}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Phone, StringFormat='📞 {0}'}" IsVisible="{Binding HasPhone}" FontSize="11" TextColor="{StaticResource Gray600}" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 2. Storefront Main Page (sticky header + scroll feed) -->
        <Grid IsVisible="{Binding NeedsBranchSelection, Converter={StaticResource InvertedBoolConverter}}"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource PageBackground}">

            <!-- ========================================================= -->
            <!-- 1. STICKY TOP HEADER                                       -->
            <!-- ========================================================= -->
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8"
                  Padding="16,12,16,8"
                  BackgroundColor="{StaticResource PageBackground}"
                  VerticalOptions="Start">

                <!-- Deliver-To / Branch Pill -->
                <Border BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        Padding="10,7"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,4" Radius="12" Opacity="0.05" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangeBranchCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Border WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Image Source="location_pin.png"
                                   WidthRequest="14"
                                   HeightRequest="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding DeliverToHeaderLabel}"
                                   FontSize="9.5"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   CharacterSpacing="0.8"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SelectedBranch.Name, TargetNullValue='Gulberg III Flagship', FallbackValue='Gulberg III Flagship'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center" />
                                <Label Text="▾"
                                       FontSize="11"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Order History shortcut -->
                <Border Grid.Column="1"
                        WidthRequest="42"
                        HeightRequest="42"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,4" Radius="10" Opacity="0.05" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenOrderHistoryCommand}" />
                    </Border.GestureRecognizers>
                    <Grid WidthRequest="42" HeightRequest="42">
                        <Image Source="icon_receipt.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Border WidthRequest="8"
                                HeightRequest="8"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource AccentSaffron}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,8,8,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- SCROLLABLE FEED                                           -->
            <!-- ========================================================= -->
            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsPullRefreshing}"
                         Command="{Binding RefreshHomeCommand}">
                <ScrollView Orientation="Vertical"
                            VerticalScrollBarVisibility="Never"
                            BackgroundColor="{StaticResource PageBackground}">
                    <VerticalStackLayout Spacing="0" Padding="0,0,0,104">

                        <!-- 2. EDITORIAL SEARCH BAR -->
                        <Border Margin="16,4,16,0"
                                HeightRequest="48"
                                BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,6" Radius="16" Opacity="0.05" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="search_icon.png"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Placeholder="{Binding SearchPlaceholder}"
                                       Text="{Binding SearchText, Mode=TwoWay}"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent" />
                                <!-- Clear when has text -->
                                <Border Grid.Column="2"
                                        HeightRequest="30"
                                        MinimumWidthRequest="30"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        Padding="8,0"
                                        IsVisible="{Binding HasSearchText}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="✕"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <!-- Filter when empty -->
                                <Border Grid.Column="2"
                                        HeightRequest="30"
                                        WidthRequest="34"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        IsVisible="{Binding HasSearchText, Converter={StaticResource InvertedBoolConverter}}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleCategorySearchCommand}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="icon_sliders.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 3. LUXURY HERO PROMO BANNER -->
                        <Border Margin="16,14,16,0"
                                StrokeThickness="0"
                                Padding="14"
                                MinimumHeightRequest="168">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,10" Radius="22" Opacity="0.22" />
                            </Border.Shadow>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2A1208" Offset="0.0" />
                                    <GradientStop Color="#8F3006" Offset="0.45" />
                                    <GradientStop Color="#C84B11" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Border BackgroundColor="#33F9E0D2"
                                            StrokeThickness="0"
                                            Padding="8,3"
                                            HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="ROYAL DASTARKHWAN"
                                               FontSize="9.5"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryTint}"
                                               CharacterSpacing="1.2" />
                                    </Border>
                                    <Label Text="{Binding PromoTitle}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           FontFamily="Georgia"
                                           TextColor="{StaticResource White}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2" />
                                    <Label Text="20% off family platters • Fresh from the tandoor"
                                           FontSize="11"
                                           TextColor="{StaticResource PrimaryTint}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                    <Border BackgroundColor="{StaticResource PageBackground}"
                                            StrokeThickness="0"
                                            HeightRequest="34"
                                            Padding="12,0"
                                            HorizontalOptions="Start"
                                            Margin="0,2,0,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OrderNowCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding PromoCtaText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Circular hero image -->
                                <Border Grid.Column="1"
                                        WidthRequest="96"
                                        HeightRequest="96"
                                        Stroke="{StaticResource AccentGold}"
                                        StrokeThickness="2.5"
                                        BackgroundColor="{StaticResource PrimaryDark}"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="48" />
                                    </Border.StrokeShape>
                                    <Image Source="burger_photo.png"
                                           Aspect="AspectFill"
                                           WidthRequest="96"
                                           HeightRequest="96" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 4. HORIZONTAL CATEGORY CHIPS -->
                        <CollectionView ItemsSource="{Binding DisplayCategories}"
                                        Margin="16,16,0,0"
                                        HeightRequest="42"
                                        HorizontalScrollBarVisibility="Never"
                                        SelectionMode="None"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeCategoryDisplayDto">
                                    <Border HeightRequest="38"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            BackgroundColor="{StaticResource CardBackground}"
                                            Padding="14,0"
                                            Margin="0,0,16,0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsMoreButton}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                                                <Setter Property="Stroke" Value="{StaticResource PrimaryBorder}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectHomeCategoryCommand, Source={x:Reference ThisPage}}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMoreButton}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- 5. EXCLUSIVE DEALS & COMBOS -->
                        <VerticalStackLayout Spacing="10"
                                             Margin="0,18,0,0"
                                             IsVisible="{Binding HasDeals}">
                            <Grid ColumnDefinitions="*,Auto" Padding="16,0" ColumnSpacing="8">
                                <Label Text="Exclusive Deals &amp; Combos"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       FontFamily="Georgia"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="See All"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewAllMenuCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <CollectionView ItemsSource="{Binding DealsList}"
                                            HeightRequest="268"
                                            Margin="16,0,0,0"
                                            HorizontalScrollBarVisibility="Never"
                                            SelectionMode="None"
                                            BackgroundColor="Transparent">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:OnlineProductDto">
                                        <Border WidthRequest="255"
                                                BackgroundColor="{StaticResource CardBackground}"
                                                Stroke="{StaticResource BorderSubtle}"
                                                StrokeThickness="1"
                                                Padding="10"
                                                Margin="0,2,16,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,6" Radius="16" Opacity="0.06" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.OpenProductCommand, Source={x:Reference ThisPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="8">
                                                <Grid HeightRequest="118">
                                                    <Border StrokeThickness="0" HeightRequest="118">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="14" />
                                                        </Border.StrokeShape>
                                                        <Image Source="{Binding ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                               Aspect="AspectFill"
                                                               HeightRequest="118"
                                                               BackgroundColor="{StaticResource SurfaceSecondary}" />
                                                    </Border>

                                                    <Border HorizontalOptions="Start"
                                                            VerticalOptions="Start"
                                                            Margin="8"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            StrokeThickness="0"
                                                            Padding="8,3">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding DealDiscountBadge}"
                                                               TextColor="{StaticResource White}"
                                                               FontSize="9"
                                                               FontAttributes="Bold" />
                                                    </Border>

                                                    <Border HorizontalOptions="End"
                                                            VerticalOptions="Start"
                                                            Margin="8"
                                                            WidthRequest="30"
                                                            HeightRequest="30"
                                                            BackgroundColor="#CCFFFFFF"
                                                            StrokeThickness="0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="15" />
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=ToggleFavoriteCommand}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="♡"
                                                               FontSize="14"
                                                               TextColor="{Binding FavoriteStrokeColor}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                </Grid>

                                                <Label Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding DealItemsSummary}"
                                                       FontSize="11.5"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation"
                                                       IsVisible="{Binding HasDealSummary}" />
                                                <Label Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation"
                                                       IsVisible="{Binding HasDealSummary, Converter={StaticResource InvertedBoolConverter}}" />

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                        <Label Text="{Binding PriceDisplay}"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"
                                                               VerticalOptions="Center" />
                                                        <Label Text="{Binding OriginalPriceDisplay}"
                                                               FontSize="11"
                                                               TextColor="{StaticResource TextMuted}"
                                                               TextDecorations="Strikethrough"
                                                               IsVisible="{Binding HasOriginalPrice}"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                    <Border Grid.Column="1"
                                                            WidthRequest="34"
                                                            HeightRequest="34"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            StrokeThickness="0"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10" />
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.OpenProductCommand, Source={x:Reference ThisPage}}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="+"
                                                               FontSize="18"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource White}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- 6. CHEF'S SIGNATURE CLASSICS (2-col preview; fixed height so ScrollView nest doesn't collapse) -->
                        <VerticalStackLayout Spacing="10"
                                             Margin="0,18,0,0"
                                             Padding="16,0"
                                             IsVisible="{Binding HasProducts}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="Chef's Signature Classics"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       FontFamily="Georgia"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="See All"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewAllMenuCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <CollectionView ItemsSource="{Binding Products}"
                                            HeightRequest="460"
                                            SelectionMode="None"
                                            BackgroundColor="Transparent"
                                            VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                                                     Span="2"
                                                     HorizontalItemSpacing="10"
                                                     VerticalItemSpacing="10" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:OnlineProductDto">
                                        <Border BackgroundColor="{StaticResource CardBackground}"
                                                Stroke="{StaticResource BorderSubtle}"
                                                StrokeThickness="1"
                                                Padding="10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,4" Radius="12" Opacity="0.05" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.OpenProductCommand, Source={x:Reference ThisPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="6">
                                                <Grid HeightRequest="96">
                                                    <Border StrokeThickness="0" HeightRequest="96">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="12" />
                                                        </Border.StrokeShape>
                                                        <Image Source="{Binding ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                                                               Aspect="AspectFill"
                                                               HeightRequest="96"
                                                               BackgroundColor="{StaticResource SurfaceSecondary}" />
                                                    </Border>
                                                    <Border HorizontalOptions="Start"
                                                            VerticalOptions="Start"
                                                            Margin="6"
                                                            BackgroundColor="{StaticResource AccentSaffronSoft}"
                                                            StrokeThickness="0"
                                                            Padding="6,2"
                                                            IsVisible="{Binding HasTag}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding DisplayTag}"
                                                               FontSize="8"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource AccentSaffron}"
                                                               MaxLines="1"
                                                               LineBreakMode="TailTruncation" />
                                                    </Border>
                                                </Grid>

                                                <Label Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       HeightRequest="34" />
                                                <Label Text="{Binding CategoryName}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextMuted}"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding PriceDisplay}"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Primary}"
                                                           VerticalOptions="Center" />
                                                    <Border Grid.Column="1"
                                                            WidthRequest="30"
                                                            HeightRequest="30"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            StrokeThickness="0"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="9" />
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.IncreaseCardCommand, Source={x:Reference ThisPage}}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="+"
                                                               FontSize="16"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource White}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- 7. GUEST HOSPITALITY REVIEWS -->
                        <VerticalStackLayout Spacing="10"
                                             Margin="0,20,0,8"
                                             IsVisible="{Binding HasFeedbacks}">
                            <Grid ColumnDefinitions="*,Auto" Padding="16,0" ColumnSpacing="8">
                                <Label Text="Loved by Our Guests"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       FontFamily="Georgia"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding RatingScoreDisplay}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource AccentSaffron}"
                                           VerticalOptions="Center" />
                                    <Label Text="★"
                                           FontSize="13"
                                           TextColor="{StaticResource AccentSaffron}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Text="{Binding TotalReviewsSubtitle}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="16,0,16,0" />

                                            <CollectionView x:Name="FeedbacksCollectionView"
                                            ItemsSource="{Binding Feedbacks}"
                                            HeightRequest="148"
                                            Margin="16,0,0,0"
                                            HorizontalScrollBarVisibility="Never"
                                            SelectionMode="None"
                                            Scrolled="OnFeedbacksScrolled">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerFeedbackDto">
                                        <Border WidthRequest="280"
                                                HeightRequest="136"
                                                BackgroundColor="{StaticResource CardBackground}"
                                                Stroke="{StaticResource BorderSubtle}"
                                                StrokeThickness="1"
                                                Margin="0,2,16,6"
                                                Padding="12,10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,4" Radius="12" Opacity="0.05" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.PauseFeedbackAutoAdvanceCommand, Source={x:Reference ThisPage}}" />
                                            </Border.GestureRecognizers>

                                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                                <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label Text="★" FontSize="12" TextColor="{StaticResource AccentSaffron}" />
                                                    <Label Text="★" FontSize="12" TextColor="{StaticResource AccentSaffron}" />
                                                    <Label Text="★" FontSize="12" TextColor="{StaticResource AccentSaffron}" />
                                                    <Label Text="★" FontSize="12" TextColor="{StaticResource AccentSaffron}" />
                                                    <Label Text="★" FontSize="12" TextColor="{StaticResource AccentSaffron}" />
                                                </HorizontalStackLayout>

                                                <Label Grid.Row="1"
                                                       Text="{Binding DisplayComment}"
                                                       FontSize="11.5"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="3"
                                                       LineHeight="1.2" />

                                                <HorizontalStackLayout Grid.Row="2" Spacing="8" VerticalOptions="Center">
                                                    <Label Text="{Binding CustomerName}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           VerticalOptions="Center"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1" />
                                                    <Border BackgroundColor="{StaticResource AccentSaffronSoft}"
                                                            StrokeThickness="0"
                                                            Padding="8,3"
                                                            VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8" />
                                                        </Border.StrokeShape>
                                                        <Label Text="Verified Diner"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource AccentSaffron}" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>

        <!-- 3. Aljannat sculpted floating bottom nav -->
        <controls:AljannatBottomNavBar x:Name="BottomTabBar"
                                       ActiveTab="Home"
                                       CartCount="{Binding CartCount}"
                                       VerticalOptions="End"
                                       HorizontalOptions="Fill"
                                       ZIndex="40"
                                       IsVisible="{Binding IsAnyModalVisible, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- 4. Single Product Customization Modal -->
        <Grid IsVisible="{Binding IsProductModalVisible}"
              ZIndex="100"
              BackgroundColor="{StaticResource OverlayScrim}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseProductModalCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="16,24"
                    MaximumHeightRequest="600">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Hero -->
                    <Grid HeightRequest="160">
                        <Image Source="{Binding ModalProduct.ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                               Aspect="AspectFill"
                               BackgroundColor="{StaticResource AuthInputBorder}" />
                        <BoxView Color="{StaticResource OverlayDarkSoft}" />
                        <VerticalStackLayout VerticalOptions="End" Padding="16,12" Spacing="4">
                            <Label Text="{Binding ModalProduct.Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                            <Label Text="{Binding ModalProduct.PriceLabel}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StaffHeroLabel}" />
                        </VerticalStackLayout>
                        <Border WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource WhiteOverlayMedium}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseProductModalCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✕"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Scrollable Modifiers List -->
                    <ScrollView Grid.Row="1" Padding="16,12">
                        <VerticalStackLayout Spacing="16">
                            <CollectionView ItemsSource="{Binding ModalModifierGroups}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ModifierGroupItem">
                                        <VerticalStackLayout Spacing="8" Margin="0,0,0,12">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <CollectionView ItemsSource="{Binding Options}" SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ModifierOptionItem">
                                                        <Border Stroke="{StaticResource BorderSubtle}"
                                                                StrokeThickness="1"
                                                                BackgroundColor="{StaticResource CardBackground}"
                                                                Padding="10,8"
                                                                Margin="0,0,0,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="10" />
                                                            </Border.StrokeShape>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectModalOptionCommand}"
                                                                                      CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                                <Border WidthRequest="18"
                                                                        HeightRequest="18"
                                                                        StrokeThickness="1.5"
                                                                        Stroke="{StaticResource Primary}"
                                                                        BackgroundColor="{StaticResource CardBackground}"
                                                                        VerticalOptions="Center">
                                                                    <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="4" />
                                                                    </Border.StrokeShape>
                                                                    <Label Text="✓" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsSelected}" />
                                                                </Border>
                                                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                                                <Label Grid.Column="2" Text="{Binding PriceLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Bottom Bar -->
                    <Border Grid.Row="2"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource PageBackground}"
                                    Padding="4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <controls:AppButton Text="−"
                                                        Variant="QtyDecrease"
                                                        ButtonHeight="34"
                                                        CornerRadius="10"
                                                        Command="{Binding DecreaseDetailQtyCommand}"
                                                        WidthRequest="34" />
                                    <Label Text="{Binding DetailQuantity}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center"
                                           WidthRequest="24"
                                           HorizontalTextAlignment="Center" />
                                    <controls:AppButton Text="+"
                                                        Variant="QtyIncrease"
                                                        ButtonHeight="34"
                                                        CornerRadius="10"
                                                        Command="{Binding IncreaseDetailQtyCommand}"
                                                        WidthRequest="34" />
                                </HorizontalStackLayout>
                            </Border>

                            <controls:AppButton Grid.Column="1"
                                                Text="{Binding ModalTotalLabel, StringFormat='Add to Cart • {0}'}"
                                                Variant="Primary"
                                                ButtonHeight="46"
                                                CornerRadius="12"
                                                Clicked="OnModalAddToCartClicked"
                                                Command="{Binding AddModalToCartCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Combo Deal Multi-Item Customization Modal Sheet -->
        <Grid IsVisible="{Binding IsComboModalVisible}"
              ZIndex="120"
              BackgroundColor="{StaticResource OverlayScrim}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseComboModalCommand}" />
            </Grid.GestureRecognizers>

            <Border VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="14,20"
                    MaximumHeightRequest="640">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowStrong}" Offset="0,8" Radius="16" Opacity="0.25" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Hero Header -->
                    <Grid HeightRequest="160">
                        <Image Source="{Binding ComboProduct.ImageUrl, Converter={StaticResource CachedUriImageSourceConverter}}"
                               Aspect="AspectFill"
                               BackgroundColor="{StaticResource Slate800}" />
                        <BoxView Color="{StaticResource OverlayDarkMedium}" />

                        <!-- Close Button -->
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource WhiteOverlayMedium}"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseComboModalCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✕"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Bottom-left title and meta -->
                        <VerticalStackLayout VerticalOptions="End" Padding="16,12" Spacing="4">
                            <Border BackgroundColor="{StaticResource BadgeRed}"
                                    StrokeThickness="0"
                                    Padding="6,2"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Label Text="COMBO CUSTOMIZATION"
                                       TextColor="{StaticResource White}"
                                       FontSize="9"
                                       FontAttributes="Bold" />
                            </Border>

                            <Label Text="{Binding ComboProduct.Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />

                            <Label Text="{Binding ComboProduct.PriceDisplay, StringFormat='Base Deal Price: {0}'}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StaffHeroLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Scrollable Body for Deal Items & Modifiers -->
                    <Grid Grid.Row="1">
                        <!-- Loading State -->
                        <VerticalStackLayout IsVisible="{Binding IsLoadingComboDeal}"
                                             Spacing="12"
                                             Padding="24"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsLoadingComboDeal}"
                                               Color="{StaticResource PrimaryDark}"
                                               WidthRequest="36"
                                               HeightRequest="36" />
                            <Label Text="Loading combo items &amp; choices…"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Slate650}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Items List -->
                        <ScrollView IsVisible="{Binding IsLoadingComboDeal, Converter={StaticResource InvertedBoolConverter}}"
                                    Padding="16,14">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Customize included items in this combo:"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray600}" />

                                <CollectionView ItemsSource="{Binding DealCustomiseItems}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DealCustomiseItem">
                                            <Border BackgroundColor="{StaticResource CardBackground}"
                                                    Stroke="{StaticResource BorderSubtle}"
                                                    StrokeThickness="1"
                                                    Padding="14"
                                                    Margin="0,0,0,14">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="{StaticResource ShadowSoft}" Offset="0,2" Radius="6" Opacity="0.05" />
                                                </Border.Shadow>

                                                <VerticalStackLayout Spacing="10">
                                                    <!-- Item Top Bar: Step + Icon + Name + Status Badge -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                        <Border WidthRequest="36"
                                                                HeightRequest="36"
                                                                StrokeThickness="0"
                                                                BackgroundColor="{StaticResource Gray100}"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="18" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding FoodIcon}"
                                                                   FontSize="18"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                            <Label Text="{Binding StepLabel}"
                                                                   FontSize="10"
                                                                   TextColor="{StaticResource TextSecondary}" />
                                                            <Label Text="{Binding HeaderTitle}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   MaxLines="1"
                                                                   LineBreakMode="TailTruncation" />
                                                        </VerticalStackLayout>

                                                        <!-- Ready / Choice Required Badge -->
                                                        <Border Grid.Column="2"
                                                                BackgroundColor="{Binding StatusBadgeBgColor}"
                                                                StrokeThickness="0"
                                                                Padding="8,4"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding StatusBadgeText}"
                                                                   TextColor="{Binding StatusBadgeTextColor}"
                                                                   FontSize="10"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center" />
                                                        </Border>
                                                    </Grid>

                                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                                                    <!-- Modifier Groups for this Item -->
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ModifierGroups}"
                                                                         Spacing="10">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ModifierGroupItem">
                                                                <VerticalStackLayout Spacing="6">
                                                                    <!-- Group Header -->
                                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                                        <Label Text="{Binding Name}"
                                                                               FontSize="13"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{StaticResource Slate650}"
                                                                               VerticalOptions="Center" />

                                                                        <Label Grid.Column="1"
                                                                               Text="{Binding SelectionRuleHint}"
                                                                               FontSize="11"
                                                                               TextColor="{StaticResource Gray400}"
                                                                               VerticalOptions="Center" />

                                                                        <Border Grid.Column="2"
                                                                                BackgroundColor="{Binding RequirementBgColor}"
                                                                                StrokeThickness="0"
                                                                                Padding="6,2"
                                                                                VerticalOptions="Center">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="6" />
                                                                            </Border.StrokeShape>
                                                                            <Label Text="{Binding RequirementBadgeText}"
                                                                                   TextColor="{Binding RequirementTextColor}"
                                                                                   FontSize="9"
                                                                                   FontAttributes="Bold" />
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- Options List -->
                                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}"
                                                                                         Spacing="6">
                                                                        <BindableLayout.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:ModifierOptionItem">
                                                                                <Border Stroke="{Binding CardBorderColor}"
                                                                                        StrokeThickness="{Binding CardStrokeThickness}"
                                                                                        BackgroundColor="{Binding CardBgColor}"
                                                                                        Padding="10,8">
                                                                                    <Border.StrokeShape>
                                                                                        <RoundRectangle CornerRadius="10" />
                                                                                    </Border.StrokeShape>
                                                                                    <Border.GestureRecognizers>
                                                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerHomeViewModel}}, Path=SelectComboOptionCommand}"
                                                                                                              CommandParameter="{Binding .}" />
                                                                                    </Border.GestureRecognizers>
                                                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                                                        <!-- Radio / Check Indicator -->
                                                                                        <Border WidthRequest="20"
                                                                                                HeightRequest="20"
                                                                                                Stroke="{Binding RadioBorderColor}"
                                                                                                StrokeThickness="1.5"
                                                                                                BackgroundColor="{Binding CheckmarkBg}"
                                                                                                VerticalOptions="Center">
                                                                                            <Border.StrokeShape>
                                                                                                <RoundRectangle CornerRadius="10" />
                                                                                            </Border.StrokeShape>
                                                                                            <Label Text="{Binding CheckmarkGlyph}"
                                                                                                   TextColor="{Binding CheckmarkColor}"
                                                                                                   FontSize="11"
                                                                                                   FontAttributes="Bold"
                                                                                                   HorizontalOptions="Center"
                                                                                                   VerticalOptions="Center" />
                                                                                        </Border>

                                                                                        <!-- Option Name -->
                                                                                        <Label Grid.Column="1"
                                                                                               Text="{Binding Name}"
                                                                                               FontSize="13"
                                                                                               TextColor="{Binding TextColor}"
                                                                                               VerticalOptions="Center" />

                                                                                        <!-- Price Delta -->
                                                                                        <Label Grid.Column="2"
                                                                                               Text="{Binding PriceLabel}"
                                                                                               FontSize="12"
                                                                                               FontAttributes="Bold"
                                                                                               TextColor="{StaticResource PrimaryDark}"
                                                                                               VerticalOptions="Center" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </BindableLayout.ItemTemplate>
                                                                    </VerticalStackLayout>
                                                                </VerticalStackLayout>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- Sticky Bottom Bar -->
                    <Border Grid.Row="2"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderSubtle}"
                            StrokeThickness="1"
                            Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,0,24,24" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <!-- Validation warning alert (if options missing) -->
                            <Border IsVisible="{Binding HasComboValidationMessage}"
                                    BackgroundColor="{StaticResource DangerBackgroundSoft}"
                                    Stroke="{StaticResource DangerBackground}"
                                    StrokeThickness="1"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="⚠️" FontSize="11" VerticalOptions="Center" />
                                    <Label Text="{Binding ComboValidationMessage}"
                                           FontSize="11"
                                           TextColor="{StaticResource BadgeRed}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Quantity Stepper -->
                                <Border Stroke="{StaticResource BorderSubtle}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource PageBackground}"
                                        Padding="4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <controls:AppButton Text="−"
                                                            Variant="QtyDecrease"
                                                            ButtonHeight="34"
                                                            CornerRadius="10"
                                                            Command="{Binding DecreaseComboQtyCommand}"
                                                            WidthRequest="34" />
                                        <Label Text="{Binding ComboQuantity}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center"
                                               WidthRequest="24"
                                               HorizontalTextAlignment="Center" />
                                        <controls:AppButton Text="+"
                                                            Variant="QtyIncrease"
                                                            ButtonHeight="34"
                                                            CornerRadius="10"
                                                            Command="{Binding IncreaseComboQtyCommand}"
                                                            WidthRequest="34" />
                                    </HorizontalStackLayout>
                                </Border>

                                <controls:AppButton Grid.Column="1"
                                                    Text="{Binding ComboTotalLabel, StringFormat='Add Deal to Cart • {0}'}"
                                                    Variant="StaffPrimary"
                                                    ButtonHeight="46"
                                                    CornerRadius="12"
                                                    Clicked="OnModalAddToCartClicked"
                                                    Command="{Binding AddComboToCartCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 6. Top-Level Fly-to-Cart Animation Overlay -->
        <AbsoluteLayout x:Name="FlyAnimationOverlay"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        ZIndex="999"
                        InputTransparent="True"
                        CascadeInputTransparent="True" />

        <!-- 7. Tab-Switching Global Loading Overlay -->
        <controls:TabLoadingOverlay />
    </Grid>
</ContentPage>
