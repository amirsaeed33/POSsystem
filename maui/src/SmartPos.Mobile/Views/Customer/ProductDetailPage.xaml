<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             x:Class="SmartPos.Mobile.Views.Customer.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Image Source="{Binding ImageUrl}" HeightRequest="220" Aspect="AspectFill" BackgroundColor="#E7EEE9" />
            <Label Text="{Binding Product.Name}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Product.PriceText}" FontSize="20" TextColor="#0F6B4C" />
            <Label Text="{Binding Product.Description}" TextColor="#5C6B63" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="-" Command="{Binding DecreaseCommand}" WidthRequest="48" />
                <Label Text="{Binding Quantity}" VerticalOptions="Center" FontSize="18" />
                <Button Text="+" Command="{Binding IncreaseCommand}" WidthRequest="48" />
            </HorizontalStackLayout>
            <Button Text="Add to cart" Command="{Binding AddToCartCommand}" BackgroundColor="#0F6B4C" TextColor="White" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
