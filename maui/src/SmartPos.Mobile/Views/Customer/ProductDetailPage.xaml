<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             x:Class="SmartPos.Mobile.Views.Customer.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="*, Auto" BackgroundColor="{StaticResource PageBackground}">

        <!-- Scrollable Content Area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,24">

                <!-- ========================================================= -->
                <!-- 1. HERO PRODUCT IMAGE & FLOATING BUTTONS                  -->
                <!-- ========================================================= -->
                <Grid HeightRequest="280">
                    <!-- Image Background Container -->
                    <Border StrokeThickness="0" BackgroundColor="{StaticResource Gray100}">
                        <Grid>
                            <!-- Fallback Icon -->
                            <Label Text="🍔"
                                   FontSize="64"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <!-- Product Photo -->
                            <Image Source="{Binding ImageUrl}"
                                   Aspect="AspectFill"
                                   HeightRequest="280"
                                   HorizontalOptions="Fill" />
                        </Grid>
                    </Border>

                    <!-- Top Dark Gradient Overlay for button contrast -->
                    <BoxView HeightRequest="80"
                             VerticalOptions="Start"
                             Color="#33000000" />

                    <!-- Floating Back Button (Top-Left) -->
                    <Border WidthRequest="40"
                            HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="#E6FFFFFF"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="18,44,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.12" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="‹"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,-3,0,0" />
                    </Border>

                    <!-- Floating Action Buttons (Top-Right: Share & Favorite) -->
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           Margin="0,44,18,0">
                        <!-- Share Button -->
                        <Border WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                BackgroundColor="#E6FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.12" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="🔗"
                                   FontSize="15"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Heart / Favorite Button -->
                        <Border WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                BackgroundColor="#E6FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1A000000" Offset="0,2" Radius="6" Opacity="0.12" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding FavoriteGlyph}"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- ========================================================= -->
                <!-- 2. PRODUCT DETAILS CARD                                   -->
                <!-- ========================================================= -->
                <Border Margin="16,0,16,0"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        Padding="18,18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">

                        <!-- Category & Stock Status Row -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <!-- Category Badge -->
                            <Border StrokeThickness="0"
                                    BackgroundColor="{StaticResource Gray100}"
                                    Padding="10,4"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding CategoryName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>

                            <!-- In Stock Badge -->
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding StockBadgeBg}"
                                    Padding="10,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding StockBadgeText}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{Binding StockBadgeTextColor}" />
                            </Border>
                        </Grid>

                        <!-- Product Title -->
                        <Label Text="{Binding ProductName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <!-- Pricing Row -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding BasePriceDisplay}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding OriginalPriceDisplay}"
                                   FontSize="14"
                                   TextDecorations="Strikethrough"
                                   TextColor="{StaticResource Gray400}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding HasDiscount}" />
                            <Border StrokeThickness="0"
                                    BackgroundColor="{StaticResource BadgeRed}"
                                    Padding="8,2"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasDiscount}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding DiscountBadgeText}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Description -->
                        <Label Text="{Binding Description}"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap"
                               Margin="0,2,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- 3. MODIFIER GROUPS (CUSTOMIZATION)                        -->
                <!-- ========================================================= -->
                <VerticalStackLayout Spacing="16"
                                     Margin="16,0,16,0"
                                     IsVisible="{Binding HasModifiers}"
                                     BindableLayout.ItemsSource="{Binding ModifierGroups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ModifierGroupItem">
                            <Border Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="16,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="12">
                                    <!-- Group Header -->
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding SelectionRuleHint}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>

                                        <!-- Requirement Badge -->
                                        <Border Grid.Column="1"
                                                StrokeThickness="0"
                                                BackgroundColor="{Binding RequirementBgColor}"
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding RequirementBadgeText}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding RequirementTextColor}" />
                                        </Border>
                                    </Grid>

                                    <!-- Options List -->
                                    <VerticalStackLayout Spacing="8"
                                                         BindableLayout.ItemsSource="{Binding Options}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ModifierOptionItem">
                                                <Border Stroke="{Binding CardBorderColor}"
                                                        StrokeThickness="{Binding CardStrokeThickness}"
                                                        BackgroundColor="{Binding CardBgColor}"
                                                        Padding="12,10">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductDetailViewModel}}, Path=ToggleOptionCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                        <!-- Radio / Check Indicator -->
                                                        <Border Grid.Column="0"
                                                                WidthRequest="22"
                                                                HeightRequest="22"
                                                                Stroke="{Binding RadioBorderColor}"
                                                                StrokeThickness="1.5"
                                                                BackgroundColor="{Binding CheckmarkBg}"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="11" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding CheckmarkGlyph}"
                                                                   TextColor="{Binding CheckmarkColor}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>

                                                        <!-- Option Name -->
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding TextColor}"
                                                               VerticalOptions="Center" />

                                                        <!-- Price Tag -->
                                                        <Label Grid.Column="2"
                                                               Text="{Binding PriceLabel}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ========================================================= -->
                <!-- 4. SPECIAL INSTRUCTIONS CARD                              -->
                <!-- ========================================================= -->
                <Border Margin="16,0,16,0"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource CardBackground}"
                        Padding="16,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Special Instructions"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Any specific cooking note or dietary requirement?"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource PageBackground}"
                                Padding="12,8"
                                Margin="0,4,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding SpecialInstructions}"
                                   Placeholder="e.g. Less spicy, no onions, extra napkins..."
                                   FontSize="13"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ========================================================= -->
        <!-- 5. STICKY BOTTOM ACTION BAR                               -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1"
                Padding="16,12">
            <Border.Shadow>
                <Shadow Brush="#10000000" Offset="0,-3" Radius="8" Opacity="0.06" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Quantity Stepper -->
                <Border Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource PageBackground}"
                        Padding="4"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Button Text="−"
                                WidthRequest="36"
                                HeightRequest="36"
                                CornerRadius="10"
                                Padding="0"
                                BackgroundColor="{StaticResource BorderSubtle}"
                                TextColor="{StaticResource TextPrimary}"
                                FontAttributes="Bold"
                                FontSize="16"
                                Command="{Binding DecreaseCommand}" />
                        <Label Text="{Binding Quantity}"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"
                               WidthRequest="28"
                               HorizontalTextAlignment="Center" />
                        <Button Text="+"
                                WidthRequest="36"
                                HeightRequest="36"
                                CornerRadius="10"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                TextColor="{StaticResource PrimaryDark}"
                                FontAttributes="Bold"
                                FontSize="16"
                                Command="{Binding IncreaseCommand}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Add to Cart Dynamic Button -->
                <Button Grid.Column="1"
                        Text="{Binding TotalButtonText}"
                        Command="{Binding AddToCartCommand}"
                        HeightRequest="48"
                        CornerRadius="14"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
