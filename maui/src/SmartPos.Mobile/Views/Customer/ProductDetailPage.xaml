<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             x:Class="SmartPos.Mobile.Views.Customer.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             x:Name="ThisPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{StaticResource PageBackground}">

        <!-- ========================================================= -->
        <!-- ROW 0 — SCROLLABLE HERO + EDITORIAL SHEET                   -->
        <!-- ========================================================= -->
        <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

                <!-- HERO 295 -->
                <Grid HeightRequest="295">
                    <Border StrokeThickness="0"
                            BackgroundColor="{StaticResource SurfaceSecondary}">
                        <Image Source="{Binding ProductImage, Converter={StaticResource CachedUriImageSourceConverter}}"
                               Aspect="AspectFill"
                               HeightRequest="295"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                    </Border>

                    <BoxView InputTransparent="True" ZIndex="1">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#8F1C1410" Offset="0" />
                                <GradientStop Color="#101C1410" Offset="0.5" />
                                <GradientStop Color="#B81C1410" Offset="1" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Floating top actions -->
                    <Grid Margin="16,16,16,0"
                          VerticalOptions="Start"
                          ZIndex="20"
                          ColumnDefinitions="Auto,*,Auto">
                        <Border WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="#8C1C1410"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="←"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Border Grid.Column="2"
                                WidthRequest="42"
                                HeightRequest="42"
                                BackgroundColor="#EBFFFFFF"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1"
                                HorizontalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding FavoriteGlyph}"
                                   FontSize="20"
                                   TextColor="{Binding FavoriteGlyphColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Floating bottom pills -->
                    <Grid Margin="16,0,16,36"
                          VerticalOptions="End"
                          ZIndex="20"
                          ColumnDefinitions="Auto,*,Auto">
                        <Border BackgroundColor="#BF1C1410"
                                StrokeThickness="0"
                                Padding="12,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding RatingDisplay}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentSaffron}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding RatingMetaDisplay}"
                                       FontSize="11"
                                       TextColor="#F5EFEA"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="2"
                                BackgroundColor="#BF1C1410"
                                StrokeThickness="0"
                                Padding="12,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label Text="{Binding PrepTimeDisplay}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- OVERLAPPING EDITORIAL SHEET -->
                <Border Margin="0,-24,0,0"
                        BackgroundColor="{StaticResource PageBackground}"
                        StrokeThickness="0"
                        Padding="16,20,16,28">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28,28,0,0" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="0">

                        <!-- Badges -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border BackgroundColor="{StaticResource PrimaryLight}"
                                    Stroke="{StaticResource PrimaryBorder}"
                                    StrokeThickness="1"
                                    Padding="10,5"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding CategoryBadgeText}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"
                                       TextColor="{StaticResource Primary}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding StockBadgeBg}"
                                    Stroke="{Binding StockBadgeStroke}"
                                    StrokeThickness="1"
                                    Padding="10,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding StockBadgeText}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{Binding StockBadgeTextColor}" />
                            </Border>
                        </Grid>

                        <!-- Title -->
                        <Label Text="{Binding ProductName}"
                               FontSize="25"
                               FontAttributes="Bold"
                               FontFamily="Georgia"
                               TextColor="{StaticResource TextPrimary}"
                               Margin="0,12,0,0"
                               LineBreakMode="WordWrap" />

                        <!-- Price -->
                        <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">
                            <Label Text="{Binding BasePriceDisplay}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding OriginalPriceDisplay}"
                                   FontSize="14"
                                   TextDecorations="Strikethrough"
                                   TextColor="{StaticResource TextMuted}"
                                   IsVisible="{Binding HasDiscount}"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    Padding="8,4"
                                    IsVisible="{Binding HasDiscount}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding SavingsDisplay}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Description -->
                        <Label Text="{Binding Description}"
                               FontSize="13.5"
                               LineHeight="1.35"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,10,0,0"
                               LineBreakMode="WordWrap" />

                        <!-- Sensory pills -->
                        <FlexLayout Direction="Row"
                                    Wrap="Wrap"
                                    Margin="0,12,0,0">
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    Padding="10,6"
                                    Margin="0,0,6,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="Serves 2–3"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    Padding="10,6"
                                    Margin="0,0,6,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="Freshly Prepared"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>
                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    Padding="10,6"
                                    Margin="0,0,6,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="Chef Signature"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>
                        </FlexLayout>

                        <!-- ================================================= -->
                        <!-- SECTION 1 — PORTION / MEAL OPTION                  -->
                        <!-- ================================================= -->
                        <VerticalStackLayout Spacing="10" Margin="0,22,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Portion / Meal Option"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           FontFamily="Georgia"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Choose your serving style for the dastarkhwan"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        Padding="8,3"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Label Text="REQUIRED"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding PortionOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductDetailChoiceItem">
                                        <Border BackgroundColor="{Binding CardBgColor}"
                                                Stroke="{Binding CardBorderColor}"
                                                StrokeThickness="{Binding CardStrokeThickness}"
                                                Padding="14">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.SelectPortionCommand, Source={x:Reference ThisPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border WidthRequest="22"
                                                        HeightRequest="22"
                                                        Stroke="{Binding RadioBorderColor}"
                                                        StrokeThickness="1.5"
                                                        BackgroundColor="{Binding RadioFillColor}"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="11" />
                                                    </Border.StrokeShape>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding TitleColor}"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Subtitle}"
                                                           FontSize="11"
                                                           TextColor="{Binding SubtitleColor}"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation"
                                                           IsVisible="{Binding HasSubtitle}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2"
                                                       Text="{Binding PriceLabel}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding PriceColor}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- ================================================= -->
                        <!-- SECTION 2 — SPICE & CHAR PROFILE (3-COL CARDS)     -->
                        <!-- ================================================= -->
                        <VerticalStackLayout Spacing="10" Margin="0,22,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Spice &amp; Char Profile"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           FontFamily="Georgia"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Calibrated by our kitchen master"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeThickness="0"
                                        Padding="8,3"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Label Text="REQUIRED"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}" />
                                </Border>
                            </Grid>

                            <CollectionView ItemsSource="{Binding SpiceOptions}"
                                            SelectionMode="None"
                                            HeightRequest="78">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                                                     Span="3"
                                                     HorizontalItemSpacing="8"
                                                     VerticalItemSpacing="0" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductDetailChoiceItem">
                                        <Border BackgroundColor="{Binding CardBgColor}"
                                                Stroke="{Binding CardBorderColor}"
                                                StrokeThickness="{Binding CardStrokeThickness}"
                                                Padding="8,10"
                                                HeightRequest="72">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.SelectSpiceCommand, Source={x:Reference ThisPage}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TitleColor}"
                                                       HorizontalTextAlignment="Center"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}"
                                                       FontSize="9.5"
                                                       TextColor="{Binding SubtitleColor}"
                                                       HorizontalTextAlignment="Center"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- ================================================= -->
                        <!-- SECTION 3 — DASTARKHWAN ADD-ONS                    -->
                        <!-- ================================================= -->
                        <VerticalStackLayout Spacing="10" Margin="0,22,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Dastarkhwan Add-Ons"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           FontFamily="Georgia"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Pair fresh breads, sides &amp; extras"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource SurfaceSecondary}"
                                        Stroke="{StaticResource BorderSubtle}"
                                        StrokeThickness="1"
                                        Padding="8,3"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Label Text="OPTIONAL"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>

                            <Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource BorderSubtle}"
                                    StrokeThickness="1"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding AddonOptions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProductDetailChoiceItem">
                                            <VerticalStackLayout Spacing="0">
                                                <Border BackgroundColor="{Binding RowBgColor}"
                                                        StrokeThickness="0"
                                                        Padding="14,12">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding BindingContext.ToggleAddonCommand, Source={x:Reference ThisPage}}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                        <Border WidthRequest="20"
                                                                HeightRequest="20"
                                                                Stroke="{Binding CardBorderColor}"
                                                                StrokeThickness="1.5"
                                                                BackgroundColor="{Binding CheckBgColor}"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding CheckGlyph}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource White}"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding TitleColor}"
                                                               VerticalOptions="Center"
                                                               MaxLines="2"
                                                               LineBreakMode="TailTruncation" />
                                                        <Label Grid.Column="2"
                                                               Text="{Binding PriceLabel}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding PriceColor}"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                                <BoxView HeightRequest="1"
                                                         Color="{StaticResource BorderSubtle}"
                                                         Margin="14,0" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ================================================= -->
                        <!-- SECTION 4 — SPECIAL KITCHEN INSTRUCTIONS           -->
                        <!-- ================================================= -->
                        <Border BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeThickness="1"
                                Padding="14"
                                Margin="0,22,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Special Kitchen Instructions"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       FontFamily="Georgia"
                                       TextColor="{StaticResource TextPrimary}" />

                                <FlexLayout Direction="Row" Wrap="Wrap">
                                    <Border BackgroundColor="{StaticResource PageBackground}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            Padding="10,6"
                                            Margin="0,0,6,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AppendInstructionCommand}"
                                                                  CommandParameter="Extra Sauce / Ginger" />
                                        </Border.GestureRecognizers>
                                        <Label Text="+ Extra Sauce / Ginger"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource PageBackground}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            Padding="10,6"
                                            Margin="0,0,6,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AppendInstructionCommand}"
                                                                  CommandParameter="Less Oil" />
                                        </Border.GestureRecognizers>
                                        <Label Text="+ Less Oil"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource PageBackground}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeThickness="1"
                                            Padding="10,6"
                                            Margin="0,0,6,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AppendInstructionCommand}"
                                                                  CommandParameter="Pack Separate" />
                                        </Border.GestureRecognizers>
                                        <Label Text="+ Pack Separate"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </Border>
                                </FlexLayout>

                                <Border BackgroundColor="{StaticResource PageBackground}"
                                        Stroke="{StaticResource BorderSubtle}"
                                        StrokeThickness="1"
                                        Padding="12,8"
                                        HeightRequest="76">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Editor Text="{Binding SpecialInstructions}"
                                            Placeholder="e.g. Well-done charcoal char, extra lemon wedges..."
                                            FontSize="13"
                                            TextColor="{StaticResource TextPrimary}"
                                            PlaceholderColor="{StaticResource TextMuted}"
                                            BackgroundColor="Transparent"
                                            AutoSize="Disabled" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ========================================================= -->
        <!-- ROW 1 — STICKY CONVERSION DOCK (never scrolls)             -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                ZIndex="50"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1"
                Padding="16,12,16,22"
                VerticalOptions="End">
            <Border.Shadow>
                <Shadow Brush="#1A000000" Offset="0,-4" Radius="14" Opacity="0.10" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border HeightRequest="50"
                        BackgroundColor="{StaticResource SurfaceSecondary}"
                        Stroke="{StaticResource BorderSubtle}"
                        StrokeThickness="1"
                        Padding="8,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="{StaticResource White}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DecreaseCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="−"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding QuantityText}"
                               WidthRequest="28"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IncreaseCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="+"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        HeightRequest="50"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        Padding="14,0"
                        IsEnabled="{Binding CanAddToCart}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding IsSoldOut}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource BadgeRed}" />
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddToCartCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding TotalButtonText}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
