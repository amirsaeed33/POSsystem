<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Customer.CartPage"
             x:DataType="vm:CartCheckoutViewModel"
             Title="Cart"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <Grid BackgroundColor="#F5F5F5">
        <Grid RowDefinitions="*,Auto"
              BackgroundColor="#F5F5F5">
            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,20" Spacing="14">

                    <!-- Page title -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="#E7F5EF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Image Source="icon_cart_bag.png"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Your cart"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#1F2A24" />
                            <Label Text="{Binding ItemCountLabel}"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Empty state -->
                    <Border IsVisible="{Binding IsEmpty}"
                            Stroke="#E2E8E4"
                            StrokeThickness="1"
                            BackgroundColor="#FAFBFA"
                            Padding="28,32">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Border WidthRequest="72"
                                    HeightRequest="72"
                                    StrokeThickness="0"
                                    BackgroundColor="#E7F5EF"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="36" />
                                </Border.StrokeShape>
                                <Image Source="icon_cart_bag.png"
                                       WidthRequest="34"
                                       HeightRequest="34"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Your cart is empty"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1F2A24"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Add items from the menu, then come back to checkout."
                                   FontSize="13"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Free Delivery Progress Card -->
                    <Border IsVisible="{Binding HasItems}"
                            StrokeThickness="1.5"
                            Padding="14,12"
                            Margin="0,0,0,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFreeDeliveryUnlocked}" Value="True">
                                <Setter Property="Stroke" Value="#10B981" />
                                <Setter Property="BackgroundColor" Value="#ECFDF5" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFreeDeliveryUnlocked}" Value="False">
                                <Setter Property="Stroke" Value="#E2E8F0" />
                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="🎉" FontSize="22" VerticalOptions="Center" IsVisible="{Binding IsFreeDeliveryUnlocked}" />
                                <Label Text="🚚" FontSize="22" VerticalOptions="Center" IsVisible="{Binding IsFreeDeliveryLocked}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding FreeDeliveryMotivationText}"
                                           FontSize="13"
                                           FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="True">
                                                <Setter Property="TextColor" Value="#065F46" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="False">
                                                <Setter Property="TextColor" Value="#1E293B" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="Free delivery unlocked for your order!"
                                           FontSize="11"
                                           TextColor="#059669"
                                           IsVisible="{Binding IsFreeDeliveryUnlocked}" />
                                    <Label Text="{Binding FreeDeliveryThreshold, StringFormat='Orders over PKR {0:N0} qualify'}"
                                           FontSize="11"
                                           TextColor="#64748B"
                                           IsVisible="{Binding IsFreeDeliveryLocked}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        BackgroundColor="#D1FAE5"
                                        StrokeThickness="0"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsFreeDeliveryUnlocked}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="FREE"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#059669" />
                                </Border>
                            </Grid>

                            <!-- Progress Bar (shown when not yet unlocked) -->
                            <ProgressBar Progress="{Binding FreeDeliveryProgress}"
                                         ProgressColor="#0F6B4C"
                                         BackgroundColor="#E2E8F0"
                                         HeightRequest="6"
                                         IsVisible="{Binding IsFreeDeliveryLocked}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cart lines -->
                    <CollectionView ItemsSource="{Binding Lines}"
                                    IsVisible="{Binding HasItems}"
                                    HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartLine">
                                <Border Stroke="#E8ECEA"
                                        StrokeThickness="1"
                                        BackgroundColor="#FAFBFA"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#1F2A24" />
                                            <Label Text="{Binding SelectedModifiers}"
                                                   IsVisible="{Binding HasModifiers}"
                                                   TextColor="#0F6B4C"
                                                   FontSize="11"
                                                   MaxLines="3"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding UnitPriceText, StringFormat='PKR {0}'}" TextColor="#5C6B63" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="-"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                CornerRadius="12"
                                                BackgroundColor="#EEF2F0"
                                                TextColor="#1F2A24"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=DecreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Label Grid.Column="2"
                                                Text="{Binding Quantity}"
                                                VerticalOptions="Center"
                                                FontAttributes="Bold"
                                                WidthRequest="24"
                                                HorizontalTextAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Text="+"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0"
                                                CornerRadius="12"
                                                BackgroundColor="#E7F5EF"
                                                TextColor="#0F6B4C"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=IncreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Delivery section title -->
                    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                        <Image Source="icon_pin.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Text="Delivery area"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1F2A24"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Choose where this order should be delivered"
                           FontSize="12"
                           TextColor="#64748B"
                           Margin="28,0,0,0" />

                    <Border Stroke="#E2E8E4" StrokeThickness="1" BackgroundColor="White" Padding="4,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Picker Title="Select delivery area"
                                ItemsSource="{Binding Areas}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedArea}" />
                    </Border>

                    <!-- Contact -->
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Image Source="icon_person.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Text="Your details" FontAttributes="Bold" FontSize="15" TextColor="#1F2A24" />
                    </HorizontalStackLayout>
                    <Border Stroke="#E2E8E4" StrokeThickness="1.5" BackgroundColor="White" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding NameInvalid}" Value="True">
                                <Setter Property="Stroke" Value="#EF4444" />
                                <Setter Property="BackgroundColor" Value="#FEF2F2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_person.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Your name" Text="{Binding CustomerName}" />
                        </Grid>
                    </Border>
                    <Border Stroke="#E2E8E4" StrokeThickness="1.5" BackgroundColor="White" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding MobileInvalid}" Value="True">
                                <Setter Property="Stroke" Value="#EF4444" />
                                <Setter Property="BackgroundColor" Value="#FEF2F2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_phone.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Mobile (e.g. 03001234567)" Text="{Binding CustomerMobile}" Keyboard="Telephone" />
                        </Grid>
                    </Border>

                    <!-- Saved Addresses Quick-Pick Section -->
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding HasSavedAddresses}">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="Saved Addresses"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1F2A24"
                                       VerticalOptions="Center" />
                                <Border BackgroundColor="#E7F5EF" StrokeThickness="0" Padding="8,2" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding SavedAddresses.Count, StringFormat='{0} saved'}"
                                           FontSize="11"
                                           TextColor="#0F6B4C"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Button Grid.Column="1"
                                    Text="➕ New Address"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#0F6B4C"
                                    BackgroundColor="Transparent"
                                    Padding="4,0"
                                    HeightRequest="32"
                                    Command="{Binding SwitchToNewAddressCommand}" />
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SavedAddresses}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerSavedAddressDto">
                                        <Border StrokeThickness="1.5"
                                                BackgroundColor="White"
                                                Padding="12,10"
                                                WidthRequest="210">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=SelectSavedAddressCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="#0F6B4C" />
                                                    <Setter Property="BackgroundColor" Value="#F0FDF4" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="Stroke" Value="#E2E8E4" />
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="4" ColumnSpacing="6">
                                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding DisplayIcon}" FontSize="16" VerticalOptions="Center" />
                                                <Label Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding DisplayLabel}"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       TextColor="#1F2A24"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                                <Button Grid.Row="0" Grid.Column="2"
                                                        Text="🗑"
                                                        FontSize="12"
                                                        TextColor="#EF4444"
                                                        BackgroundColor="Transparent"
                                                        Padding="0"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        CornerRadius="14"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=DeleteSavedAddressCommand}"
                                                        CommandParameter="{Binding .}" />

                                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding AddressPreview}"
                                                       FontSize="11"
                                                       TextColor="#64748B"
                                                       LineBreakMode="TailTruncation" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Active Saved Address Notification / Switch Pill -->
                    <Border Stroke="#0F6B4C"
                            StrokeThickness="1"
                            BackgroundColor="#E7F5EF"
                            Padding="12,10"
                            IsVisible="{Binding HasSelectedSavedAddress}"
                            Margin="0,2,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="{Binding SelectedSavedAddress.DisplayIcon}" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SelectedSavedAddress.DisplayLabel, StringFormat='Using saved address: {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="#0F6B4C" />
                                <Label Text="{Binding SelectedSavedAddress.FullAddressDisplay}"
                                       FontSize="11"
                                       TextColor="#2D3748"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Change"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="#0F6B4C"
                                    BackgroundColor="#FFFFFF"
                                    CornerRadius="10"
                                    Padding="10,0"
                                    HeightRequest="28"
                                    Command="{Binding SwitchToNewAddressCommand}" />
                        </Grid>
                    </Border>

                    <!-- Address -->
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Image Source="icon_home_pin.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Text="Delivery address" FontAttributes="Bold" FontSize="15" TextColor="#1F2A24" />
                    </HorizontalStackLayout>
                    <Border Stroke="#E2E8E4" StrokeThickness="1.5" BackgroundColor="White" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding AddressInvalid}" Value="True">
                                <Setter Property="Stroke" Value="#EF4444" />
                                <Setter Property="BackgroundColor" Value="#FEF2F2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_home_pin.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Street, house, block" Text="{Binding DeliveryAddress}" />
                        </Grid>
                    </Border>
                    <Border Stroke="#E2E8E4" StrokeThickness="1" BackgroundColor="White" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_pin.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Landmark (e.g. Near Main Mosque / Mall)" Text="{Binding DeliveryLandmark}" />
                        </Grid>
                    </Border>

                    <!-- Save this address for next time (when in New Address mode) -->
                    <Border Stroke="#E2E8E4"
                            StrokeThickness="1"
                            BackgroundColor="#FAFBFA"
                            Padding="12,10"
                            IsVisible="{Binding IsNewAddressMode}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Save this address for future orders"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#1F2A24" />
                                    <Label Text="Instant 1-click address pick on your next order"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsSaveAddressChecked}"
                                        OnColor="#0F6B4C"
                                        ThumbColor="White"
                                        VerticalOptions="Center" />
                            </Grid>

                            <!-- Label chips: [ 🏠 Home ], [ 🏢 Office ], [ 📍 Other ] -->
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSaveAddressChecked}">
                                <Label Text="Save As:" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                                <HorizontalStackLayout Spacing="8">
                                    <!-- Home Chip -->
                                    <Border StrokeThickness="1.5" Padding="12,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetAddressLabelCommand}" CommandParameter="Home" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsHomeLabelSelected}" Value="True">
                                                <Setter Property="Stroke" Value="#0F6B4C" />
                                                <Setter Property="BackgroundColor" Value="#E7F5EF" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsHomeLabelSelected}" Value="False">
                                                <Setter Property="Stroke" Value="#E2E8E4" />
                                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="🏠 Home" FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHomeLabelSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#0F6B4C" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHomeLabelSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#64748B" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <!-- Office Chip -->
                                    <Border StrokeThickness="1.5" Padding="12,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetAddressLabelCommand}" CommandParameter="Office" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOfficeLabelSelected}" Value="True">
                                                <Setter Property="Stroke" Value="#0F6B4C" />
                                                <Setter Property="BackgroundColor" Value="#E7F5EF" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOfficeLabelSelected}" Value="False">
                                                <Setter Property="Stroke" Value="#E2E8E4" />
                                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="🏢 Office" FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOfficeLabelSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#0F6B4C" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOfficeLabelSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#64748B" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <!-- Other Chip -->
                                    <Border StrokeThickness="1.5" Padding="12,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetAddressLabelCommand}" CommandParameter="Other" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOtherLabelSelected}" Value="True">
                                                <Setter Property="Stroke" Value="#0F6B4C" />
                                                <Setter Property="BackgroundColor" Value="#E7F5EF" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOtherLabelSelected}" Value="False">
                                                <Setter Property="Stroke" Value="#E2E8E4" />
                                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="📍 Other" FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOtherLabelSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#0F6B4C" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOtherLabelSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#64748B" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding LocationStatusText}"
                           FontSize="12"
                           TextColor="#475569"
                           LineBreakMode="WordWrap" />
                    <Button Text="Use my location"
                            Command="{Binding CaptureLocationCommand}"
                            ImageSource="icon_gps.png"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            HeightRequest="44"
                            CornerRadius="12"
                            Padding="12,0"
                            ContentLayout="Left,8" />

                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Image Source="icon_note.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Text="Notes" FontAttributes="Bold" FontSize="15" TextColor="#1F2A24" />
                    </HorizontalStackLayout>
                    <Border Stroke="#E2E8E4" StrokeThickness="1" BackgroundColor="White" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_note.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Anything we should know?" Text="{Binding Notes}" />
                        </Grid>
                    </Border>

                    <Border Stroke="#E2E8E4" StrokeThickness="1" BackgroundColor="#FAFBFA" Padding="14" IsVisible="{Binding HasItems}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Subtotal:" TextColor="#475569" FontSize="13" />
                                <Label Grid.Column="1" Text="{Binding SubtotalText, StringFormat='PKR {0}'}" TextColor="#1E293B" FontAttributes="Bold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Delivery Charges:" TextColor="#475569" FontSize="13" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding StandardDeliveryFeeText, StringFormat='PKR {0}'}"
                                           TextColor="#94A3B8"
                                           TextDecorations="Strikethrough"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsFreeDeliveryUnlocked}" />
                                    <Label Text="{Binding EffectiveDeliveryFeeText}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="True">
                                                <Setter Property="TextColor" Value="#059669" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="False">
                                                <Setter Property="TextColor" Value="#1E293B" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,2" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Total Payable:" FontAttributes="Bold" FontSize="16" TextColor="#1F2A24" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding GrandTotalText, StringFormat='PKR {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="#0F6B4C"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Minimum Order Warning Banner -->
                    <Border Stroke="#F59E0B"
                            StrokeThickness="1.5"
                            BackgroundColor="#FFFBEB"
                            Padding="12,10"
                            IsVisible="{Binding IsBelowMinimumOrder}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="⚠️" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding MinimumOrderAmountText, StringFormat='Minimum Order: PKR {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#92400E" />
                                <Label Text="{Binding MinimumOrderShortfallText, StringFormat='Please add PKR {0} more to qualify for delivery.'}"
                                       FontSize="12"
                                       TextColor="#B45309"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
            <Button Grid.Row="1"
                    Text="{Binding CheckoutButtonText}"
                    Margin="16,8,16,64"
                    Command="{Binding PlaceOrderCommand}"
                    IsVisible="{Binding HasItems}"
                    HeightRequest="50"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="16">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBelowMinimumOrder}" Value="True">
                        <Setter Property="BackgroundColor" Value="#CBD5E1" />
                        <Setter Property="TextColor" Value="#475569" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBelowMinimumOrder}" Value="False">
                        <Setter Property="BackgroundColor" Value="#0F6B4C" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <controls:BubbleTabBar Mode="Customer"
                               SelectedIndex="1"
                               VerticalOptions="End"
                               HorizontalOptions="Fill"
                               ZIndex="40" />
    </Grid>
</ContentPage>
