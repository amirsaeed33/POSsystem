<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Customer.CartPage"
             x:DataType="vm:CartCheckoutViewModel"
             Title="Cart"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceMuted}">
    <Grid BackgroundColor="{StaticResource SurfaceMuted}">
        <Grid RowDefinitions="*,Auto"
              BackgroundColor="{StaticResource SurfaceMuted}">
            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,20" Spacing="14">

                    <!-- Page title -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="{StaticResource CartAccentBackground}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Image Source="icon_cart_bag.png"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Your cart"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource CartText}" />
                            <Label Text="{Binding ItemCountLabel}"
                                   FontSize="13"
                                   TextColor="{StaticResource AuthMutedText}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Empty state -->
                    <Border IsVisible="{Binding IsEmpty}"
                            Stroke="{StaticResource CartBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource CartSurface}"
                            Padding="28,32">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Border WidthRequest="72"
                                    HeightRequest="72"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource CartAccentBackground}"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="36" />
                                </Border.StrokeShape>
                                <Image Source="icon_cart_bag.png"
                                       WidthRequest="34"
                                       HeightRequest="34"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Your cart is empty"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource CartText}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Add items from the menu, then come back to checkout."
                                   FontSize="13"
                                   TextColor="{StaticResource AuthMutedText}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Free Delivery Progress Card -->
                    <Border IsVisible="{Binding HasItems}"
                            StrokeThickness="1.5"
                            Padding="14,12"
                            Margin="0,0,0,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFreeDeliveryUnlocked}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource SuccessBackground}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFreeDeliveryUnlocked}" Value="False">
                                <Setter Property="Stroke" Value="{StaticResource AuthInputBorder}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="🎉" FontSize="22" VerticalOptions="Center" IsVisible="{Binding IsFreeDeliveryUnlocked}" />
                                <Label Text="🚚" FontSize="22" VerticalOptions="Center" IsVisible="{Binding IsFreeDeliveryLocked}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding FreeDeliveryMotivationText}"
                                           FontSize="13"
                                           FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource Slate800}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="Free delivery unlocked for your order!"
                                           FontSize="11"
                                           TextColor="{StaticResource PrimaryDark}"
                                           IsVisible="{Binding IsFreeDeliveryUnlocked}" />
                                    <Label Text="{Binding FreeDeliveryThreshold, StringFormat='Orders over PKR {0:N0} qualify'}"
                                           FontSize="11"
                                           TextColor="{StaticResource AuthMutedText}"
                                           IsVisible="{Binding IsFreeDeliveryLocked}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        Padding="8,4"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsFreeDeliveryUnlocked}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="FREE"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </Border>
                            </Grid>

                            <!-- Progress Bar (shown when not yet unlocked) -->
                            <ProgressBar Progress="{Binding FreeDeliveryProgress}"
                                         ProgressColor="{StaticResource StaffPrimary}"
                                         BackgroundColor="{StaticResource AuthInputBorder}"
                                         HeightRequest="6"
                                         IsVisible="{Binding IsFreeDeliveryLocked}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cart lines -->
                    <CollectionView ItemsSource="{Binding Lines}"
                                    IsVisible="{Binding HasItems}"
                                    HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartLine">
                                <Border Stroke="{StaticResource CartBorder}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource CartSurface}"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource CartText}" />
                                            <Label Text="{Binding SelectedModifiers}"
                                                   IsVisible="{Binding HasModifiers}"
                                                   TextColor="{StaticResource StaffPrimary}"
                                                   FontSize="11"
                                                   MaxLines="3"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding UnitPriceText, StringFormat='PKR {0}'}" TextColor="{StaticResource CartMuted}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <controls:AppButton Grid.Column="1"
                                                            Text="-"
                                                            Variant="QtyDecrease"
                                                            WidthRequest="40"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=DecreaseCommand}"
                                                            CommandParameter="{Binding .}" />
                                        <Label Grid.Column="2"
                                                Text="{Binding Quantity}"
                                                VerticalOptions="Center"
                                                FontAttributes="Bold"
                                                WidthRequest="24"
                                                HorizontalTextAlignment="Center" />
                                        <controls:AppButton Grid.Column="3"
                                                            Text="+"
                                                            Variant="QtyIncrease"
                                                            WidthRequest="40"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=IncreaseCommand}"
                                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Delivery section title -->
                    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                        <Image Source="icon_pin.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Text="Delivery area"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource CartText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Choose where this order should be delivered"
                           FontSize="12"
                           TextColor="{StaticResource AuthMutedText}"
                           Margin="28,0,0,0" />

                    <Border Stroke="{StaticResource CartBorder}" StrokeThickness="1" BackgroundColor="{StaticResource CardBackground}" Padding="4,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Picker Title="Select delivery area"
                                ItemsSource="{Binding Areas}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedArea}" />
                    </Border>

                    <!-- Contact -->
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Image Source="icon_person.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Text="Your details" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource CartText}" />
                    </HorizontalStackLayout>
                    <Border Stroke="{StaticResource CartBorder}" StrokeThickness="1.5" BackgroundColor="{StaticResource CardBackground}" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding NameInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource BadgeRed}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource DangerBackground}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_person.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Your name" Text="{Binding CustomerName}" />
                        </Grid>
                    </Border>
                    <Border Stroke="{StaticResource CartBorder}" StrokeThickness="1.5" BackgroundColor="{StaticResource CardBackground}" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding MobileInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource BadgeRed}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource DangerBackground}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_phone.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Mobile (e.g. 03001234567)" Text="{Binding CustomerMobile}" Keyboard="Telephone" />
                        </Grid>
                    </Border>

                    <!-- Saved Addresses Quick-Pick Section -->
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding HasSavedAddresses}">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="Saved Addresses"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource CartText}"
                                       VerticalOptions="Center" />
                                <Border BackgroundColor="{StaticResource CartAccentBackground}" StrokeThickness="0" Padding="8,2" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding SavedAddresses.Count, StringFormat='{0} saved'}"
                                           FontSize="11"
                                           TextColor="{StaticResource StaffPrimary}"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <controls:AppButton Grid.Column="1"
                                                Text="➕ New Address"
                                                Variant="Outline"
                                                ButtonHeight="32"
                                                Command="{Binding SwitchToNewAddressCommand}" />
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SavedAddresses}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerSavedAddressDto">
                                        <Border StrokeThickness="1.5"
                                                BackgroundColor="{StaticResource CardBackground}"
                                                Padding="12,10"
                                                WidthRequest="210">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=SelectSavedAddressCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessBackground}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="Stroke" Value="{StaticResource CartBorder}" />
                                                    <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="4" ColumnSpacing="6">
                                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding DisplayIcon}" FontSize="16" VerticalOptions="Center" />
                                                <Label Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding DisplayLabel}"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource CartText}"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                                <Button Grid.Row="0" Grid.Column="2"
                                                        Text="🗑"
                                                        FontSize="12"
                                                        TextColor="{StaticResource BadgeRed}"
                                                        BackgroundColor="Transparent"
                                                        Padding="0"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        CornerRadius="14"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartCheckoutViewModel}}, Path=DeleteSavedAddressCommand}"
                                                        CommandParameter="{Binding .}" />

                                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding AddressPreview}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource AuthMutedText}"
                                                       LineBreakMode="TailTruncation" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Active Saved Address Notification / Switch Pill -->
                    <Border Stroke="{StaticResource StaffPrimary}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource CartAccentBackground}"
                            Padding="12,10"
                            IsVisible="{Binding HasSelectedSavedAddress}"
                            Margin="0,2,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="{Binding SelectedSavedAddress.DisplayIcon}" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding SelectedSavedAddress.DisplayLabel, StringFormat='Using saved address: {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="{StaticResource StaffPrimary}" />
                                <Label Text="{Binding SelectedSavedAddress.FullAddressDisplay}"
                                       FontSize="11"
                                       TextColor="{StaticResource Slate700}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <controls:AppButton Grid.Column="2"
                                                Text="Change"
                                                Variant="Outline"
                                                ButtonHeight="28"
                                                CornerRadius="10"
                                                Command="{Binding SwitchToNewAddressCommand}" />
                        </Grid>
                    </Border>

                    <!-- Address -->
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Image Source="icon_home_pin.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Text="Delivery address" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource CartText}" />
                    </HorizontalStackLayout>
                    <Border Stroke="{StaticResource CartBorder}" StrokeThickness="1.5" BackgroundColor="{StaticResource CardBackground}" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding AddressInvalid}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource BadgeRed}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource DangerBackground}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_home_pin.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Street, house, block" Text="{Binding DeliveryAddress}" />
                        </Grid>
                    </Border>
                    <Border Stroke="{StaticResource CartBorder}" StrokeThickness="1" BackgroundColor="{StaticResource CardBackground}" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_pin.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Landmark (e.g. Near Main Mosque / Mall)" Text="{Binding DeliveryLandmark}" />
                        </Grid>
                    </Border>

                    <!-- Save this address for next time (when in New Address mode) -->
                    <Border Stroke="{StaticResource CartBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource CartSurface}"
                            Padding="12,10"
                            IsVisible="{Binding IsNewAddressMode}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Save this address for future orders"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource CartText}" />
                                    <Label Text="Instant 1-click address pick on your next order"
                                           FontSize="11"
                                           TextColor="{StaticResource AuthMutedText}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsSaveAddressChecked}"
                                        OnColor="{StaticResource StaffPrimary}"
                                        ThumbColor="{StaticResource White}"
                                        VerticalOptions="Center" />
                            </Grid>

                            <!-- Label chips: [ 🏠 Home ], [ 🏢 Office ], [ 📍 Other ] -->
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSaveAddressChecked}">
                                <Label Text="Save As:" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AuthMutedText}" />
                                <HorizontalStackLayout Spacing="8">
                                    <!-- Home Chip -->
                                    <Border StrokeThickness="1.5" Padding="12,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetAddressLabelCommand}" CommandParameter="Home" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsHomeLabelSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource CartAccentBackground}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsHomeLabelSelected}" Value="False">
                                                <Setter Property="Stroke" Value="{StaticResource CartBorder}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="🏠 Home" FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHomeLabelSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StaffPrimary}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHomeLabelSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource AuthMutedText}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <!-- Office Chip -->
                                    <Border StrokeThickness="1.5" Padding="12,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetAddressLabelCommand}" CommandParameter="Office" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOfficeLabelSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource CartAccentBackground}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOfficeLabelSelected}" Value="False">
                                                <Setter Property="Stroke" Value="{StaticResource CartBorder}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="🏢 Office" FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOfficeLabelSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StaffPrimary}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOfficeLabelSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource AuthMutedText}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <!-- Other Chip -->
                                    <Border StrokeThickness="1.5" Padding="12,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetAddressLabelCommand}" CommandParameter="Other" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOtherLabelSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource CartAccentBackground}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOtherLabelSelected}" Value="False">
                                                <Setter Property="Stroke" Value="{StaticResource CartBorder}" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="📍 Other" FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOtherLabelSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StaffPrimary}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOtherLabelSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource AuthMutedText}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding LocationStatusText}"
                           FontSize="12"
                           TextColor="{StaticResource Slate600}"
                           LineBreakMode="WordWrap" />
                    <controls:AppButton Text="Use my location"
                                        Command="{Binding CaptureLocationCommand}"
                                        ImageSource="icon_gps.png"
                                        Variant="Secondary"
                                        ButtonHeight="44"
                                        CornerRadius="12" />

                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Image Source="icon_note.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Text="Notes" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource CartText}" />
                    </HorizontalStackLayout>
                    <Border Stroke="{StaticResource CartBorder}" StrokeThickness="1" BackgroundColor="{StaticResource CardBackground}" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Image Source="icon_note.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Anything we should know?" Text="{Binding Notes}" />
                        </Grid>
                    </Border>

                    <!-- Payment Method Section -->
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Label Text="💳" FontSize="18" VerticalOptions="Center" />
                        <Label Text="Payment method" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource CartText}" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <!-- Card 1: Cash on Delivery -->
                        <Border StrokeThickness="1.5"
                                Padding="14,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="CashOnDelivery" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCodSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessBackground}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCodSelected}" Value="False">
                                    <Setter Property="Stroke" Value="{StaticResource CartBorder}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="{StaticResource CartAccentBackground}" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label Text="💵" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Cash on Delivery (COD)"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="{StaticResource CartText}" />
                                    <Label Text="Pay the rider with cash when your food arrives."
                                           FontSize="12"
                                           TextColor="{StaticResource AuthMutedText}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        StrokeThickness="2"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCodSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource StaffPrimary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCodSelected}" Value="False">
                                            <Setter Property="Stroke" Value="{StaticResource DisabledSurface}" />
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="✓"
                                           TextColor="{StaticResource White}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsCodSelected}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 2: Online / Digital Payment -->
                        <Border StrokeThickness="1.5"
                                Padding="14,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="OnlinePayment" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsOnlinePaymentSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessBackground}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsOnlinePaymentSelected}" Value="False">
                                    <Setter Property="Stroke" Value="{StaticResource CartBorder}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="{StaticResource IndigoSoft}" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Label Text="💳" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="Online / Digital Payment"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{StaticResource CartText}"
                                               VerticalOptions="Center" />
                                        <Border BackgroundColor="{StaticResource IndigoSoft}" StrokeThickness="0" Padding="6,2" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="Card / Wallet" FontSize="10" TextColor="{StaticResource InfoDeep}" FontAttributes="Bold" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Credit/Debit Card, JazzCash, EasyPaisa, or Transfer."
                                           FontSize="12"
                                           TextColor="{StaticResource AuthMutedText}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <Border Grid.Column="2"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        StrokeThickness="2"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOnlinePaymentSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource StaffPrimary}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource StaffPrimary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsOnlinePaymentSelected}" Value="False">
                                            <Setter Property="Stroke" Value="{StaticResource DisabledSurface}" />
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="✓"
                                           TextColor="{StaticResource White}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsOnlinePaymentSelected}" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Border Stroke="{StaticResource CartBorder}" StrokeThickness="1" BackgroundColor="{StaticResource CartSurface}" Padding="14" IsVisible="{Binding HasItems}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Subtotal:" TextColor="{StaticResource Slate600}" FontSize="13" />
                                <Label Grid.Column="1" Text="{Binding SubtotalText, StringFormat='PKR {0}'}" TextColor="{StaticResource Slate800}" FontAttributes="Bold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Delivery Charges:" TextColor="{StaticResource Slate600}" FontSize="13" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding StandardDeliveryFeeText, StringFormat='PKR {0}'}"
                                           TextColor="{StaticResource AuthPlaceholder}"
                                           TextDecorations="Strikethrough"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsFreeDeliveryUnlocked}" />
                                    <Label Text="{Binding EffectiveDeliveryFeeText}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreeDeliveryUnlocked}" Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource Slate800}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource AuthInputBorder}" Margin="0,2" />

                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="Total Payable" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource CartText}" VerticalOptions="Center" />
                                    <Label Text="{Binding PaymentMethodBadgeText, StringFormat='({0}):'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AuthMutedText}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding GrandTotalText, StringFormat='PKR {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="{StaticResource StaffPrimary}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Minimum Order Warning Banner -->
                    <Border Stroke="{StaticResource StarGold}"
                            StrokeThickness="1.5"
                            BackgroundColor="{StaticResource WarningBackground}"
                            Padding="12,10"
                            IsVisible="{Binding IsBelowMinimumOrder}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="⚠️" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding MinimumOrderAmountText, StringFormat='Minimum Order: PKR {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="{StaticResource WarningText}" />
                                <Label Text="{Binding MinimumOrderShortfallText, StringFormat='Please add PKR {0} more to qualify for delivery.'}"
                                       FontSize="12"
                                       TextColor="{StaticResource WarningMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
            <Button Grid.Row="1"
                    Text="{Binding CheckoutButtonText}"
                    Style="{StaticResource StaffPrimaryButton}"
                    Margin="16,8,16,64"
                    Command="{Binding PlaceOrderCommand}"
                    IsVisible="{Binding HasItems}"
                    HeightRequest="50"
                    CornerRadius="14"
                    FontSize="16">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBelowMinimumOrder}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Gray300}" />
                        <Setter Property="TextColor" Value="{StaticResource Gray600}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBelowMinimumOrder}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource StaffPrimary}" />
                        <Setter Property="TextColor" Value="{StaticResource White}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <controls:BubbleTabBar Mode="Customer"
                               SelectedIndex="1"
                               VerticalOptions="End"
                               HorizontalOptions="Fill"
                               ZIndex="40" />
    </Grid>
</ContentPage>
