<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Customer.TrackOrderPage"
             x:DataType="vm:TrackOrderViewModel"
             Title="Track Order"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <AbsoluteLayout BackgroundColor="#F5F5F5">
        <VerticalStackLayout AbsoluteLayout.LayoutBounds="0,0,1,1"
                             AbsoluteLayout.LayoutFlags="All"
                             Padding="16"
                             Spacing="12"
                             BackgroundColor="#F5F5F5">
            <Entry Placeholder="Order number" Text="{Binding OrderNo}" />
            <Button Text="Track" Command="{Binding TrackCommand}" BackgroundColor="#0F6B4C" TextColor="White" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <VerticalStackLayout Spacing="6" IsVisible="{Binding Order.OrderNo, TargetNullValue=False}">
                <Label Text="{Binding Order.OrderNo}" FontAttributes="Bold" FontSize="20" />
                <Label Text="{Binding Order.StatusName, StringFormat='Status: {0}'}" />
                <Label Text="{Binding Order.TotalAmount, StringFormat='Total: {0:0.00}'}" />
                <Label Text="{Binding Order.DeliveryAreaName}" />
                <Label Text="{Binding Order.RiderName, StringFormat='Rider: {0}'}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <controls:BubbleTabBar AbsoluteLayout.LayoutBounds="0,1,1,52"
                               AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"
                               TranslationY="-56"
                               Mode="Customer"
                               SelectedIndex="2"
                               ZIndex="40"
                               InputTransparent="False" />
    </AbsoluteLayout>
</ContentPage>