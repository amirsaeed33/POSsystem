<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartPos.Mobile.ViewModels"
             xmlns:models="clr-namespace:SmartPos.Mobile.Models"
             xmlns:controls="clr-namespace:SmartPos.Mobile.Controls"
             x:Class="SmartPos.Mobile.Views.Customer.TrackOrderPage"
             x:DataType="vm:TrackOrderViewModel"
             Title="Track Order"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <Grid BackgroundColor="#F5F5F5">
        <ScrollView
                    BackgroundColor="#F5F5F5">
            <VerticalStackLayout Padding="16,16,16,72" Spacing="14" BackgroundColor="#F5F5F5">
                <Label Text="Track order"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#1F2A24" />
                <Label Text="Enter your order number (e.g. ORD-00012) or mobile number used at checkout."
                       FontSize="13"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap" />

                <Border Stroke="#E2E8E4" StrokeThickness="1" BackgroundColor="White" Padding="12,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Placeholder="Order number"
                           Text="{Binding OrderNo}"
                           FontSize="16"
                           ReturnType="Search"
                           ReturnCommand="{Binding TrackCommand}" />
                </Border>

                <Button Text="Track order"
                        Command="{Binding TrackCommand}"
                        BackgroundColor="#0F6B4C"
                        TextColor="White"
                        HeightRequest="48"
                        CornerRadius="14"
                        FontAttributes="Bold" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#0F6B4C" />

                <Border IsVisible="{Binding HasOrder}"
                        Stroke="#E2E8E4"
                        StrokeThickness="1"
                        BackgroundColor="#FAFBFA"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding OrderTitle}"
                               FontAttributes="Bold"
                               FontSize="22"
                               TextColor="#1F2A24" />
                        <Border StrokeThickness="0" BackgroundColor="#E7F5EF" Padding="10,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="{Binding StatusText}"
                                   FontAttributes="Bold"
                                   TextColor="#0F6B4C" />
                        </Border>
                        <Label Text="{Binding StatusBanner}"
                               FontSize="13"
                               TextColor="#475569"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding TotalText}"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="#0F6B4C" />
                        <Label Text="{Binding AreaText}" TextColor="#5C6B63" />
                        <Label Text="{Binding RiderText}" TextColor="#5C6B63" />
                        <Grid IsVisible="{Binding HasRiderPhone}"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8"
                              Margin="0,2,0,0">
                            <Label Text="{Binding RiderPhoneText}"
                                   TextColor="#1F2A24"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="0"
                                    BackgroundColor="#E7F5EF"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CallRiderCommand}" />
                                </Border.GestureRecognizers>
                                <Image Source="icon_phone.png"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="2"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="0"
                                    BackgroundColor="#25D366"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding WhatsAppRiderCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="WA"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding CustomerText}" TextColor="#5C6B63" />

                        <Label Text="Items"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="#1F2A24"
                               Margin="0,6,0,0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerOrderLineDto">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ProductName}" TextColor="#1F2A24" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Quantity, StringFormat='x{0:0.##}'}"
                                               TextColor="#64748B" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Customer Rating & Verified Feedback Card (Delivered Orders Only) -->
                <Border IsVisible="{Binding IsDelivered}"
                        Stroke="#D1FAE5"
                        StrokeThickness="1.5"
                        BackgroundColor="White"
                        Padding="16"
                        Margin="0,4,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#18000000" Offset="0,4" Radius="8" Opacity="0.5" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <!-- Panel Header -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="⭐" FontSize="18" VerticalOptions="Center" />
                                <Label Text="{Binding RatingSectionTitle}"
                                       FontAttributes="Bold"
                                       FontSize="17"
                                       TextColor="#1A2B4A"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Score Badge if already rated (e.g. 5/5) -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasExistingRating}"
                                    BackgroundColor="#E8F5EF"
                                    StrokeThickness="0"
                                    Padding="10,4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding RatingBadgeText}"
                                       TextColor="#0F6B4C"
                                       FontAttributes="Bold"
                                       FontSize="13" />
                            </Border>
                        </Grid>

                        <!-- Hint Text -->
                        <Label Text="{Binding RatingHintText}"
                               FontSize="13"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />

                        <!-- 5 Interactive Stars Row -->
                        <Border BackgroundColor="#F8FAFC"
                                StrokeThickness="1"
                                Stroke="#E2E8F0"
                                Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <!-- Star 1 -->
                                    <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectStarCommand}" CommandParameter="1" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Star1Glyph}"
                                               TextColor="{Binding Star1Color}"
                                               FontSize="32"
                                               HorizontalOptions="Center" />
                                    </Border>
                                    <!-- Star 2 -->
                                    <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectStarCommand}" CommandParameter="2" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Star2Glyph}"
                                               TextColor="{Binding Star2Color}"
                                               FontSize="32"
                                               HorizontalOptions="Center" />
                                    </Border>
                                    <!-- Star 3 -->
                                    <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectStarCommand}" CommandParameter="3" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Star3Glyph}"
                                               TextColor="{Binding Star3Color}"
                                               FontSize="32"
                                               HorizontalOptions="Center" />
                                    </Border>
                                    <!-- Star 4 -->
                                    <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectStarCommand}" CommandParameter="4" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Star4Glyph}"
                                               TextColor="{Binding Star4Color}"
                                               FontSize="32"
                                               HorizontalOptions="Center" />
                                    </Border>
                                    <!-- Star 5 -->
                                    <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectStarCommand}" CommandParameter="5" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Star5Glyph}"
                                               TextColor="{Binding Star5Color}"
                                               FontSize="32"
                                               HorizontalOptions="Center" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Rating Description -->
                                <Label Text="{Binding RatingDescriptionText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#0F6B4C"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Feedback Comment Editor -->
                        <Border Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Editor Text="{Binding CustomerCommentDraft}"
                                    Placeholder="Tell others about your experience (optional)"
                                    PlaceholderColor="#94A3B8"
                                    TextColor="#1E293B"
                                    FontSize="13"
                                    HeightRequest="80"
                                    MaxLength="500"
                                    AutoSize="Disabled" />
                        </Border>

                        <!-- Submit Button -->
                        <Button Text="{Binding SubmitButtonLabel}"
                                Command="{Binding SubmitRatingCommand}"
                                IsEnabled="{Binding CanSubmitRating}"
                                BackgroundColor="#0F6B4C"
                                TextColor="White"
                                HeightRequest="46"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="15" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BubbleTabBar Mode="Customer"
                               SelectedIndex="2"
                               VerticalOptions="End"
                               HorizontalOptions="Fill"
                               ZIndex="40" />
    </Grid>
</ContentPage>
